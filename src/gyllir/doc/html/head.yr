in head;

use gyllir::doc::html::body;

use std::stream;

/**
 * Html header of a page
 */
@final
pub class HtmlHeader over HtmlNode {

    // The name of the project
    let _project: [c8];

    // The git repo
    let _git: [c8];

    // The git current branch version
    let _version: [c8];

    // The name of the page
    let _name: [c8];

    // The toc of the page
    let _table: [c8];

    // The body of the page
    let _body: &HtmlBody;

    // The url of the coverage pages of the project, relative to the page ("" if there are none)
    let _coverage: [c8];

    /**
     * Create a header for a page
     * @params:
     *   - name: the name of the page
     *   - coverageUrl: the url of the index of the coverage pages, relative to the page ("" for no
     *     link to them)
     */
    pub self (project: [c8], git: [c8], version: [c8], name: [c8], table: [c8], body: &HtmlBody, coverageUrl: [c8] = "")
        with _project = project
        , _git = git
        , _version = version
        , _name = name
        , _table = table
        , _body = body
        , _coverage = coverageUrl
    {}

    /**
     * Dump the html content into the stream
     * @params:
     *   - stream: the stream to populate
     */
    pub over dumpHtml(self, dmut stream: &StringStream) {
        let dmut streamBody = copy StringStream();
        self._body.dumpHtml(alias streamBody);

        let mp = copy ["Title" => (self._project ~ " " ~ self._name),
                       "GitURL" => formatter::formatGitUrl(self._git, version-> self._version),
                       "Modules" => self._table,
                       "Links" => coverageLink(self._coverage),
                       "Body" => streamBody[]];

        formatter::format(alias stream, ressources::HEADER, mp);
    }
}

/**
 * The class of the link to the coverage pages, which tells a page that has one from a page that
 * does not
 * */
pub def __COVERAGE_LINK_CLASS__ = "topbar-link coverage-link";

/**
 * @returns: the link of the top bar of a documentation page to the coverage pages, "" if there is
 *    no coverage page to link to
 * @params:
 *    - url: the url of the index of the coverage pages, relative to the page
 * */
pub fn coverageLink(url: [c8])-> [c8] {
    if (url.len == 0us) { return ""; }
    "<a class=\"" ~ __COVERAGE_LINK_CLASS__ ~ "\" href=\"" ~ formatter::htmlEscape(url) ~ "\">Coverage</a>"
}
