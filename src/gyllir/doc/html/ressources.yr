in ressources;

use std::fs::_;

/**
 * The directory the html/css/js/ico resources are read from: the installed location a packaged
 * gyllir copies 'res/' into (see the Dockerfile's `package` stage). The unittest executable is
 * compiled with '-funittest' (see 'createCompileOptions' in 'repo::builder'), which makes
 * '__version!unittest' true for every module it links, including this one - so only that binary
 * reads the repo's own 'res/' instead, exercising the templates actually committed on the branch
 * under test rather than whatever happens to be installed system-wide. A regular 'gyllir build'
 * never takes this branch, so a project directory that happens to contain a 'res/' of its own is
 * never mistaken for it.
 */
pub lazy RES_ROOT = {
    cte if __version!unittest { Path("res") }
    else { Path("/etc/gyllir/res") }
};

pub enum GyllirHtmlFiles
| LEAF_NODE    = "html/leaf_node.html"
| DECLARATION  = "html/declaration.html"
| INLINE_CODE  = "html/inline_code.html"
| MEMBERS      = "html/members.html"
| MEMBER_HEAD  = "html/member_head.html"
| MODULE_HEAD  = "html/module_head.html"
| HEADER       = "html/header.html"
| FOOTER       = "html/footer.html"
| SUBMODULE    = "html/submodule.html"
| MODULE_TABLE = "html/module_table.html";

pub lazy LEAF_NODE = {
    {
        let dmut f = File::open(RES_ROOT.push(GyllirHtmlFiles::LEAF_NODE));
        f:.readAll()
    } catch {
        _ => ""
    }
};

pub lazy DECLARATION = {
    {
        let dmut f = File::open(RES_ROOT.push(GyllirHtmlFiles::DECLARATION));
        f:.readAll()
    } catch {
        _ => ""
    }
};

