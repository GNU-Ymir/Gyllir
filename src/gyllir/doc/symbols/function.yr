in function;

use std::stream;
use gyllir::doc::{symbols::variable, types, types::any};

@final
pub class Function over Symbol {

    pub let mut parameters: [&Variable] = [];
    pub let mut retType: &Type = EMPTY_ANY;
    pub let mut throwers: [&Type] = [];

    pub let mut isInline: bool = false;
    pub let mut isUnsafe: bool = false;

    /**
     * @params:
     *    - name: the name of the module
     *    - loc: the location of the module declaration
     *    - childs: the symbols found in the module
     * */
    pub self (name: [c8], doc: [c8], loc: Location, protection: Protection)
        with super (name, doc, loc, protection)
    {}

    impl Streamable {
        pub over toStream(self, dmut stream: &StringStream) {
            stream:.write("Function ", self.name, " => ", self.loc, "\n");
            stream:.entabing();
            if (self.isUnsafe && self.isInline) { stream:.write("@{unsafe, inline}\n"); }
            else if self.isUnsafe { stream:.write("@unsafe\n"); }
            else if self.isInline { stream:.write("@inline\n"); }

            stream:.write("fn (");
            for i, j in self.parameters {
                if i != 0 stream:.write(", ");
                stream:.write(j);
            }
            stream:.write(")-> ", self.retType, "\n");
            if (self.throwers.len != 0) {
                stream:.entabing();
                stream:.write("throws ");
                for i, j in self.throwers {
                    if (i != 0) stream:.write(", ");
                    stream:.write(j);
                }
                stream:.detabing();
                stream:.write("\n");
            }
            stream:.detabing();
        }
    }
}
