in html;

pub mod ::ressources;
pub mod ::formatter;
pub mod ::body;
pub mod ::head;
pub mod ::foot;
pub mod ::coverage;

use std::stream;

@abstract
pub class HtmlNode {

    pub self () {}

    /**
     * Dump the html content into the stream
     * @params:
     *   - stream: the stream to populate
     */
    pub fn dumpHtml(self, dmut stream: &StringStream);
}
