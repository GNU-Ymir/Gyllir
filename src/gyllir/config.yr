in config;

use std::{config::_, stream};

pub mod ::command;
pub mod ::url;
pub mod ::version;
pub mod ::dependency;
pub mod ::target;
pub mod ::type;
pub mod ::errors;

use gyllir::config::_;
use gyllir::config::version::filter;

/**
 * The registry of the std lib(midgard) a package resolves against when it declares a '[std]'
 * table without an 'url' entry
 * */
pub def __DEFAULT_STD_URL__ = "git:git@github.com:GNU-Ymir/yruntime.git";

/**
 * Record defining a gyllir configuration
 * */
pub record GyllirPackageConfiguration {

    // The name of the package
    let mut _name: [c8] = "";

    // The license of the package
    let mut _license: [c8] = "";

    // The short descripion
    let mut _description: [c8] = "";

    // The compiler
    let mut _compiler: [c8] = "gyc";

    // The package root file
    let mut _packageRoot: [c8] = "";

    // The test root file
    let mut _testRoot: [c8] = "";

    // False iif the package opted out of unittesting, in which case it declares no test root
    let mut _tests: bool = true;

    // The type of the target
    let mut _type: BuildType = BuildType();

    // The registry in which the publishing has to be made
    let mut _registry: Url = Url();

    // The version of the package
    let mut _version: Version = Version(0, 0, 0);

    // The list of authors
    let mut _authors: [[c8]] = [];

    // The list of libraries to link(from C language)
    let mut _libraries: [[c8]] = [];

    // The raw options passed to the compiler when building any target of the package
    let mut _flags: [[c8]] = [];

    // The list of dependencies of the package
    let mut _dependencies: &DependencyList = copy DependencyList();

    // The list of targets declared by the package
    // @info: empty for a package declaring no '[targets.<name>]' table, 'targets' then
    //   synthesizes a single target from the top level fields
    let mut _targets: &TargetList = copy TargetList();

    // The list of custom commands to run when building the project
    let mut _commands: &CustomCommandList = copy CustomCommandList();

    // The version filter of the std lib(midgard) the package requires, declared by an optional
    // '[std]' table; '[]' when the package declares none, in which case std lib resolution is
    // left entirely to the compiler, exactly as it always has been
    let mut _stdVersionRaw: [[c8]] = [];

    // The remote location of the std lib(midgard) repository, only meaningful when '_hasStd' is
    // true; defaults to the official one when a '[std]' table declares no 'url'
    let mut _stdUrl: Url = Url();

    // True iif the package declares a '[std]' table
    let mut _hasStd: bool = false;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CTORS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Empty gyllir configuration
     * */
    pub self empty() {}

    pub self (name: [c8], license: [c8], description: [c8], type: BuildType, registry: Url, version: Version, authors: [[c8]])
        with _name = name
        , _license = license
        , _description = description
        , _type = type
        , _registry = registry
        , _version = version
        , _authors = authors
    {}

    /**
     * Construct a package configuration from a config
     * */
    pub self (cfg: &Config)
        throws AssertError
    {
        if let d: &Dict = cfg {
            self:.parsePackage(d);
            self.checkTargetExclusivity(d);
        }

        else throw copy AssertError("expecting a table of entries describing the package");
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */


    @field
    pub fn name(self)-> [c8] {
        self._name
    }

    @field
    pub fn license(self)-> [c8] {
        self._license
    }

    @field
    pub fn descripion(self)-> [c8] {
        self._description
    }

    @field
    pub fn type(self)-> BuildType {
        self._type
    }

    @field
    pub fn compiler(self)-> [c8] {
        self._compiler
    }

    @field
    pub fn packageRoot(self)-> [c8] {
        self._packageRoot
    }

    @field
    pub fn testRoot(self)-> [c8] {
        self._testRoot
    }

    @field
    pub fn tests(self)-> bool {
        self._tests
    }

    @field
    pub fn registry(self)-> Url {
        self._registry
    }

    @field
    pub fn version(self)-> Version {
        self._version
    }

    @field
    pub fn authors(self)-> [[c8]] {
        self._authors
    }

    @field
    pub fn libraries(self)-> [[c8]] {
        self._libraries
    }

    @field
    pub fn flags(self)-> [[c8]] {
        self._flags
    }

    @field
    pub fn dependencies(self)-> &DependencyList {
        self._dependencies
    }

    /**
     * The targets built for this package.
     *
     * A package declaring '[targets.<name>]' tables has exactly those, and each of them is
     * self contained: 'checkTargetExclusivity' rejects the package level fields describing an
     * artifact, so there is nothing for a target to inherit. A package declaring no target has a
     * single one synthesized from those very fields, named after the package itself.
     *
     * @info: the synthesized target is deliberately not stored in '_targets', so that it is not
     *   written back as a '[targets.<name>]' table by 'serialize' when 'gyllir publish' rewrites
     *   the configuration file of a package that never declared one
     * @returns: the targets of the package, by name
     * */
    pub fn targets(self)-> [[c8] => Target] {
        let dmut res: [[c8] => Target] = copy [];
        if (self._targets.len() != 0us) {
            for k, t in self._targets[] {
                res[k] = t;
            }

            return res;
        }

        res[self._name] = Target(self._name, self._type,
                                 packageRoot-> self._packageRoot,
                                 testRoot-> self._testRoot,
                                 tests-> self._tests,
                                 flags-> self._flags,
                                 libraries-> self._libraries,
                                 synthesized-> true);

        res
    }

    @field
    pub fn commands(self)-> &CustomCommandList {
        self._commands
    }

    /**
     * @returns: true iif the package declares a '[std]' table, requiring a specific version of
     *    the std lib(midgard)
     * */
    @field
    pub fn hasStd(self)-> bool {
        self._hasStd
    }

    /**
     * @returns: the remote location of the std lib(midgard) repository, only meaningful when
     *    'hasStd' is true
     * */
    @field
    pub fn stdUrl(self)-> Url {
        self._stdUrl
    }

    /**
     * @returns: the version filter of the std lib(midgard) the package requires, only meaningful
     *    when 'hasStd' is true
     * */
    pub fn stdVersion(self)-> VersionFilter
        throws AssertError
    {
        VersionFilter(self._stdVersionRaw, entry-> "'std.version'")
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Set the version of the configuration
     * */
    pub fn setVersion(mut self, v: Version) {
        self._version = v;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          MISC          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Streamable;
    impl Serializable {
        pub over serialize(self)-> &Config {
            let dmut d = copy Dict();
            d["name"] = copy Str(self._name);
            d["license"] = copy Str(self._license);
            d["description"] = copy Str(self._description);
            d["registry"] = self._registry.serialize();
            d["version"] = self._version.serialize();
            d["dependencies"] = self._dependencies.serialize();
            d["commands"] = self._commands.serialize();
            d["compiler"] = copy Str(self._compiler);

            d["authors"] = copy Array(copy [copy Str(i) for i in self._authors]);

            if (self._targets.len() != 0us) {
                d["targets"] = self._targets.serialize();
            }

            // the fields describing a single artifact are exclusive with the target tables: writing
            // any of them next to a '[targets.*]' would produce a configuration that the next
            // 'gyllir build' rejects. 'package-root' and 'test-root' are only written when set, so
            // that a package that never had one does not gain it on the first publish
            else {
                d["type"] = self._type.serialize();
                d["libraries"] = copy Array(copy [copy Str(i) for i in self._libraries]);

                if (self._flags.len != 0us) {
                    d["flags"] = copy Array(copy [copy Str(i) for i in self._flags]);
                }

                if (self._packageRoot != "") {
                    d["package-root"] = copy Str(self._packageRoot);
                }

                if (self._testRoot != "") {
                    d["test-root"] = copy Str(self._testRoot);
                }

                if (!self._tests) {
                    d["tests"] = copy Bool(false);
                }
            }

            if (self._hasStd) {
                let dmut s = copy Dict();
                // 'parseStd' already validated '_stdVersionRaw' when the configuration was loaded,
                // this can only fail for a package built through the programmatic ctor, never one
                // read back from its own 'gyllir.toml'
                s["version"] = {
                    VersionFilter(self._stdVersionRaw, entry-> "'std.version'").serialize()
                } catch { _ => copy Str("*") };
                s["url"] = self._stdUrl.serialize();
                d["std"] = s;
            }

            d
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * A package configures a single artifact from its top level fields, or several from
     * '[targets.<name>]' tables, but never both at once: a top level 'type'/'package-root'/'test-root'
     * next to a target table would simply go unread, so it is rejected rather than ignored.
     *
     * Only the fields describing an artifact are exclusive. The identity of the package(name,
     * version, license, description, registry, authors, compiler) and what it needs to be
     * built(dependencies, commands) stay global, they say nothing about what is produced.
     *
     * @params:
     *    - d: the raw configuration, needed to tell a field that was written from one that defaulted
     * @throws:
     *    - AssertError: on the first target level field found at the top level of a multi target package
     * */
    prv fn checkTargetExclusivity(self, d: &Dict)
        throws AssertError
    {
        if (self._targets.len() == 0us) { return; }

        for k in ["type", "package-root", "test-root", "tests", "flags", "libraries"] {
            if let Ok(_) = d[k]? {
                throw copy AssertError("'" ~ k ~ "' describes a single artifact, it cannot be declared "
                                       ~ "at the top level of a package that declares '[targets.*]' tables: "
                                       ~ "move it into every target that needs it");
            }
        }
    }

    /**
     * Parse a configuration defining a package
     * @throws:
     *    - AssertError: on the first entry that is missing, or that does not have the expected
     *      shape. Its message is the one printed to the user, so the sub parsers are called
     *      directly rather than through 'std::config::conv::to', whose CastFailure would bury it
     * */
    prv fn parsePackage(mut self, d: &Dict)
        throws AssertError
    {
        self._name = self.readRequired(d, "name", example-> "name = \"my-package\"");
        self._license = self.readRequired(d, "license", example-> "license = \"GPL-v3\"");
        self._description = self.readRequired(d, "description", example-> "description = \"what the package does\"");

        if let Ok(v) = d["version"]? {
            self._version = Version(v, entry-> "'version'");
        } else {
            throw copy AssertError("missing required entry 'version', for example: version = \"0.1.0\"");
        }

        if let Ok(r) = d["registry"]? {
            self._registry = Url(r, entry-> "'registry'");
        } else {
            throw copy AssertError("missing required entry 'registry', for example: registry = { git = \"git@github.com:me/my-package.git\" }");
        }

        // optional: a package declaring '[targets.*]' tables must not have one at all, and a package
        // declaring none defaults to an executable
        if let Ok(t) = d["type"]? {
            self._type = BuildType(t, entry-> "'type'");
        }

        self._compiler = self.readString(d, "compiler", default-> self._compiler, example-> "compiler = \"gyc\"");
        self._packageRoot = self.readString(d, "package-root", default-> "", example-> "package-root = \"main\"");
        self._testRoot = self.readString(d, "test-root", default-> "", example-> "test-root = \"__test__\"");
        self._tests = self.readBool(d, "tests", default-> true);

        if (!self._tests && self._testRoot != "") {
            throw copy AssertError("'tests' is set to false, the package declares no unittest, it cannot declare 'test-root'");
        }

        self._authors = self.readStringArray(d, "authors", example-> "authors = [\"me <me@example.com>\"]");
        self._libraries = self.readStringArray(d, "libraries", example-> "libraries = [\"pthread\"]");
        self._flags = self.readStringArray(d, "flags", example-> "flags = [\"-Wall\"]");

        if let Ok(x) = d["dependencies"]? {
            self._dependencies = copy DependencyList(x);
        }

        if let Ok(x) = d["targets"]? {
            self._targets = copy TargetList(x);
        }

        if let Ok(x) = d["commands"]? {
            self._commands = copy CustomCommandList(x);
        }

        if let Ok(x) = d["std"]? {
            self:.parseStd(x);
        }

        gyllir::config::errors::rejectUnknown(d, "", "name", "license", "description", "compiler",
            "package-root", "test-root", "tests", "type", "registry", "version", "authors",
            "libraries", "flags", "dependencies", "targets", "commands", "std");
    }

    /**
     * Parse the optional '[std]' table, declaring the version filter(and optionally the remote)
     * of the std lib(midgard) the package requires
     * @params:
     *    - cfg: the content of the '[std]' table
     * @throws:
     *    - AssertError: on the first entry that is missing, or that does not have the expected
     *      shape
     * */
    prv fn parseStd(mut self, cfg: &Config)
        throws AssertError
    {
        let ctx = "'[std]', ";
        if let d: &Dict = cfg {
            self._hasStd = true;

            self._stdVersionRaw = if let Ok(Str(value-> v)) = d["version"]? {
                let mut res: [[c8]] = [];
                res ~= [v];
                res
            } else if let Ok(a: &Array) = d["version"]? {
                let mut res: [[c8]] = [];
                for i in a[] {
                    if let Str(value-> v) = i {
                        res ~= [v];
                    } else {
                        throw copy AssertError(ctx ~ "'version' must be an array of version filter strings, "
                                               ~ "for example: version = [\">=1.0.0\", \"<2.0.0\"]");
                    }
                }
                res
            } else if ("version" in d) {
                throw copy AssertError(ctx ~ "'version' must be a version filter, or an array of them, "
                                       ~ "for example: version = \">=1.0.0\"");
            } else {
                throw copy AssertError(ctx ~ "missing required entry 'version', for example: version = \">=1.0.0\", "
                                       ~ "or \"*\" for any version");
            };

            self._stdUrl = if let Ok(u) = d["url"]? {
                Url(u, entry-> ctx ~ "'url'")
            } else {
                Url(__DEFAULT_STD_URL__)
            };

            gyllir::config::errors::rejectUnknown(d, ctx, "version", "url");

            // validated eagerly, so a malformed filter is reported when the configuration is
            // loaded, not deep inside a build
            VersionFilter(self._stdVersionRaw, entry-> "'std.version'");
        }

        else throw copy AssertError("'std' must be a table, for example: [std]\nversion = \">=1.0.0\"");
    }

    /**
     * Read a mandatory string entry of the package
     * @params:
     *    - d: the top level table of the configuration file
     *    - key: the name of the entry to read
     *    - example: a correct declaration of that entry, shown to the user when it is missing
     * */
    prv fn readRequired(self, d: &Dict, key: [c8], example: [c8])-> [c8]
        throws AssertError
    {
        if (key !in d) {
            throw copy AssertError("missing required entry '" ~ key ~ "', for example: " ~ example);
        }

        self.readString(d, key, default-> "", example-> example)
    }

    /**
     * Read an optional string entry of the package
     * @params:
     *    - d: the top level table of the configuration file
     *    - key: the name of the entry to read
     *    - default: the value returned when the entry is absent
     *    - example: a correct declaration of that entry, shown to the user when it is malformed
     * */
    prv fn readString(self, d: &Dict, key: [c8], default: [c8], example: [c8])-> [c8]
        throws AssertError
    {
        if let Ok(Str(value-> v)) = d[key]? {
            return v;
        }

        else if let Ok(_) = d[key]? {
            throw copy AssertError("'" ~ key ~ "' must be a string, for example: " ~ example);
        }

        default
    }

    /**
     * Read an optional boolean entry of the package
     * */
    prv fn readBool(self, d: &Dict, key: [c8], default: bool)-> bool
        throws AssertError
    {
        if let Ok(Bool(value-> v)) = d[key]? {
            return v;
        }

        else if let Ok(_) = d[key]? {
            throw copy AssertError("'" ~ key ~ "' must be a boolean, either true or false");
        }

        default
    }

    /**
     * Read an optional array of string entry of the package
     * @params:
     *    - d: the top level table of the configuration file
     *    - key: the name of the entry to read
     *    - example: a correct declaration of that entry, shown to the user when it is malformed
     * */
    prv fn readStringArray(self, d: &Dict, key: [c8], example: [c8])-> [[c8]]
        throws AssertError
    {
        if let Ok(a: &Array) = d[key]? {
            let mut res: [[c8]] = [];
            for i in a[] {
                if let Str(value-> v) = i {
                    res ~= [v];
                } else {
                    throw copy AssertError("'" ~ key ~ "' must be an array of strings, for example: " ~ example);
                }
            }

            return res;
        }

        else if let Ok(_) = d[key]? {
            throw copy AssertError("'" ~ key ~ "' must be an array of strings, for example: " ~ example);
        }

        []
    }

}
