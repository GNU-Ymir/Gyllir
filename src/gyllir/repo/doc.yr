in doc;

use std::{io, env, stream, config::_, fs::{path, errors}, concurrency::process};
use gyllir::{repo::_, utils::_, config::_};
use std::{fs::_, syntax::_};
use gyllir::doc::{_, symbols::_, types::_, html::_};

pub record RepoDocBuilder {

    // The current working directory
    let _cwd: Path;

    // The command line options
    let _args: &Config;

    // The package configuration
    let _cfg: GyllirPackageConfiguration;

    // The target whose documentation is generated
    let _target: Target;

    // True iif the documentation of the target goes to a sub directory named after it, which is
    // what a package declaring more than one target needs to keep the sites apart
    let _subDir: bool;

    // the input file to parse
    let _input: [c8];

    // True iif input file is given instead of gyllir repo
    let _fromFile: bool;

    // The git manager util
    let _git: GitManager;

    // Extra compiler flags gyllir itself needs for this build(forwarded to the 'RepoBuilder' that
    // compiles the target ahead of generating its documentation)
    let _extraFlags: [[c8]];

    /**
     * @params:
     *    - target: the target to document(unused when 'fromFile' is set)
     *    - input: the input file to parse
     *    - subDir: true iif the pages go to '<output>/<target>' instead of '<output>'
     *    - extraFlags: extra compiler flags gyllir itself needs for this build
     * */
    pub self (path: Path, args: &Config, cfg: GyllirPackageConfiguration, target: Target = Target("", BuildType()), input: [c8] = "", fromFile: bool = false, subDir: bool = false, extraFlags: [[c8]] = [])
        with _cwd = path
        , _args = args
        , _cfg = cfg
        , _target = target
        , _subDir = subDir
        , _fromFile = fromFile
        , _input = input
        , _git = GitManager(cwd-> path)
        , _extraFlags = extraFlags
    {}

    /**
     * Run the build executable
     * @params:
     *    - targetIncludes: the root files of the targets of the same package the target links
     *    - targetLinks: the archives of the targets of the same package the target links
     * */
    pub fn run(self, dmut context: &GyllirManager, targetIncludes: [Path] = [], targetLinks: [Path] = [])
        throws RecursiveDependency
    {
        let version = if (self._cfg.name == "") {
            ""
        } else if let Ok(v) = self._git.getCurrentBranchName()? {
            v
        } else { "main" };

        let jsonFile = defaults::targetCacheDir(self._cwd, self._target.name, defaults::__CACHE_DOC_DIR__)
            .push(self._target.outputName()).addExtension(defaults::__DOC_EXTENSION__);

        // Captured before recompiling, so it can be compared against the freshly produced json
        // below : 'gyc -fdoc' rewrites the file (and its mtime) on every compile regardless of
        // whether the extracted documentation actually changed, so mtime alone cannot tell a
        // real update from a no-op recompile (e.g. repeated 'gyllir doc serve' on an unchanged tree)
        let previousContent = if (!self._fromFile) { self.tryReadFile(jsonFile) } else { "" };

        let inputFile = if (!self._fromFile) {
            RepoBuilder(self._cwd, self._args, self._cfg, self._target, forUnitTest-> false, forDoc-> true, extraFlags-> self._extraFlags)
                .run(alias context, targetIncludes-> targetIncludes, targetLinks-> targetLinks);
            jsonFile
        } else {
            Path(self._input)
        };

        let baseDir = if let Ok(Str(value-> dir)) = self._args["output"]? {
            Path(dir)
        } else {
            self._cwd.push(defaults::__DOC_DIR__)
        };

        let outputDir = if (self._subDir) {
            baseDir.push(self._target.name)
        } else { baseDir };

        let content = {
            let dmut file = File::open(inputFile, read-> true);
            let c = file:.readAll();
            file:.close();
            c
        } catch {
            FsError() => {
                utils::log::error("Error", "failed to read documentation file '", inputFile.toStr(), "'");
                etc::c::process::_yrt_exit(-1);
                panic;
            }
        };

        let docConfig = {
            json::parse(content)
        } catch {
            err: &SyntaxError => {
                utils::log::error("Error", "failed to parse documentation file '", inputFile.toStr(), "' : ", err);
                etc::c::process::_yrt_exit(-1);
                panic;
            }
        };

        let symbol = (SymbolLoader()).load(docConfig);
        let (htmlTable, modules) = self.createHtmlTable(symbol);

        // The doc json is unchanged and the pages already there match the current modules exactly
        // (no stray page left by a deleted source, none missing) : nothing to regenerate
        if (!self._fromFile && content == previousContent && self.pagesUpToDate(outputDir, modules)) {
            utils::log::info("Up to date", "documentation pages in '", outputDir.toStr(), "'");
            return;
        }

        self.generate(alias context, version, outputDir, htmlTable, modules);
    }

    /**
     * @returns: true iif every module in 'modules' already has its page in 'outDir', and no extra
     * html page (e.g. left behind by a module whose source was since removed) is present
     * */
    fn pagesUpToDate(self, outDir: Path, modules: [&Module])-> bool {
        let mut expected: [[c8]] = [];
        for m in modules {
            let name = if m.name == "" { "index" } else { m.name };
            expected ~= [Path(name, sep-> "::").addExtension(defaults::__HTML_EXTENSION__).toStr(sep-> "_")];
        }

        let mut nbFound = 0us;
        for i in readDir(outDir) match i {
            FsEntry(kind-> FsEntryKind::FILE, path-> p) if p.extension() == defaults::__HTML_EXTENSION__ => {
                let mut found = false;
                for e in expected if e == p.file() { found = true; }
                if (!found) return false;
                nbFound += 1us;
            }
        }

        nbFound == expected.len
    } catch {
        FsError() => false
    }

    /**
     * @returns: the content of 'p', or an empty string if it does not exist / cannot be read
     * */
    fn tryReadFile(self, p: Path)-> [c8] {
        if (!fs::sys::isFile(p)) { return ""; }

        let dmut f = File::open(p, read-> true);
        let c = f:.readAll();
        f:.close();
        c
    } catch {
        _ => ""
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          BASE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Generate the documentation directory
     * */
    fn generate(self, dmut context: &GyllirManager, version: [c8], outDir: Path, htmlTable: [c8], modules: [&Module]) {
        utils::log::info("Generate", "documentation pages in '", outDir.toStr(), "'");
        self.createBaseDirectory(alias context, outDir);

        for m in modules {
            self.generatePage(self._cfg.name, self._cfg.registry.path.toStr(), version, htmlTable, m, outDir);
        }

    }

    /**
     * Create the base directory
     * @params:
     *    - outDir: the output directory
     * */
    fn createBaseDirectory(self, dmut _: &GyllirManager, outDir: Path) {
        let ymir_res = ressources::RES_ROOT;
        fs::sys::copyDir(ymir_res.push("js"), outDir.push("js"), recursive-> true, create-> true);
        fs::sys::copyDir(ymir_res.push("css"), outDir.push("css"), recursive-> true, create-> true);
        fs::sys::copyDir(ymir_res.push("ico"), outDir.push("ico"), recursive-> true, create-> true);

        // Remove old generated html files
        for i in readDir(outDir) match i {
            FsEntry(kind-> FsEntryKind::FILE, path-> p) if p.extension() == defaults::__HTML_EXTENSION__ => {
                removeFile(p);
            }
        }
    } catch {
        FsError() => {
            utils::log::error("Error", "failed to create directory '", outDir.toStr(), "'");
            etc::c::process::_yrt_exit(-1);
            panic;
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ================================          PAGE GENERATION          =================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Generate the page for a module
     * */
    fn generatePage(self, project: [c8], git: [c8], version: [c8], table: [c8], module: &Module, outDir: Path) {
        let name = if module.name == "" { "index" } else { module.name };

        let body = copy HtmlBody(project, module);
        let head = copy HtmlHeader(project, git, version, name, table, body);
        let foot = copy HtmlFooter(name, git, version);

        let dmut stream = copy StringStream();
        head.dumpHtml(alias stream);
        foot.dumpHtml(alias stream);

        let path = Path(name, sep-> "::").addExtension(defaults::__HTML_EXTENSION__).toStr(sep-> "_");
        {
            let dmut f = File::create(outDir.push(path), write-> true);
            f:.write(stream[]);
        } catch {
            _ => {
                utils::log::warn("Error", "failed to write documentation file for module '", name, "'");
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ================================          HTML MENU TABLE          =================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Create the html table from the symbol tree
     * @params:
     *    - symbol: the list of symbols loaded from json documentation file
     * @returns:
     *    - .0: the html content of the menu table
     *    - .1: the list of modules found in the tree
     * */
    fn createHtmlTable(self, symbol: &Symbol)-> ([c8], [&Module]) {
        let dmut stream = copy StringStream();
        let mut modules: [mut &Module] = [];
        if let m: &Module = symbol {
            self.dumpModuleTable(m, alias stream, ref modules);
        }

        (stream[], modules)
    }

    /**
     * Dump the module table in the stream
     * */
    fn dumpModuleTable(self, module: &Module, dmut stream: &StringStream, ref mut modules: [mut &Module]) {
        modules ~= [module];

        let path = Path(module.name, sep-> "::");
        let mp = copy ["Url" => path.toStr(sep-> "_"), "Name" => path.toStr(sep-> "::"), "Title" => path.toStr(sep-> "::")];
        if module.name.len > 0 {
            formatter::format(alias stream, html::ressources::LEAF_NODE, mp);
        }

        // let mut fst = true;
        for ch in module.childs match ch {
            chMod: &Module => {
                self.dumpModuleTable(chMod, alias stream, ref modules);
            }
        }
    }

}
