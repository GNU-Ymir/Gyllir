in builder;


use gyllir::{config::_, repo::_, utils::_};

use std::{config::_, env, fs::_, io, stream, time::_};
use std::syntax::tokenizer;


/**
 * Build a repository
 */
pub record RepoBuilder {

    // The current working directory
    let _cwd: Path;

    // The command line options
    let _args: &Config;

    // The package configuration
    let _cfg: GyllirPackageConfiguration;

    // The target of the package that is being built
    let _target: Target;

    // True if the builder has to print verbose messages
    let _verbose: bool;

    // True if the repobuilder is used to build unittest executable
    let _forUnitTest: bool;

    // True iif the repobuilder is used to build the documentation file
    let _forDoc: bool;

    // True if does not really compile
    let _dry: bool;

    // The number of threads to spawn in the task pool
    let _nbThreads: u32;

    // Extra compiler flags gyllir itself needs for this build(e.g. '-nostdinc -nomidgardlib' when
    // the std lib was resolved from the remote rather than the one bundled with the compiler),
    // put ahead of the target's own 'flags' so a target can still override them if it has to
    let _extraFlags: [[c8]];

    /**
     * @params:
     *    - cfg: the configuration of the repo
     *    - target: the target of the package to build, the single target synthesized from the top
     *      level fields of 'cfg' when it declares no '[targets.<name>]' table
     *    - extraFlags: extra compiler flags gyllir itself needs for this build
     * */
    pub self (path: Path, args: &Config, cfg: GyllirPackageConfiguration, target: Target, forUnitTest: bool, forDoc: bool = false, dry: bool = false, extraFlags: [[c8]] = [])
        with _cwd = path
        , _args = args
        , _cfg = cfg
        , _target = target
        , _forUnitTest = forUnitTest
        , _forDoc = forDoc
        , _dry = dry
        , _extraFlags = extraFlags
        , _verbose = (if let Ok(Bool(value-> true)) = args["verbose"]? {
            true
        } else { false })
        , _nbThreads = (if let Ok(Int(value-> n)) = args["j"]? {
            cast!u32(n)
        } else { etc::runtime::threads::_yrt_get_nprocs() })
    {}

    /**
     * Build the repository
     * @params:
     *    - context: the context of the compilation
     *    - targetIncludes: the root files of the targets of the same package the built target links
     *    - targetLinks: the archives of the targets of the same package the built target links
     * @returns:
     *    - .0: the list of path to the root files of libraries to include for further dependency building
     *    - .1: the list of path to the built libraries to link for further dependency building
     * */
    pub fn run(self, dmut context: &GyllirManager, targetIncludes: [Path] = [], targetLinks: [Path] = [])-> ([Path], [Path])
        throws RecursiveDependency
    {
        let (depIncludes, depLinks) = self.resolveDependencies(alias context);

        // a target and a dependency of that target may well select the same package, and a target
        // linked by this one has already put its own dependencies on the line
        let includes = context.uniquePaths(depIncludes ~ targetIncludes);
        let links = context.uniquePaths(depLinks ~ targetLinks);
        self.runCommands(alias context, post-> false);
        let (srcPath, cacheDir) = {
            if (self._forDoc) {
                self.buildSourceDoc(alias context, includes)
            } else {
                let (srcPath, cacheDir, changedSources) = self.buildSourceDir(alias context, includes);
                if (self._forUnitTest && !self._dry) {
                    self.buildUnitTest(alias context, srcPath, includes, changedSources);
                }

                (srcPath, cacheDir)
            }
        } catch {
            // a target whose sources are not where they are declared to be: the message names the
            // module gyllir looked for, and the entry that decides where it looks
            err: &AssertError => {
                utils::log::error("Error", err.msg);
                etc::c::process::_yrt_exit(-1);
                panic;
            }
        };

        let cObjects = self.buildCSources(alias context, cacheDir);
        let finalLinks = self.finalizeBuild(alias context, cacheDir, links, cObjects);
        self.runCommands(alias context, post-> true);

        return (context.uniquePaths(includes ~ [srcPath]), context.uniquePaths(finalLinks));
    }


    /**
     * Build the source files
     * @params:
     *    - context: the context of the compilation
     *    - depRoots: the list of dependency root source files
     * @returns:
     *    - .0: the directory containing the result of the compilation
     *    - .1: the path to the root file
     *    - .2: the list of source files that have changed since last compilation
     * */
    prv fn buildSourceDir(self, dmut context: &GyllirManager, includes: [Path])-> (Path, Path, [Path])
        throws AssertError
    {
        let srcPath = self.findRootSourceFile();
        let (cacheDir, sources, changed) = self.listChangedFiles();

        if (self._dry) { return (srcPath, cacheDir, changed); }

        self.createCacheDirs(cacheDir);

        utils::log::info("Compiling", self._target.name, " of ", self._cfg.name, " v", self._cfg.version[]);
        let objFile = cacheDir.push(self._target.outputName()).addExtension(defaults::__LIBRARY_EXTENSION__);

        let yilDir = cacheDir.push(defaults::__YIL_DIR__);
        if !sys::isDir(yilDir) {
            {
                fs::sys::createDir(yilDir);
            } catch {
                err => {
                    utils::log::error("Error", "failed to compile unittests '", self._cfg.name, "' ", err);
                    etc::c::process::_yrt_exit(-1);
                    panic;
                }
            }
        }

        // a deleted module produces no changed file, but the target still has to be relinked without it
        let pruned = self.pruneRemovedModules(cacheDir, sources);

        // if something has to be compiled
        if (changed.len != 0 || pruned || !sys::isFile(objFile)) {

            utils::log::info("Compiling", "target ", self._target.name, " for ", self._cfg.name, " v", self._cfg.version[]);

            // Create the compile options according to the current configuration
            let options = self.createCompileOptions(srcPath, cacheDir, includes);
            let success = self.compileFilesToYIL(alias context, options, sources, changed, yilDir);

            if (!success) {
                self.reportCompilerFailure("failed to compile target");
                etc::c::process::_yrt_exit(-1);
                panic;
            }

            // Create the final object file before finalization using the temporary object files created by the command
            self.buildObject(alias context, objFile, yilDir);
            self.exportDepsFiles(cacheDir);
        }

        (srcPath, cacheDir, changed)
    }


    /**
     * Build the unit test source files
     * @params:
     *    - context: the context of the compilation
     *    - srcPath: the root file of the sources(in src directory)
     * */
    prv fn buildUnitTest(self, dmut context: &GyllirManager, srcPath: Path, includes: [Path], changedSources: [Path])
        throws AssertError
    {
        let (unitSources, unitChanged) = self.listUnittestChangedFiles(changedSources);

        // create the output directory if not exist
        let cacheDir = self.targetCacheDir(defaults::__CACHE_TEST_DIR__);
        self.createCacheDirs(cacheDir);

        let objFile = cacheDir.push(self._target.outputName()).addExtension(defaults::__LIBRARY_EXTENSION__);

        let yilDir = cacheDir.push(defaults::__YIL_DIR__);
        if !sys::isDir(yilDir) {
            {
                fs::sys::createDir(yilDir);
            } catch {
                err => {
                    utils::log::error("Error", "failed to compile unittests '", self._cfg.name, "' ", err);
                    etc::c::process::_yrt_exit(-1);
                    panic;
                }
            }
        }

        // a deleted module produces no changed file, but the target still has to be relinked without it
        let pruned = self.pruneRemovedModules(cacheDir, unitSources);

        // If something has to be compiled
        if (unitChanged.len != 0 || pruned || !sys::isFile(objFile)) {
            let srcTest = self.findRootTestFile();

            utils::log::info("Compiling", "unittest of ", self._target.name, " for ", self._cfg.name, " v", self._cfg.version[]);

            // Create the compile options according to the current configuration
            let options = self.createCompileOptions(srcTest, cacheDir, includes ~ [srcPath]);
            let success = self.compileFilesToYIL(alias context, options, unitSources, unitChanged, yilDir);

            if (!success) {
                self.reportCompilerFailure("failed to compile the unittests of target");
                etc::c::process::_yrt_exit(-1);
                panic;
            }

            self.buildObject(alias context, objFile, yilDir);
            self.exportDepsFiles(cacheDir);
        }
    }

    /**
     * Report a failure of the compiler
     * @params:
     *    - what: what gyllir was asking the compiler to do
     * @info: a compiler that is not installed at all fails exactly like a source file that does not
     *   compile, but its own error output is empty, leaving the user with a message about a
     *   compilation they have nothing to fix, so the two are told apart before printing anything
     * */
    prv fn reportCompilerFailure(self, what: [c8]) {
        if (gyllir::args::compilerVersion(compiler-> self._cfg.compiler) == "") {
            utils::log::error("Error", "compiler '", self._cfg.compiler, "' could not be run, install it or fix the 'compiler' entry of ",
                              defaults::__GYLLIR_CONFIG_FILENAME__);
        } else {
            utils::log::error("Error", what, " '", self._target.name, "' of '", self._cfg.name, "'");
        }
    }

    /**
     * Launch the compile commands to generate the YIL bytecode files
     * */
    prv fn compileFilesToYIL(self, dmut context: &GyllirManager, options: [[c8]], sources: [Path], changed: [Path], yilDir: Path)-> bool {
        let dmut pool = copy std::concurrency::task::TaskPool(nbThreads-> self._nbThreads);
        let dmut success = copy [0us];
        let mut submitted = 0u32;

        let parallel_changed = self.cutModuleList(changed, self._nbThreads);

        for i, m in parallel_changed if m.len > 0 {
            let msg = {
                std::format::format("{} modules in thread {} (among {} changed files of {}) ", m.len, i + 1, changed.len, sources.len)
            } catch { _ => { "\t" } };
            utils::log::info("Compiling", msg);

            submitted += 1;
            pool:.submit(copy || => {
                let mut modOption = options;
                for m_ in m {
                    modOption ~= ["-fmodule", m_.toStr()];
                }
                modOption ~= ["-fyil", yilDir.toStr()];

                // Execute the compile command
                if (!context.runProcess(self._cfg.compiler, modOption, cwd-> self._cwd, verbose-> self._verbose)) {
                    pool:.clear();
                } else {
                    atomic { success[0] += 1; }
                    self.ensureYILAndDepFiles(alias context, yilDir.parent(), m);
                }
            });
        }
        pool:.join();

        return (success[0] == submitted);
    }

    /**
     * Build the documentation file from sources
     * */
    prv fn buildSourceDoc(self, dmut context: &GyllirManager, includes: [Path])-> (Path, Path)
        throws AssertError
    {
        let srcPath = self.findRootSourceFile();
        let cacheDir = self.targetCacheDir(defaults::__CACHE_DOC_DIR__);
        self.createCacheDirs(cacheDir);

        let options = self.createDocCompileOptions(srcPath, includes);
        utils::log::info("Compiling", "documentation of ", self._target.name, " for ", self._cfg.name, " v", self._cfg.version[]);
        if !context.runProcess(self._cfg.compiler, options, cwd-> self._cwd, verbose-> self._verbose) {
            self.reportCompilerFailure("failed to generate the documentation of target");
            etc::c::process::_yrt_exit(-1);
            panic;
        }

        (srcPath, cacheDir)
    }

    /**
     * Finalize the building of the package
     * @params:
     *    - context: the context of the compilation
     *    - cacheDir: the directory in which the building is done
     *    - libs: the list of libraries to link
     * @returns: the list of libraries to link for further dependencies
     * */
    prv fn finalizeBuild(self, dmut context: &GyllirManager, cacheDir: Path, links: [Path], cObjects: [Path])-> [Path] {
        if (self._forDoc) {
            links
        }

        else if self._forUnitTest {
            self.finalizeUnitTest(alias context, cacheDir, links, cObjects);
            links
        }

        else if self._target.type.isExecutable() {
            self.finalizeExecutable(alias context, cacheDir, links, cObjects);
            links
        }

        else {
            let res = self.finalizeLibrary(alias context, cacheDir, links, cObjects);
            links ~ [res]
        }
    }

    /**
     * Compile the 'c-sources' declared by the target into object files
     * @returns: the list of path to the compiled object files, [] for a doc build, a dry run, or a
     *   target declaring none
     * */
    prv fn buildCSources(self, dmut context: &GyllirManager, cacheDir: Path)-> [Path] {
        if (self._forDoc || self._dry) { return []; }

        CSourceBuilder(self._cfg, self._cwd, self._args, self._target, self._verbose, self._nbThreads).run(alias context, cacheDir)
    }


    /**
     * Verify that all YIL files have beed created during the compilation
     * If not, then the module is not attached to the package tree, we create a fake file, and warn about it
     * */
    fn ensureYILAndDepFiles(self, dmut _: &GyllirManager, cacheDir: Path, modules: [Path]) {
        for source in modules {
            let depFile = cacheDir.push(source.stripExtension().toStr(sep-> "_")).addExtension(defaults::__DEPS_EXTENSION__);
            let objFile = cacheDir.push(defaults::__YIL_DIR__).push(source.stripExtension().toStr(sep-> "_")).addExtension(defaults::__YIL_EXTENSION__);

            if !fs::sys::isFile(objFile) {
                log::warn("Warning", "source module ", source.toStr(), " not attached to package");
                {
                    let dmut f = File::create(objFile, write-> true);
                    f:.close();
                }?;
            }

            if !fs::sys::isFile(depFile) {
                {
                    let dmut f = File::create(depFile, write-> true);
                    f:.close();
                }?;
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          COMMAND LINE          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Create the command line used to
     * @returns:
     *   - .0: relink, or full link
     *   - .1: the options to pass to the compiler
     * */
    pub fn createCompileOptions(self, srcPath: Path, cacheDir: Path, depPaths: [Path])-> [[c8]] {
        let mut options: [[c8]] = copy [srcPath.toStr(), "-fPIC", "-c", "-fdump-deps", cacheDir.toStr()];
        if (self._forUnitTest) {
            options ~= ["-funittest"];
        }

        if (self._verbose) {
            options ~= ["-fv"];
        }

        for p in depPaths {
            options ~= ["-I", p.toStr()];
        }

        if let Ok(Bool(value-> _ = true)) = self._args["release"]? {
            options ~= ["-O3"];
        } else {
            options ~= ["-g"];
        }

        options ~= self._extraFlags;

        // last, so that a target can override the options gyllir picked for it(-g, -O3, ...)
        options ~ self._target.flags
    }

    /**
     * Build the compile command line option to build documentation file
     * */
    pub fn createDocCompileOptions(self, srcPath: Path, depPaths: [Path])-> [[c8]] {
        let docDir = self.targetCacheDir(defaults::__CACHE_DOC_DIR__);
        let objectFile = docDir.push(self._target.outputName()).addExtension(defaults::__OBJECT_EXTENSION__).toStr();
        let jsonFile = docDir.push(self._target.outputName()).addExtension(defaults::__DOC_EXTENSION__).toStr();

        let mut options: [[c8]] = copy [srcPath.toStr(), "-c", "-o", objectFile, "-fdoc", jsonFile];
        if (self._verbose) {
            options ~= ["-fv"];
        }

        for p in depPaths {
            options ~= ["-I", p.toStr()];
        }

        options ~= self._extraFlags;

        options ~ self._target.flags
    }

    /**
     * Cut the module list to be compiled by multiple threads
     * */
    fn cutModuleList(self, modules: [Path], nbThreads: u32)-> [[Path]] {
        let mut result: [mut[Path]] = copy [[] for _ in 0 .. nbThreads];
        if modules.len == 0 {
            return result;
        }

        let nbPerTh = modules.len / cast!usize(nbThreads);
        let rest = modules.len % cast!usize(nbThreads);

        if nbPerTh > 0 {
            for i in 0us .. cast!usize(nbThreads) {
                result[i] = modules[i * nbPerTh .. (i + 1) * nbPerTh];
            }
        }

        if rest != 0 {
            let end = modules.len - rest;
            for i in 0 .. rest {
                result[i] ~= [modules[end + i]];
            }
        }

        result
    }

    /**
     * Remove all old symbols from old object file, and relink it with the new one
     * @params:
     *    - files: the list of source files that have been recompiled
     *    - cacheDir: the directory containing the result objects
     * */
    fn buildObject(self, dmut context: &GyllirManager, dstFile: Path, yilDir: Path) {
        utils::log::info("Compiling", "object file ", dstFile.file(), " from YIL bytecodes");
        let yilFiles = self.listFilesInDir(yilDir, yilDir, defaults::__YIL_EXTENSION__);
        let mut options = copy [yilDir.push(f).toStr() for f in yilFiles];

        options ~= ["-fPIC", "-c", "-o", dstFile.toStr()];
        if (self._forUnitTest) {
            options ~= ["-funittest"];
        }

        if (self._verbose) {
            options ~= ["-fv"];
        }

        if let Ok(Bool(value-> _ = true)) = self._args["release"]? {
            options ~= ["-O3"];
        } else {
            options ~= ["-g"];
        }

        options ~= self._extraFlags;

        if (!context.runProcess(self._cfg.compiler, options, cwd-> self._cwd, verbose-> self._verbose)) {
            self.reportCompilerFailure("failed to assemble the object file of target");
            etc::c::process::_yrt_exit(-1);
            panic;
        }
    }

    /**
     * Save the created dependency files
     * */
    fn exportDepsFiles(self, cacheDir: Path) {
        let src = self._cwd.push(defaults::__CACHE_TMP_DIR__);
        for i in fs::sys::readDir(src) match i {
            FsEntry(kind-> FsEntryKind::FILE, path-> p) if (p.extension() == defaults::__DEPS_EXTENSION__) => {
                fs::sys::copyFile(p, cacheDir.push(p.removePrefix(src)))?;
            }
        }

        fs::sys::removeDir(src, recursive-> true)?;
    } catch {
        _ => {
            utils::log::error("Error", "failed to create output directory '", cacheDir.toStr(), "'");
            etc::c::process::_yrt_exit(-1);
            panic;
        }
    }

    /**
     * Create the directory in which cache will be stored
     * */
    fn createCacheDirs(self, cacheDir: Path) {
        if (!sys::isDir(self._cwd.push(defaults::__CACHE_TMP_DIR__))) {
            sys::createDir(self._cwd.push(defaults::__CACHE_TMP_DIR__), recursive-> true);
        }
        // Create the output directory
        if (!sys::isDir(cacheDir)) {
            sys::createDir(cacheDir, recursive-> true);
        }
    } catch {
        _ => {
            utils::log::error("Error", "failed to create output directory '", cacheDir.toStr(), "'");
            etc::c::process::_yrt_exit(-1);
            panic;
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          FINALIZATION          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Finalize the unittest executable
     * */
    prv fn finalizeUnitTest(self, dmut context: &GyllirManager, cacheDir: Path, dependencyLibs: [Path], cObjects: [Path]) {
        let output = self._target.outputName();
        let createdTmp = (cacheDir.push(output).addExtension(defaults::__LIBRARY_EXTENSION__)).toStr();
        let createdUnittests = (self.targetCacheDir(defaults::__CACHE_TEST_DIR__).push(output).addExtension(defaults::__LIBRARY_EXTENSION__)).toStr();

        let mut options = copy ["-fv", "-funittest", createdTmp, createdUnittests, "-o", output ~ ".test"];
        options ~= copy [d.toStr() for d in dependencyLibs];
        options ~= copy [o.toStr() for o in cObjects];

        for k in self._target.libraries {
            options ~= ["-l" ~ k];
        }

        options = if let Ok(Bool(value-> _ = true)) = self._args["release"]? {
            options ~ ["-O3"]
        } else {
            options ~ ["-g"]
        };

        options ~= self._extraFlags;

        if (!context.runProcess(self._cfg.compiler, options, cwd-> self._cwd, verbose-> self._verbose)) {
            self.reportCompilerFailure("failed to link the unittest executable of target");
            etc::c::process::_yrt_exit(-1);
        }

        utils::log::info("Produced", "executable file ", output, ".test");
    }

    /**
     * Finalize the executable
     * */
    prv fn finalizeExecutable(self, dmut context: &GyllirManager, cacheDir: Path, dependencyLibs: [Path], cObjects: [Path]) {
        let output = self._target.outputName();
        let createdTmp = (cacheDir.push(output).addExtension(defaults::__LIBRARY_EXTENSION__)).toStr();

        let mut options = copy ["-fv", createdTmp, "-o", output];
        options ~= copy [d.toStr() for d in dependencyLibs];
        options ~= copy [o.toStr() for o in cObjects];

        for k in self._target.libraries {
            options ~= ["-l" ~ k];
        }

        options = if let Ok(Bool(value-> _ = true)) = self._args["release"]? {
            options ~ ["-O3"]
        } else {
            options ~ ["-g"]
        };

        options ~= self._extraFlags;

        if (!context.runProcess(self._cfg.compiler, options, cwd-> self._cwd, verbose-> self._verbose)) {
            self.reportCompilerFailure("failed to link the executable of target");
            etc::c::process::_yrt_exit(-1);
        }

        utils::log::info("Produced", "executable file ", output);
    }

    /**
     * Finalize the library
     * @returns: the result file
     * */
    prv fn finalizeLibrary(self, dmut context: &GyllirManager, cacheDir: Path, _: [Path], cObjects: [Path])-> Path {
        let output = self._target.outputName();
        let createdTmp = (cacheDir.push(output).addExtension(defaults::__LIBRARY_EXTENSION__)).toStr();
        let resultFile = self._cwd.push("lib" ~ output).addExtension(defaults::__LIBRARY_EXTENSION__);

        // 'createdTmp' is a single relocatable object gathering every compiled module, not a real
        // 'ar' archive: a target with no C source just wears it under the 'lib*.a' name, one that
        // has some is combined with them into a real archive, which 'ar' refuses to append onto an
        // existing plain object, so any stale archive from a previous build is cleared first
        if (cObjects.len == 0us) {
            if (!context.runProcess("cp", copy [createdTmp, resultFile.toStr()], cwd-> self._cwd, verbose-> self._verbose)) {
                utils::log::error("Error", "failed to write the library of target '", self._target.name, "' to '", resultFile.toStr(), "'");
                etc::c::process::_yrt_exit(-1);
            }
        } else {
            if (sys::isFile(resultFile)) {
                sys::removeFile(resultFile)?;
            }

            let mut arOptions = copy ["rcs", resultFile.toStr(), createdTmp];
            arOptions ~= copy [o.toStr() for o in cObjects];

            if (!context.runProcess(defaults::__AR_COMMAND__, arOptions, cwd-> self._cwd, verbose-> self._verbose)) {
                utils::log::error("Error", "failed to archive C sources into '", resultFile.toStr(), "'");
                etc::c::process::_yrt_exit(-1);
            }
        }

        utils::log::info("Produced", "library file ", "lib", output, ".", defaults::__LIBRARY_EXTENSION__);
        resultFile
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===============================          FILE MODIFICATIONS          ===============================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * List the unittest source files that have been changed since the last built
     * @returns:
     *    - .0: true iif all source files have changed(or are new)
     *    - .1: the list of path to modules files that have to be recompiled
     * */
    prv fn listUnittestChangedFiles(self, changedSources: [Path])-> ([Path], [Path]) {
        let rootDir = self._cwd.push(self._target.testDir);
        let cacheDir = self.targetCacheDir(defaults::__CACHE_TEST_DIR__);
        let sources = self.listFilesInDir(rootDir, rootDir, extension-> defaults::__YMIR_EXTENSION__);
        let results = self.lookupDependencies(rootDir, cacheDir, sources, true, changedSources);

        (sources, results)
    }

    /**
     * List the source files that have been changed since the last built
     * @returns:
     *   - .0: true iif all found source files have to be recompiled
     *   - .1: the output directory
     *   - .2: the list of source file to compile(relative path from source dir)
     * */
    prv fn listChangedFiles(self)-> (Path, [Path], [Path]) {
        let cacheDir = self.defineOutputDirectory();
        let rootDir = self._cwd.push(self._target.sourceDir);
        let sources = self.listFilesInDir(rootDir, rootDir, extension-> defaults::__YMIR_EXTENSION__);
        let results = self.lookupDependencies(rootDir, cacheDir, sources, false, []);

        (cacheDir, sources, results)
    }

    /**
     * Remove the YIL and dependency files of the modules that are not part of the source tree anymore
     * Those files are never visited by 'lookupDependencies' (it only iterates over existing sources), so
     * without that pass they would live in the cache forever, and 'buildObject' would keep linking them
     * into the final binary(module starter functions included)
     * @params:
     *    - cacheDir: the output directory containing the dependency files
     *    - sources: the list of source files that still exist(relative path from source dir)
     * @returns: true iif at least one obsolete module was removed from the cache
     * */
    pub fn pruneRemovedModules(self, cacheDir: Path, sources: [Path])-> bool {
        let yilDir = cacheDir.push(defaults::__YIL_DIR__);
        let dmut alive: [[c8] => ()] = copy [];
        for src in sources {
            alive[src.stripExtension().toStr(sep-> "_")] = ();
        }

        let mut pruned = false;
        for f in self.listFilesInDir(yilDir, yilDir, defaults::__YIL_EXTENSION__) {
            if f.stripExtension().toStr(sep-> "_") !in alive {
                utils::log::info("Removing", "obsolete module ", f.file(), " from build cache");
                pruned = self.removeCacheFile(yilDir.push(f)) || pruned;
            }
        }

        for f in self.listFilesInDir(cacheDir, cacheDir, defaults::__DEPS_EXTENSION__) {
            if f.stripExtension().toStr(sep-> "_") !in alive {
                pruned = self.removeCacheFile(cacheDir.push(f)) || pruned;
            }
        }

        return pruned;
    }

    /**
     * Remove a file of the build cache
     * @returns: true iif the file is gone, false(with a warning) if it could not be removed, so that
     *           a file we cannot get rid of does not force a relink at every single build
     * */
    prv fn removeCacheFile(self, file: Path)-> bool {
        sys::removeFile(file)?;
        if sys::isFile(file) {
            utils::log::warn("Warning", "failed to remove obsolete cache file ", file.toStr());
            return false;
        }

        true
    }

    /**
     * Check for changed files in the list of sources, and check for changed file dependencies
     * @params:
     *    - prefix: the directory containing the source files
     *    - cacheDir: the output directory containing the dependency files
     *    - sources: the list of source files
     * @returns: the list of files that have changed since last compilation
     * */
    prv fn lookupDependencies(self, prefix: Path, cacheDir: Path, sources: [Path], forUnitTest: bool, changedSources: [Path])-> [Path] {
        let mut results: [Path] = [];
        let mut deps: [Path => mut[Path]] = copy [];
        for src in sources {
            if let Ok(Instant(sec-> d)) = sys::fileDate(prefix.push(src))? {
                let (exits, srcDeps) = self.readCacheDependencies(prefix, cacheDir, src, d, forUnitTest, changedSources);
                if (exits) {
                    deps[src] = srcDeps;
                } else { results ~= [src]; }
            } else { results ~= [src]; }
        }

        for p, srcDeps in deps {
            let mut found = true;
            for z in srcDeps {
                if z !in deps {
                    found = false;
                    break;
                }
            }

            if !found {
                results ~= [p];
            }
        }

        results
    }

    /**
     * Read a module dependency
     * @params:
     *    - source: the path of the source file
     *    - date: the date of the source file
     * @returns:
     *    - .0: true iif the source file is older than the dep file
     *    - .1: the list of dependencies read in the dep file
     * */
    prv fn readCacheDependencies(self, sourceDir: Path, cacheDir: Path, source: Path, date: u64, forUnitTest: bool, changedSources: [Path])-> (bool, [Path]) {
        let depFile = cacheDir.push(source.stripExtension().toStr(sep-> "_")).addExtension(defaults::__DEPS_EXTENSION__);
        let objFile = cacheDir.push(defaults::__YIL_DIR__).push(source.stripExtension().toStr(sep-> "_")).addExtension(defaults::__YIL_EXTENSION__);
        let packageDir = self._cwd.push(self._target.sourceDir);

        if let Ok(Instant(sec-> d)) = sys::fileDate(depFile)? {
            if d < date || !sys::isFile(objFile) || !sys::isFile(depFile) {
                sys::removeFile(objFile)?;
                sys::removeFile(depFile)?;
                return (false, []);
            }

            {
                let dmut results: [Path] = [];
                let dmut f = File::open(depFile, read-> true);
                while let line = f:.readUntil("\n") && line.len > 0 {
                    let currPath = if line[$ - 1] == '\n' {
                        Path(line[0 .. $ - 1])
                    } else {
                        Path(line)
                    };

                    if sourceDir.isPrefix(currPath) {
                        results ~= [currPath.removePrefix(sourceDir)];
                    }

                    else if forUnitTest && packageDir.isPrefix(currPath) {
                        for z in changedSources if packageDir.push(z) == currPath {
                            sys::removeFile(objFile)?;
                            sys::removeFile(depFile)?;
                            return (false, []);
                        }
                    }
                }

                return (true, results);
            } catch {
                _ => {}
            }
        }

        // No dependency file found
        return (false, []);
    }


    /**
     * List the source files that can be found in the directory 'root' (recursively)
     * @params:
     *    - root: the root directory to read
     * @returns: the list of source files
     * */
    prv fn listFilesInDir(self, root: Path, curr: Path, extension: [c8])-> [Path] {
        let dmut result: [Path] = [];
        {
            for entry in sys::readDir(curr) {
                match entry {
                    FsEntry(path-> p, kind-> FsEntryKind::DIR) => {
                        result ~= self.listFilesInDir(root, p, extension);
                    }
                    FsEntry(path-> p, kind-> FsEntryKind::FILE) if (p.extension() == extension) => {
                        result ~= [p.removePrefix(root)];
                    }
                }
            }
        } catch {
            _ => {}
        }

        result
    }

    /**
     * Find the root file of the target
     * @returns: the path to the root file of the target
     * */
    prv fn findRootSourceFile(self)-> Path
        throws AssertError
    {
        let srcDir = self._cwd.push(self._target.sourceDir);

        // Overriden by configuration file, a declared root that does not exist is an error, never a fallback
        if let name = self._target.packageRoot && name != "" {
            let rootPath = srcDir.push(name).addExtension(defaults::__YMIR_EXTENSION__);
            if (!fs::sys::isFile(rootPath)) {
                throw copy AssertError(self.targetContext() ~ "'package-root' names '" ~ name ~ "', but there is no "
                                       ~ rootPath.toStr());
            }

            return rootPath;
        }

        // The target synthesized for a package declaring no '[targets.<name>]' table roots at the
        // file matching its type ('__lib__.yr' for a library, 'main.yr' for an executable), never
        // at a module named after the package, so a module of that name stays a regular module and
        // never conflicts with this resolution
        if (self._target.synthesized) {
            let fileName = if (self._target.type.isExecutable()) { defaults::__MAIN_FILE__ } else { defaults::__LIB_FILE__ };
            let rootPath = srcDir.push(fileName);
            if (fs::sys::isFile(rootPath)) {
                return rootPath;
            }

            throw copy AssertError(self.targetContext() ~ "no root module, create " ~ rootPath.toStr()
                                   ~ ", or name another one with 'package-root'");
        }

        // A declared target roots at its own name and nowhere else
        let rootPath = srcDir.push(self._target.rootModule()).addExtension(defaults::__YMIR_EXTENSION__);
        if (fs::sys::isFile(rootPath)) {
            return rootPath;
        }

        throw copy AssertError(self.targetContext() ~ "no root module, create " ~ rootPath.toStr()
                               ~ ", or name another one with 'package-root'");
    }

    /**
     * Find the root file of the test directory
     * @returns: the path to the root file of unittests
     * */
    prv fn findRootTestFile(self)-> Path
        throws AssertError
    {
        // Overriden by configuration file
        if let name = self._target.testRoot && name != "" {
            let mainPath = self._cwd.push(self._target.testDir).push(name).addExtension(defaults::__YMIR_EXTENSION__);
            if (!fs::sys::isFile(mainPath)) {
                throw copy AssertError(self.targetContext() ~ "'test-root' names '" ~ name ~ "', but there is no "
                                       ~ mainPath.toStr());
            }

            return mainPath;
        }


        // Searching for default root file __test__.yr
        let libPath = self._cwd.push(self._target.testDir).push(defaults::__FST_TEST_FILE__);
        if (fs::sys::isFile(libPath)) {
            return libPath;
        }

        throw copy AssertError(self.targetContext() ~ "no unittest root module, create " ~ libPath.toStr()
                               ~ ", or name another one with 'test-root'");
    }

    /**
     * @returns: the prefix naming the target being built, for an error message
     * */
    prv fn targetContext(self)-> [c8] {
        "target '" ~ self._target.name ~ "' of '" ~ self._cfg.name ~ "': "
    }

    /**
     * The build cache of the target being built
     * @params:
     *    - kind: the sub directory of the cache, one of the '__CACHE_*_DIR__' defaults
     * @returns: '<cwd>/.target/<target>/<kind>'
     * */
    prv fn targetCacheDir(self, kind: [c8])-> Path {
        defaults::targetCacheDir(self._cwd, self._target.name, kind)
    }

    /**
     * Define the output directory of the build
     * */
    prv fn defineOutputDirectory(self)-> Path {
        if let Ok(Bool(value-> _ = true)) = self._args["release"]? {
            if self._forUnitTest {
                self.targetCacheDir(defaults::__CACHE_UNIT_RELEASE_DIR__)
            } else {
                self.targetCacheDir(defaults::__CACHE_RELEASE_DIR__)
            }
        }

        else {
            if self._forUnitTest {
                self.targetCacheDir(defaults::__CACHE_UNIT_DEBUG_DIR__)
            } else {
                self.targetCacheDir(defaults::__CACHE_DEBUG_DIR__)
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ================================          CUSTOM COMMANDS          =================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Execute the commands to run before the compilation
     * */
    prv fn runCommands(self, dmut context: &GyllirManager, post: bool) {
        let dmut tzer = Tokenizer!c8();
        tzer:.insert(" ", isSkip-> true);
        for k, c in self._cfg.commands[] {
            if c.isPost() == post {
                let cmd = tzer.tokenizeWithoutSkips(c.cmd);
                let path = if (c.cwd.isAbsolute()) {
                    c.cwd
                } else { self._cwd.push(c.cwd) };

                let succ = if (cmd.len > 0) {
                    context.runProcess(cmd[0], cmd[1 .. $], cwd-> path)
                } else { false };

                if !succ {
                    utils::log::error("Error", "command '", k, "' failed: ", c.cmd, ", declared by '[commands.", k, "]' of ",
                                      defaults::__GYLLIR_CONFIG_FILENAME__);
                    etc::c::process::_yrt_exit(-1);
                }
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          DEPENDENCIES          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Resolve the dependencies of the package and build them
     * @params:
     *    - context: the context of the compilation
     * @returns:
     *    - .0: the list of root files to include in the compilation
     *    - .1: the list of path to the built libraries to link
     * */
    prv fn resolveDependencies(self, dmut context: &GyllirManager)-> ([Path], [Path])
        throws RecursiveDependency
    {
        let dmut libs: [Path] = [];
        let dmut names: [Path] = [];
        for k, d in self._cfg.dependencies[] if self._target.selects(k) {
            let (n, l) = context:.resolveDependency(self._args, self._cwd, k, d, dry-> (self._forDoc || self._dry));
            libs ~= l;
            names ~= n;
        }

        (names, libs)
    }

}
