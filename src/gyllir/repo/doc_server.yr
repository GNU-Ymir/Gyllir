in doc_server;

use std::{io, env, config::_, fs::_, syntax::_};
use std::net::_;
use gyllir::{repo::_, utils::_, config::_};
use gyllir::doc::{index, loader, symbols::_};

/**
 * The opening of the inline configuration object every generated page declares for its javascript
 * (see 'res/html/footer.html')
 * */
pub def __DOC_CONFIG_OPENING__ = "window.GYLLIR_DOC = {";

/**
 * The entry added to that configuration object in every page served, telling 'res/js/main.js'
 * that a documentation server is answering it : the search box of a served page queries '/symbol'
 * for the symbols of the whole site, where a page opened from a static 'gyllir doc' output only
 * searches itself.
 * */
pub def __SERVE_FLAG__ = " serve: true,";

/**
 * Serves an already generated documentation directory ('gyllir doc') over HTTP.
 * */
pub class RepoDocServer {

    // The current working directory
    let _cwd: Path;

    // The command line options
    let _args: &Config;

    // The symbols of the served documentation, preloaded from the '*.doc.json' of the target the
    // documentation was generated from, and queried by the '/symbol' route
    let _index: &index::SymbolIndex;

    pub self (path: Path, args: &Config, cfg: GyllirPackageConfiguration)
        with _cwd = path
        , _args = args
        , _index = loadIndex(path, args, cfg)
    {}

    /**
     * Start the http server and block until it is killed
     * */
    pub fn run(self) {
        let outDir = self.outputDir();
        if (!fs::sys::isFile(outDir.push("index.html"))) {
            utils::log::error("Error", "no documentation found in '", outDir.toStr(),
                               "', run 'gyllir doc' first");
            etc::c::process::_yrt_exit(-1);
            panic;
        }

        let host = if let Ok(Str(value-> h)) = self._args["host"]? { h } else { "127.0.0.1" };
        let port: u16 = if let Ok(Int(value-> p)) = self._args["port"]? { cast!u16(p) } else { 8000u16 };

        let ip = {
            std::net::addr::conv::to!{&IpAddr} (host)
        } catch {
            _ => {
                utils::log::error("Error", "invalid host address '", host, "'");
                etc::c::process::_yrt_exit(-1);
                panic;
            }
        };

        let dmut server = copy HttpServer(SockAddr(ip, port));
        server:.route(Path(__SYMBOL_ROUTE__), &self.onSymbol,
                      method-> HttpRequestKind::POST | HttpRequestKind::GET);
        server:.setOn404(&self.onRequest);
        server:.start();

        utils::log::info("Serving", "documentation of '", outDir.toStr(), "' on http://", host, ":",
                          std::conv::to!{[c8]} (server.port), "/");

        server:.join();
    } catch {
        e: &HttpError => {
            utils::log::error("Error", "failed to start the documentation server : ", e);
            etc::c::process::_yrt_exit(-1);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SERVING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Answer any request by serving the matching file in the documentation directory, or a 404
     * */
    fn onRequest(self, rqt: HttpRequest)-> HttpResponse {
        let outDir = self.outputDir();
        let mut fsPath = outDir;
        let mut isRoot = true;
        for p in rqt.url.parts() {
            if (p == "" || p == "." || p == "..") continue;
            fsPath = fsPath.push(p);
            isRoot = false;
        }

        if (isRoot || fs::sys::isDir(fsPath)) {
            fsPath = fsPath.push("index.html");
        }

        if (!fs::sys::isFile(fsPath)) {
            return HttpResponse(404, body-> "Not Found");
        }

        let dmut f = File::open(fsPath, read-> true);
        let content = f:.readAll();
        f:.close();

        let body = if (fsPath.extension() == defaults::__HTML_EXTENSION__) {
            withServeFlag(content)
        } else { content };

        HttpResponse(200, body-> body, contentType-> self.contentType(fsPath))
    } catch {
        _ => HttpResponse(500, body-> "Internal Server Error")
    }

    /**
     * @returns: the content type of the file, guessed from its extension
     * */
    fn contentType(self, p: Path)-> [c8] {
        match p.extension() {
            "html" => { "text/html; charset=utf-8" }
            "css" => { "text/css" }
            "js" => { "application/javascript" }
            "json" => { "application/json" }
            "ico" => { "image/x-icon" }
            "svg" => { "image/svg+xml" }
            "png" => { "image/png" }
            _ => { "application/octet-stream" }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SYMBOLS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Answer a '/symbol' request with the symbols of the documentation matching the query
     * @info: the query is read from the json body of a POST ('{"query": "...", "type": "..."}',
     *   'type' being optional), or from the url parameters of a GET, so that the endpoint can be
     *   poked with a plain 'curl'
     * */
    fn onSymbol(self, rqt: HttpRequest)-> HttpResponse {
        let (query, kind) = self.symbolQuery(rqt);
        if (query.len == 0us) {
            return self.jsonResponse(400, "{\"error\": \"missing \\\"query\\\"\"}");
        }

        let (results, total) = self._index.search(query, kind-> kind);

        let dmut arr = copy Array();
        for r in results {
            let dmut entry = copy Dict();
            entry["name"] = copy Str(r.name);
            entry["kind"] = copy Str(r.kind);
            entry["module"] = copy Str(r.module);
            entry["url"] = copy Str(r.url);

            arr:.push(entry);
        }

        let dmut res = copy Dict();
        res["results"] = arr;
        // the number of symbols that matched, which is more than the number of results when the
        // search dropped some of them to cap the size of the answer
        res["total"] = copy Int(cast!i64(total));

        self.jsonResponse(200, json::dump(res))
    }

    /**
     * @returns:
     *    - .0: the symbol name a '/symbol' request is looking for ("" when it names none)
     *    - .1: the kind the results are restricted to ("" when the request names none)
     * */
    fn symbolQuery(self, rqt: HttpRequest)-> ([c8], [c8]) {
        if (rqt.body.len != 0us) {
            if let d: &Dict = json::parse(rqt.body) {
                let query = if let Ok(Str(value-> q)) = d["query"]? { q } else { "" };
                let kind = if let Ok(Str(value-> k)) = d["type"]? { k } else { "" };

                return (query, kind);
            }
        }

        let query = if let Ok(q) = rqt.parameters["query"] { q } else { "" };
        let kind = if let Ok(k) = rqt.parameters["type"] { k } else { "" };

        (query, kind)
    } catch {
        // a body that is not json at all : answered like a request naming no symbol
        _: &SyntaxError => { ("", "") }
    }

    /**
     * @returns: a json response
     * */
    fn jsonResponse(self, code: u32, body: [c8])-> HttpResponse {
        HttpResponse(code, body-> body, contentType-> "application/json")
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          OUTPUT DIR          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the documentation directory to serve, following the same '--output [target]'
     *   resolution as 'gyllir doc'
     * */
    fn outputDir(self)-> Path {
        let baseDir = if let Ok(Str(value-> dir)) = self._args["output"]? {
            Path(dir)
        } else {
            self._cwd.push(defaults::__DOC_DIR__)
        };

        if let Ok(Str(value-> t)) = self._args["target"]? {
            baseDir.push(t)
        } else {
            baseDir
        }
    }

}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          INDEXING          ===================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * The route answering the symbol queries of the search box of a served page
 * */
pub def __SYMBOL_ROUTE__ = "/symbol";

/**
 * @returns: the content of a page, with the flag telling its javascript that it is served by
 *   'gyllir doc serve' (and can therefore query '/symbol') added to its configuration object
 * @info: a page whose configuration object cannot be found (generated by another version of
 *   gyllir) is served untouched : its search box just stays local to the page
 * */
pub fn withServeFlag(content: [c8])-> [c8] {
    if let Ok(i) = index::findSub(content, __DOC_CONFIG_OPENING__) {
        let cut = i + __DOC_CONFIG_OPENING__.len;
        return content[0us .. cut] ~ __SERVE_FLAG__ ~ content[cut .. $];
    }

    content
}

/**
 * Preload the symbols of the documentation being served, from the '*.doc.json' the doc build of
 * the target just produced
 * @info: a documentation directory generated elsewhere (or by an older gyllir) has no such file
 *   next to it : the pages are still served, only '/symbol' comes back empty
 * */
prv fn loadIndex(cwd: Path, args: &Config, cfg: GyllirPackageConfiguration)-> &index::SymbolIndex {
    if let Ok(target) = servedTarget(args, cfg) {
        let jsonFile = defaults::targetCacheDir(cwd, target.name, defaults::__CACHE_DOC_DIR__)
            .push(target.outputName()).addExtension(defaults::__DOC_EXTENSION__);

        if let Ok(symbols) = loadSymbols(jsonFile) {
            return copy index::SymbolIndex(symbols);
        }

        utils::log::warn("Warning", "no documentation file '", jsonFile.toStr(), "', '",
                          __SYMBOL_ROUTE__, "' will find nothing");
    } else {
        utils::log::warn("Warning", "no target to index the symbols of, '", __SYMBOL_ROUTE__,
                          "' will find nothing");
    }

    copy index::SymbolIndex(none_::NONE_SYMBOL)
}

/**
 * @returns: the symbol tree documented by a '*.doc.json', none if it cannot be read or parsed
 * */
prv fn loadSymbols(jsonFile: Path)-> (&Symbol)? {
    let content = {
        let dmut f = File::open(jsonFile, read-> true);
        let c = f:.readAll();
        f:.close();
        c
    } catch {
        _: &FsError => { return none; }
    };

    let docConfig = {
        json::parse(content)
    } catch {
        err: &SyntaxError => {
            utils::log::warn("Warning", "failed to parse documentation file '", jsonFile.toStr(),
                              "' : ", err);
            return none;
        }
    };

    ((SymbolLoader()).load(docConfig))?
}

/**
 * @returns: the target whose documentation is served, following the same resolution as the
 *   '--output [target]' of 'gyllir doc': the one the command line names, or the only one the
 *   package declares
 * */
prv fn servedTarget(args: &Config, cfg: GyllirPackageConfiguration)-> (Target)? {
    let targets = cfg.targets();
    if let Ok(Str(value-> name)) = args["target"]? {
        if let Ok(t) = targets[name] { return (t)?; }
        return none;
    }

    if (targets.len == 1us) {
        for _, t in targets { return (t)?; }
    }

    none
}
