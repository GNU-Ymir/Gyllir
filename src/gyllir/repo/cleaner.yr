in cleaner;

use gyllir::config::_;
use gyllir::repo::manager;

use std::{config, env, io, stream};
use std::concurrency;
use std::fs;

pub record RepoCleaner {

    // The current working directory
    let _cwd: Path;

    // The command line options
    let _args: &Config;

    // The package configuration
    let _cfg: GyllirPackageConfiguration;

    /**
     * @params:
     *    - cfg: the configuration of the repo
     * */
    pub self (path: Path, args: &Config, cfg: GyllirPackageConfiguration)
        with _cwd = path
        , _args = args
        , _cfg = cfg
    {}

    /**
     * Clean directory
     * */
    pub fn run(self, dmut context: &GyllirManager)
        throws RecursiveDependency
    {
        if let Ok(Bool(value-> _ = true)) = self._args["all"]? {
            self.cleanDoc();
            self.cleanDeps(alias context, recursive-> true);
            self.cleanOutputs();
        } else if let Ok(Bool(value-> _ = true)) = self._args["doc"]? {
            self.cleanDoc();
        } else {
            self.cleanOutputs();
        }
    }

    /**
     * Clean the documentation files
     * */
    pub fn cleanDoc(self) {
        let docDir = self._cwd.push(defaults::__DOC_DIR__);
        utils::log::info("Removing", "documentation directory ", docDir.toStr());
        {
            fs::removeDir(docDir, recursive-> true);
        }?;
    }

    /**
     * Clean the dependency directory
     * */
    pub fn cleanDeps(self, dmut context: &GyllirManager, recursive: bool)
        throws RecursiveDependency
    {
        let depDir = self._cwd.push(defaults::__DEPENCY_DIR__);
        utils::log::info("Removing", "dependency directory ", depDir.toStr());
        if recursive {
            for k, d in self._cfg.dependencies[] {
                context:.cleanDependency(self._args, self._cwd, k, d);
            }
        }

        {
            fs::removeDir(depDir, recursive-> true);
        }?;
    }

    /**
     * Remove the build cache of the package, and the artifacts of every one of its targets
     * */
    pub fn cleanOutputs(self) {
        let cacheDir = self._cwd.push(defaults::__CACHE_ALL_DIR__);
        utils::log::info("Removing", "cache directory ", cacheDir.toStr());
        {
            fs::removeDir(cacheDir, recursive-> true);
        }?;

        for _, t in self._cfg.targets() {
            self.cleanTargetOutputs(t);
        }
    }

    /**
     * Remove the artifacts of a single target, from its output directory, and that directory itself
     * when nothing else is left in it
     * */
    prv fn cleanTargetOutputs(self, target: Target) {
        let output = target.outputName();
        let outFile = if target.type.isExecutable() {
            target.artifactPath(self._cwd, output)
        } else {
            target.artifactPath(self._cwd, defaults::libraryFileName(output))
        };

        utils::log::info("Removing", "output file ", outFile.toStr());
        {
            fs::removeFile(outFile);
        }?;

        let testFile = target.artifactPath(self._cwd, output ~ defaults::__TEST_EXECUTABLE_SUFFIX__);
        utils::log::info("Removing", "test file ", testFile.toStr());
        {
            fs::removeFile(testFile);
        }?;

        self.cleanOutputDir(target);
    }

    /**
     * Remove the output directory of a target, if it is empty. Only a directory inside the package
     * is ever removed: one outside of it(absolute, or reached through '..') is shared with whatever
     * else is there, and the package directory itself is never removed
     * */
    prv fn cleanOutputDir(self, target: Target) {
        let dir = Path(target.outputDirectory()).normalize();
        let rel = dir.toStr();
        if (dir.isAbsolute() || rel == "." || rel == ".." || (rel.len > 3us && rel[0us .. 3us] == "../")) {
            return;
        }

        let path = self._cwd.push(dir);
        if (!fs::isDir(path, followLink-> false)) { return; }

        // not recursive: a directory still holding anything else(the artifacts of another target,
        // a file of the user) is refused by the system, and left where it is
        {
            fs::removeDir(path);
            utils::log::info("Removing", "output directory ", path.toStr());
        }?;
    }
}
