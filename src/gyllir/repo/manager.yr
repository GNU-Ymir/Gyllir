in manager;

use std::{config::_, fs::_, io, stream};
use gyllir::{config::_, args, args::_, utils::_};
use gyllir::repo::_;
use std::{algorithm::sorting, concurrency::process, syntax::errors, syntax::tokenizer};

extern (C) fn printf(c: *c8, ...);
extern (C) fn fflush(i: *void);
extern (C) static stdout: *void;

/**
 * The gyllir manager if the core of gyllir
 */
pub class GyllirManager {

    // The list of arguments passed to the program
    let mut _args: &Config;

    // The list of resolved dependencies
    let dmut _depPackages: [Url => ()] = copy [];

    /**
     * Create a Gyllir builder from an argument
     */
    pub self (args: [[c8]])
        with _args = (copy GyllirArgumentParser()).parse(args)
    {}

    /**
     * Run the builder
     * @returns: the builder did something
     */
    pub fn run(mut self) {
        if let Ok(c) = self._args["init"]? {
            RepoInitializer(c).run(self)
        }

        else if let Ok(c) =  self._args["build"]? {
            let cwd = env::currentDir();
            let cfg = self.loadToml(cwd);
            self:.buildTargets(cwd, c, cfg, self.selectTargets(cfg, c));
        }

        else if let Ok(c) = self._args["run"]? {
            let cwd = env::currentDir();
            let cfg = self.loadToml(cwd);
            let (target, forwarded) = self.selectRunTarget(cfg, c);

            self:.buildTargets(cwd, copy Dict(), cfg, copy [target.name => ()]);
            etc::c::process::_yrt_exit(RepoRunner(cwd, forwarded, cfg, target, forUnitTest-> false).run());
        }

        else if let Ok(c) = self._args["clean"]? {
            RepoCleaner(env::currentDir(), c, self.loadToml(env::currentDir())).run(alias self);
        }

        else if let Ok(c) = self._args["publish"]? {
            RepoPublisher(env::currentDir(), c, self.loadToml(env::currentDir())).run(alias self);
        }

        else if let Ok(c) = self._args["test"]? {
            let cwd = env::currentDir();
            let cfg = self.loadToml(cwd);
            let (built, _, _) = self:.buildTargets(cwd, c, cfg, self.selectTestTargets(cfg, c), forUnitTest-> true);
            if let Ok(Bool(value-> _ = false)) = c["dry"]? {
                etc::c::process::_yrt_exit(self.runUnitTests(cwd, cfg, built));
            }
        }

        else if let Ok(c) = self._args["doc"]? {
            let cwd = env::currentDir();
            if let Ok(Str(value-> file)) = c["input"]? {
                RepoDocBuilder(cwd, c, self.tryLoadToml(cwd), input-> file, fromFile-> true).run(alias self);
            } else {
                let cfg = self.loadToml(cwd);
                self:.buildTargets(cwd, c, cfg, self.selectTargets(cfg, c), forDoc-> true);
            }
        }

        else panic;
    } catch {
        // a misconfigured package, or a command line naming a target that does not exist: the message
        // is written for the user, a stack trace into gyllir would only bury it
        a: &AssertError => {
            utils::log::error("Error", a.msg);
            etc::c::process::_yrt_exit(-1);
        }
        err => {
            utils::log::error("Error", err);
            etc::c::process::_yrt_exit(-1);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */


    /**
     * Load the configuration file
     * */
    prv fn loadToml(self, path: Path)-> GyllirPackageConfiguration {
        let dmut f = File::open(path.push(defaults::__GYLLIR_CONFIG_FILENAME__));
        let cfg = std::config::toml::parse(f:.readAll());
        f:.close();

        GyllirPackageConfiguration(cfg)
    } catch {
        FsError() => {
            if (!fs::sys::isFile(path.push(defaults::__GYLLIR_CONFIG_FILENAME__))) {
                utils::log::error("Error", "no ", defaults::__GYLLIR_CONFIG_FILENAME__, " in '", path.toStr(),
                                  "', run 'gyllir init' to create a package there");
            } else {
                utils::log::error("Error", "failed to read '", self.configFile(path), "'");
            }

            etc::c::process::_yrt_exit(-1);
            panic;
        }
        // a gyllir.toml that is not even TOML: the parser locates the character it choked on, which
        // is all the user needs, a stack trace into the parser is noise
        s: &SyntaxError => {
            utils::log::error("Error", "'", self.configFile(path), "' is not valid TOML, line ", s.line,
                              " column ", s.col, ": ", s.msg);
            etc::c::process::_yrt_exit(-1);
            panic;
        }
        // a malformed gyllir.toml: the message names the entry the user has to fix, a stack trace
        // into the configuration parser would only bury it
        a: &AssertError => {
            utils::log::error("Error", "in '", self.configFile(path), "', ", a.msg);
            etc::c::process::_yrt_exit(-1);
            panic;
        }
    }

    /**
     * @returns: the path of the configuration file of a package, as it is named in an error
     *    message: relative to the current directory for the package being built, absolute for a
     *    dependency resolved somewhere else, so that an error never leaves the user wondering which
     *    of the two configuration files it comes from
     * */
    prv fn configFile(self, path: Path)-> [c8] {
        let file = path.push(defaults::__GYLLIR_CONFIG_FILENAME__);
        let cwd = env::currentDir();
        if (cwd.isPrefix(file)) {
            return file.removePrefix(cwd).toStr();
        }

        file.toStr()
    }

    /**
     * Load the configuration file(but return a empty configuration if not found)
     * */
    prv fn tryLoadToml(self, path: Path)-> GyllirPackageConfiguration {
        let dmut f = File::open(path.push(defaults::__GYLLIR_CONFIG_FILENAME__));
        let cfg = std::config::toml::parse(f:.readAll());
        f:.close();

        GyllirPackageConfiguration(cfg)
    } catch {
        _ => { GyllirPackageConfiguration::empty() }
    }


    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          TARGETS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Build a set of targets of a package, and every target of that package they link, in an order
     * where a target is always built after the ones it links
     * @params:
     *    - cwd: the root directory of the package
     *    - args: the configuration of the sub command
     *    - cfg: the configuration of the package
     *    - selected: the names of the targets to build
     *    - forUnitTest: true to also build the unittest executable of the selected targets
     *    - forDoc: true to generate the documentation of the selected targets instead of building them
     *    - dry: true to resolve the dependencies without compiling anything
     * @returns:
     *    - .0: the selected targets, in the order they were built
     *    - .1: the root files to include to compile against the selected targets
     *    - .2: the archives to link against the selected targets
     * */
    pub fn buildTargets(mut self, cwd: Path, args: &Config, cfg: GyllirPackageConfiguration, selected: [[c8] => ()],
                        forUnitTest: bool = false, forDoc: bool = false, dry: bool = false)-> ([Target], [Path], [Path])
        throws AssertError, RecursiveDependency
    {
        let targets = cfg.targets();
        let ordered = self.orderedTargets(cfg, targets);
        let linked = self.linkedTargets(targets, selected);

        // the documentation of a package producing several artifacts is one site per target
        let subDir = targets.len > 1us;

        let mut builtIncludes: [[c8] => mut [Path]] = copy [];
        let mut builtLinks: [[c8] => mut [Path]] = copy [];

        let mut res: [Target] = [];
        let mut outIncludes: [Path] = [];
        let mut outLinks: [Path] = [];

        for t in ordered {
            let isLinked = t.name in linked;
            let isSelected = t.name in selected;

            if (isLinked || isSelected) {
                let (includes, links) = self.gatherTargetArtifacts(t, builtIncludes, builtLinks);

                let mut ownIncludes: [Path] = [];
                let mut ownLinks: [Path] = [];
                let mut hasOwn = false;

                // a target another one links is always built as an artifact first: the unittest and
                // the documentation builds of a target produce nothing to link against
                if (isLinked) {
                    let (i, l) = RepoBuilder(cwd, args, cfg, t, forUnitTest-> false, dry-> dry)
                        .run(alias self, targetIncludes-> includes, targetLinks-> links);

                    builtIncludes[t.name] = i;
                    builtLinks[t.name] = l;
                    ownIncludes = i;
                    ownLinks = l;
                    hasOwn = true;
                }

                if (isSelected) {
                    if (forDoc) {
                        RepoDocBuilder(cwd, args, cfg, target-> t, subDir-> subDir)
                            .run(alias self, targetIncludes-> includes, targetLinks-> links);
                    }

                    else if (forUnitTest || !hasOwn) {
                        let (i, l) = RepoBuilder(cwd, args, cfg, t, forUnitTest-> forUnitTest, dry-> dry)
                            .run(alias self, targetIncludes-> includes, targetLinks-> links);

                        if (!hasOwn) {
                            ownIncludes = i;
                            ownLinks = l;
                        }
                    }

                    res ~= [t];
                    outIncludes ~= ownIncludes;
                    outLinks ~= ownLinks;
                }
            }
        }

        (res, self.uniquePaths(outIncludes), self.uniquePaths(outLinks))
    }

    /**
     * The targets of a package to build, according to the command line
     * @params:
     *    - cfg: the configuration of the package
     *    - args: the configuration of the sub command
     * @returns: the names of the targets named by the command line, or every declared target when it
     *    names none
     * @throws:
     *    - AssertError: if the command line names a target the package does not declare
     * */
    pub fn selectTargets(self, cfg: GyllirPackageConfiguration, args: &Config)-> [[c8] => ()]
        throws AssertError
    {
        let targets = cfg.targets();
        let dmut res: [[c8] => ()] = copy [];

        if let Ok(Str(value-> name)) = args["target"]? {
            if (name !in targets) {
                throw copy AssertError("unknown target '" ~ name ~ "', " ~ self.targetNames(targets));
            }

            res[name] = ();
            return res;
        }

        for k, _ in targets {
            res[k] = ();
        }

        res
    }

    /**
     * The targets of a package to test, according to the command line
     * @params:
     *    - cfg: the configuration of the package
     *    - args: the configuration of the sub command
     * @returns: the target named by the command line, or every testable target when it names none
     * @throws:
     *    - AssertError: if the command line names a target the package does not declare, names a
     *      target that opted out of unittesting, or names none while the package has no testable
     *      target at all
     * */
    pub fn selectTestTargets(self, cfg: GyllirPackageConfiguration, args: &Config)-> [[c8] => ()]
        throws AssertError
    {
        let targets = cfg.targets();

        if let Ok(Str(value-> name)) = args["target"]? {
            if (name !in targets) {
                throw copy AssertError("unknown target '" ~ name ~ "', " ~ self.targetNames(targets));
            }

            if let Ok(t) = targets[name] && !t.tests {
                throw copy AssertError("target '" ~ name ~ "' has 'tests' set to false, it declares no unittest");
            }

            return copy [name => ()];
        }

        let dmut res: [[c8] => ()] = copy [];
        for k, t in targets if t.tests {
            res[k] = ();
        }

        if (res.len == 0us) {
            throw copy AssertError("no testable target, " ~ self.targetNames(targets));
        }

        res
    }

    /**
     * Run the unittest executables of a list of targets, one after the other
     * @returns: the exit code of the first failing one, 0 if they all passed
     * */
    pub fn runUnitTests(self, cwd: Path, cfg: GyllirPackageConfiguration, targets: [Target])-> i32
        throws AssertError, FsError
    {
        let mut res = 0;
        for t in targets {
            let code = RepoRunner(cwd, copy Dict(), cfg, t, forUnitTest-> true).run();
            if (code != 0 && res == 0) {
                res = code;
            }
        }

        res
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          TARGET ORDER          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * The targets of a package, ordered so that a target always comes after the targets of the same
     * package it links
     * @params:
     *    - cfg: the configuration of the package
     *    - targets: the targets of that package
     * @throws:
     *    - AssertError: if a target links a target, or selects a dependency, that is not declared
     *    - RecursiveDependency: if the targets of the package form a cycle
     * */
    pub fn orderedTargets(self, cfg: GyllirPackageConfiguration, targets: [[c8] => Target])-> [Target]
        throws AssertError, RecursiveDependency
    {
        self.validateTargets(cfg, targets);

        let dmut done: [[c8] => ()] = copy [];
        let mut res: [Target] = [];
        let mut remaining = self.sortedNames(targets);

        while remaining.len > 0us {
            let mut blocked: [[c8]] = [];
            for name in remaining if let Ok(t) = targets[name] {
                let mut ready = true;
                for d in t.targets if d !in done {
                    ready = false;
                }

                if (ready) {
                    res ~= [t];
                    done[name] = ();
                } else {
                    blocked ~= [name];
                }
            }

            // nothing could be built in a whole pass, every target left waits for another one
            if (blocked.len == remaining.len) {
                throw copy RecursiveDependency("targets of '" ~ cfg.name ~ "', " ~ self.quotedNames(blocked));
            }

            remaining = blocked;
        }

        res
    }

    /**
     * Check that every name a target refers to is declared by the package
     * @throws:
     *    - AssertError: on the first name that is not
     * */
    prv fn validateTargets(self, cfg: GyllirPackageConfiguration, targets: [[c8] => Target])
        throws AssertError
    {
        let dependencies = cfg.dependencies[];
        for name, t in targets {
            for d in t.targets {
                if (d == name) {
                    throw copy AssertError("target '" ~ name ~ "' links itself");
                }

                if (d !in targets) {
                    throw copy AssertError("target '" ~ name ~ "' links the unknown target '" ~ d ~ "'");
                }
            }

            // 'dependencies' selects among the '[dependencies.*]' of the package, it never declares one
            for d in t.dependencies if d !in dependencies {
                throw copy AssertError("target '" ~ name ~ "' selects the unknown dependency '" ~ d ~ "'");
            }
        }
    }

    /**
     * The transitive closure of the targets linked by a set of targets
     * @params:
     *    - targets: every target of the package
     *    - selected: the names of the targets to start from
     * @returns: the names of the targets that have to be built as artifacts for 'selected' to link
     * */
    prv fn linkedTargets(self, targets: [[c8] => Target], selected: [[c8] => ()])-> [[c8] => ()] {
        let dmut res: [[c8] => ()] = copy [];
        let mut front: [[c8]] = [];
        for k, _ in selected {
            if let Ok(t) = targets[k] {
                front ~= t.targets;
            }
        }

        while front.len > 0us {
            let mut next: [[c8]] = [];
            for name in front if name !in res {
                res[name] = ();
                if let Ok(t) = targets[name] {
                    next ~= t.targets;
                }
            }

            front = next;
        }

        res
    }

    /**
     * The artifacts of the targets of the same package a target links
     * @params:
     *    - t: the target about to be built
     *    - includes: the root files produced by the targets already built, by target name
     *    - links: the archives produced by the targets already built, by target name
     * */
    prv fn gatherTargetArtifacts(self, t: Target, includes: [[c8] => [Path]], links: [[c8] => [Path]])-> ([Path], [Path]) {
        let mut resIncludes: [Path] = [];
        let mut resLinks: [Path] = [];
        for d in t.targets {
            if let Ok(i) = includes[d] { resIncludes ~= i; }
            if let Ok(l) = links[d] { resLinks ~= l; }
        }

        (self.uniquePaths(resIncludes), self.uniquePaths(resLinks))
    }

    /**
     * @returns: 'paths', keeping the first occurrence of each
     * @info: a diamond between two targets, or between two dependencies, otherwise puts the same
     *   archive on the link line twice, which the linker rejects with a 'multiple definition' error
     * */
    pub fn uniquePaths(self, paths: [Path])-> [Path] {
        let dmut seen: [[c8] => ()] = copy [];
        let mut res: [Path] = [];
        for p in paths {
            let key = p.toStr();
            if (key !in seen) {
                seen[key] = ();
                res ~= [p];
            }
        }

        res
    }

    /**
     * The target to run, and the arguments to forward to it.
     * 'gyllir run' forwards its raw arguments to the executable it runs, so a first argument naming a
     * declared target selects that target, and a first argument that is '--' forwards everything that
     * follows without looking at it
     * @throws:
     *    - AssertError: if the package declares several targets and none was named
     * */
    pub fn selectRunTarget(self, cfg: GyllirPackageConfiguration, args: &Config)-> (Target, &Config)
        throws AssertError
    {
        let targets = cfg.targets();
        let mut values: [[c8]] = [];
        if let a: &Array = args {
            for i in a[] if let Str(value-> v) = i {
                values ~= [v];
            }
        }

        let mut name = "";
        let mut start = 0us;
        if (values.len > 0us) {
            if (values[0] == "--") {
                start = 1us;
            } else if (values[0] in targets) {
                name = values[0];
                start = 1us;
            }
        }

        let dmut forwarded = copy Array();
        for v in values[start .. $] {
            forwarded:.push(copy Str(v));
        }

        let names = self.sortedNames(targets);
        if (name == "") {
            if (names.len != 1us) {
                throw copy AssertError("'gyllir run' needs the name of a target, " ~ self.targetNames(targets));
            }

            name = names[0];
        }

        if let Ok(t) = targets[name] {
            return (t, forwarded);
        }

        throw copy AssertError("unknown target '" ~ name ~ "', " ~ self.targetNames(targets));
    }

    /**
     * @returns: the names of 'targets', in alphabetical order, so that the build order of two targets
     *    that do not link each other does not depend on the iteration order of a map
     * */
    prv fn sortedNames(self, targets: [[c8] => Target])-> [[c8]] {
        let names: [[c8]] = copy [k for k, _ in targets];
        let mut res: [mut [c8]] = copy names;
        sorting::sort(alias res, |x, y| {
            let mut i = 0us;
            let mut lower = x.len < y.len;
            while i < x.len && i < y.len {
                if (x[i] != y[i]) {
                    lower = x[i] < y[i];
                    break;
                }

                i += 1us;
            }

            lower
        });

        res
    }

    /**
     * @returns: the declared targets, for an error message
     * */
    prv fn targetNames(self, targets: [[c8] => Target])-> [c8] {
        "declared targets are " ~ self.quotedNames(self.sortedNames(targets))
    }

    /**
     * @returns: 'names', quoted and comma separated
     * */
    prv fn quotedNames(self, names: [[c8]])-> [c8] {
        let dmut stream = copy StringStream();
        let mut first = true;
        for n in names {
            if (!first) { stream:.write(", "s8); }
            stream:.write("'"s8):.write(n):.write("'"s8);
            first = false;
        }

        stream[]
    }

    /**
     * Narrow the library targets of a dependency down to the ones it selects
     * @params:
     *    - name: the name of the dependency, for error reporting
     *    - dependency: the dependency declaration, carrying the optional 'link-targets' selection
     *    - targets: every target the dependency package declares, by name
     *    - libTargets: the non-executable ones among them, by name
     * @returns: 'libTargets' narrowed down to 'dependency's selection, or 'libTargets' unchanged
     *    when it selects none in particular (absent 'link-targets' links every one of them)
     * @throws:
     *    - AssertError: 'dependency' selects a target the package does not declare, or one that is
     *      not a library
     * */
    pub fn selectDependencyTargets(self, name: [c8], dependency: Dependency, targets: [[c8] => Target], libTargets: [[c8] => ()])-> [[c8] => ()]
        throws AssertError
    {
        if (dependency.targets.len == 0us) { return libTargets; }

        let dmut res: [[c8] => ()] = copy [];
        for t in dependency.targets {
            if (t !in libTargets) {
                if (t in targets) {
                    throw copy AssertError("dependency '" ~ name ~ "' links target '" ~ t ~ "', which is not a library");
                }

                throw copy AssertError("dependency '" ~ name ~ "' links the unknown target '" ~ t ~ "', " ~ self.targetNames(targets));
            }

            res[t] = ();
        }

        res
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          DEPENDENCIES          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Resolve a dependency, and build it
     * @params:
     *    - args: the configuration of the current building
     *    - name: the name of the dependency to build
     *    - dependency: the information about the dependency to build
     * @returns:
     *    - .0: the list of path to the root files of libraries to include
     *    - .1: the list of path to the built libraries to link
     */
    pub fn resolveDependency(mut self, args: &Config, cwd: Path, name: [c8], dependency: Dependency, dry: bool)-> ([Path], [Path])
        throws RecursiveDependency
    {
        if (dependency.url in self._depPackages) {
            throw copy RecursiveDependency(name ~ ":"s8 ~ dependency.url.path.toStr());
        }

        let depPath = cwd.push(defaults::__DEPENCY_DIR__).push(name);
        {
            utils::log::info("Resolving", "dependency ", name, " to ", depPath.toStr());
            let gM = GitManager(cwd-> depPath);
            let hasCloned = if (dependency.url.type == UrlType::LOCAL) {
                if !isDir(depPath.parent()) {
                    fs::sys::createDir(depPath.parent(), recursive-> true);
                }

                if isLink(depPath) {
                    removeFsEntry(depPath);
                }

                self.runProcess("ln"s8, copy ["-s"s8, dependency.url.path.toStr(), depPath.toStr()]);
                utils::log::info("Fetched", "local dependency ", name);
                false
            }

            else if !isDir(depPath) {
                gM.clone(dependency.url.path.toStr());
                true
            } else {
                false
            };

            self:.selectDependencyVersion(gM, dependency, name-> name);
            let conf = self.loadToml(depPath);

            // only the library targets of a dependency are of any use here, an executable it also
            // declares is never linked into the package that depends on it
            let dmut libTargets: [[c8] => ()] = copy [];
            for k, t in conf.targets() if !t.type.isExecutable() {
                libTargets[k] = ();
            }

            if (libTargets.len == 0us) {
                utils::log::error("Resolving", "dependency '", name, "' at '", dependency.url.path.toStr(),
                                  "' declares no library target, only a library can be linked into a package");
                etc::c::process::_yrt_exit(-1);
                panic;
            }

            let selectedTargets = self.selectDependencyTargets(name, dependency, conf.targets(), libTargets);

            self._depPackages[dependency.url] = ();
            if (hasCloned) {
                RepoCleaner(depPath, args, conf).run(alias self);
            }

            let (_, ext, lbs) = self:.buildTargets(depPath, args, conf, selectedTargets, dry-> dry);

            self._depPackages:.remove(dependency.url);
            (ext, lbs)
        } catch {
            // git said no: report what it actually refused to do. A failure here is a clone that
            // never happened, a directory that is no git repository, or a version that could not
            // be checked out, and telling the user the wrong one of the three sends them looking
            // in the wrong place
            g: &GitError => {
                let versions = {
                    self.toVersionList(GitManager(cwd-> depPath).getTagList())
                } catch { _ => [] };

                if (versions.len != 0us) {
                    utils::log::error("Resolving", "dependency '", name, "' could not be checked out at ",
                                      dependency.version, ": ", utils::errors::singleLine(g.msg));
                    utils::log::info("", "available versions are: ", copy [c._0[] for c in versions]);
                }

                else if (dependency.url.type == UrlType::LOCAL) {
                    utils::log::error("Resolving", "dependency '", name, "' at '", dependency.url.path.toStr(),
                                      "' is not a usable git repository: ", utils::errors::singleLine(g.msg));
                    utils::log::info("", "a local dependency is checked out at the version matching ",
                                     dependency.version, ", so it has to be a git repository");
                }

                else {
                    utils::log::error("Resolving", "dependency '", name, "' could not be fetched from '",
                                      dependency.url.path.toStr(), "': ", utils::errors::singleLine(g.msg));
                }

                etc::c::process::_yrt_exit(-1);
                panic;
            }

            r: &RecursiveDependency => {
                throw copy RecursiveDependency(name ~ ":"s8 ~ dependency.url.path.toStr(), subError-> (r)?);
            }
            // every message thrown from here already names the dependency it comes from
            a: &AssertError => {
                utils::log::error("Resolving", a.msg);
                etc::c::process::_yrt_exit(-1);
                panic;
            }
            x => {
                utils::log::error("Resolving", "dependency '", name, "' could not be resolved: ", x);
                etc::c::process::_yrt_exit(-1);
                panic;
            }
        }
    }

    /**
     * Select the version in the git repository
     * @params:
     *    - gM: the git repository of the dependency
     *    - dependency: the declaration of the dependency
     *    - name: the name of the dependency, for error reporting
     * */
    fn selectDependencyVersion(mut self, gM: GitManager, dependency: Dependency, name: [c8] = "")
        throws GitError, FsError, AssertError
    {
        // No need to fetch or swith if current branch pass the dependency version filter
        let currentBranch = gM.getCurrentBranchName();
        if currentBranch.len > 0 && currentBranch[0] != '(' {
            if dependency.version.pass(Version(currentBranch)) return;
        }

        gM.fetchTags();
        let version = dependency.version.select(self.toVersionList(gM.getTagList()), name-> name);
        if (version._0).isIgnore() {
            gM.checkout(version._1);
            if (dependency.url.type == UrlType::GIT) {
                gM.pull(version._1);
            }
        }
    }

    /**
     * Clear a dependency target
     * @params:
     *    - args: the configuration of the current building
     *    - name: the name of the dependency to clean
     *    - dependency: the information about the dependency to clean
     * */
    pub fn cleanDependency(mut self, args: &Config, cwd: Path, name: [c8], dependency: Dependency)
        throws RecursiveDependency
    {
        if (dependency.url in self._depPackages) {
            throw copy RecursiveDependency(name ~ ":"s8 ~ dependency.url.path.toStr());
        }

        let depPath = cwd.push(defaults::__DEPENCY_DIR__).push(name);
        utils::log::info("Cleaning", "dependency ", name, " to ", depPath.toStr());
        if (dependency.url.type == UrlType::LOCAL) {
            {
                self._depPackages[dependency.url] = ();
                let conf = self.loadToml(depPath);
                RepoCleaner(depPath, args, conf).run(alias self);
                self._depPackages:.remove(dependency.url);
            } catch {
                r: &RecursiveDependency => {
                    throw copy RecursiveDependency(name ~ ":"s8 ~ dependency.url.path.toStr(), subError-> (r)?);
                }
            }
        }
    }

    /**
     * Transform a list of tags(acquired with git) into a list of version
     */
    pub fn toVersionList(self, list: [c8])-> [(Version, [c8])] {
        let dmut tzer = Tokenizer!c8();
        tzer:.insert("\n", isSkip-> true);
        let res = tzer.tokenizeWithoutSkips(list);

        let mut versions: [(Version, [c8])] = [];
        for i in res {
            if (i.len > 0 && i[0] != '(') { // ignore(HEAD detached...)
                let mut add = true;
                for v in versions if i == v._1 {
                    add = false;
                    break;
                }

                if add {
                    versions = versions ~ [(Version(i), i)];
                }
            }
        }

        return versions;
    }

    /**
     * Run a sub process
     * */
    pub fn runProcess(self, cmd: [c8], params: [[c8]], cwd: Path = env::currentDir(), verbose: bool = false)-> bool {
        if (verbose) {
            let dmut stream = copy std::stream::StringStream();
            stream:.write(cmd);
            for o in params {
                stream:.write(" ");
                stream:.write(o);
            }
            utils::log::info("Run", stream[]);
        }

        let dmut subProc = copy SubProcess(cmd, params, cwd-> cwd);
        subProc:.start(redirect-> false);
        let code = subProc:.wait();
        code == 0
    } catch {
        _ => false
    }

    pub fn progressBar(self, nb: u32, all: u32) {
        let len = 50u32;
        let count = cast!u32(cast!f32(nb) / cast!f32(all) * cast!f32(len));
        let perc = cast!f32(nb) / cast!f32(all);


        // let buffer = copy [if i < count { '#' } else { ' ' } for i in 0 .. len];
        atomic {
            printf("\r\t%sProgress%s [".ptr, Colors::GREEN.ptr, Colors::RESET.ptr);
            for _ in 0 .. count {
                printf("█".ptr);
            }
            for _ in count .. len {
                printf(" ".ptr);
            }

            print("] ");
            print(std::format::format("{:.2}%", perc * 100.0f))?;
            fflush(stdout);
            if nb == all {
                println();
            }
        }
    }

    /**
     * Ask the user for a given value(command line read)
     * @params:
     *   - ask: the text to write as a question
     *   - default: the default value to return if the user did write nothing
     */
    pub fn askUserFor(self, ask: [c8], default: [c8] = "")-> [c8] {
        let x = if (default == "") {
            std::io::read![c8] (ask-> (ask ~ " :"))
        } else {
            std::io::read![c8] (ask-> (ask ~ " [" ~ default ~ "]:"))
        };

        if x == "" {
            default
        } else x
    }

    /**
     * Ask the user for a yes no question
     * @params:
     *   - ask: the text to write as a question
     *   - default: the default value to return if the user did write nothing
     */
    pub fn askUserYesNo(self, ask: [c8], default: [c8] = "")-> bool {
        let res = self.askUserFor(ask ~ "(y/n)", default-> default);
        if (res.len == 1 && std::char::toUpper(res[0]) == 'Y') return true;

        false
    }

}
