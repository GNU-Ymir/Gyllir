in runner;

use gyllir::args;
use gyllir::config::_;

use std::{config, env, io, stream};
use std::concurrency;
use std::fs;

pub record RepoRunner {

    // The current working directory
    let _cwd: Path;

    // The command line options
    let _args: &Config;

    // The package configuration
    let _cfg: GyllirPackageConfiguration;

    // The target whose artifact is executed
    let _target: Target;

    // True iif the runner is configured to run unittests
    let _forUnitTest: bool;

    // The variables to set in the environment of the executed artifact
    let _env: [([c8], [c8])];

    /**
     * @params:
     *    - cfg: the configuration of the repo
     *    - target: the target whose artifact is executed
     *    - env: the variables to set in the environment of the artifact, on top of the inherited ones
     * */
    pub self (path: Path, args: &Config, cfg: GyllirPackageConfiguration, target: Target, forUnitTest: bool, env: [([c8], [c8])] = [])
        with _cwd = path
        , _args = args
        , _cfg = cfg
        , _target = target
        , _forUnitTest = forUnitTest
        , _env = env
    {}

    /**
     * Run the build executable
     * @returns: the exit code of the executed artifact, '128 + <signal>' when a signal killed it (as
     *    'SubProcess::wait' reports it)
     * @info: the caller is the one exiting, so that 'gyllir test' can run the tests of every target
     *   before failing on the first one that did not pass
     * */
    pub fn run(self)-> i32
        throws AssertError, FsError
    {
        let output = self._target.outputName();
        if (self._forUnitTest) {
            utils::log::info("Executing", "tests ", output, " v", self._cfg.version[]);
            std::io::println("\n");
            std::io::flush();
            let (cmd, options) = self.withEnv("./" ~ output ~ ".test", testRunnerArguments(self._args));
            let dmut subProc   = copy SubProcess(cmd, options, cwd-> self._cwd);
            subProc:.start(redirect-> false);

            subProc:.wait()
        } else {
            if !self._target.type.isExecutable() {
                throw copy AssertError("target '" ~ self._target.name
                                       ~ "' is a library, 'gyllir run' only runs an executable target");
            }

            let mut options: [[c8]] = [];
            if let a: &Array = self._args {
                for i in a[] if let Str(value-> v) = i {
                    options ~= [v];
                }
            }

            utils::log::info("Executing", "project ", output, " v", self._cfg.version[]);
            std::io::println("\n");
            std::io::flush();
            let dmut subProc = copy SubProcess("./" ~ output, options, cwd-> self._cwd);
            subProc:.start(redirect-> false);

            subProc:.wait()
        }
    }

    /**
     * The command line executing an artifact in the environment of the runner
     * @params:
     *    - cmd: the artifact
     *    - options: its arguments
     * @returns: the command and its arguments, run through 'env' when there are variables to set
     * */
    prv fn withEnv(self, cmd: [c8], options: [[c8]])-> ([c8], [[c8]]) {
        if (self._env.len == 0us) { return (cmd, options); }

        let mut res: [[c8]] = [];
        for v in self._env {
            res ~= [v._0 ~ "=" ~ v._1];
        }

        ("env", res ~ [cmd] ~ options)
    }
}
