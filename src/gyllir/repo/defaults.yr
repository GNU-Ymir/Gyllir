in defaults;

use std::fs::path;

/**
 * The filename of the configuration
 */
pub def __GYLLIR_CONFIG_FILENAME__ = "gyllir.toml";

/**
 * The filename of the machine local configuration, read on top of '__GYLLIR_CONFIG_FILENAME__'
 * when it exists(see 'gyllir::config::overlay'), and never tracked
 */
pub def __GYLLIR_OVERRIDE_FILENAME__ = "gyllir.toml.override";

/**
 * The filename of the dependency lock file
 */
pub def __GYLLIR_LOCK_FILENAME__ = "gyllir.lock";

/**
 * The filename of the gitignore file
 */
pub def __GITIGNORE_FILENAME__ = ".gitignore";

/**
 * The name of the initial file
 */
pub def __MAIN_FILE__     = "main.yr";
pub def __LIB_FILE__      = "__lib__.yr";
pub def __FST_TEST_FILE__ = "__test__.yr";

/**
 * The content of the initial file
 */
pub def __MAIN_CONTENT__ = str #{use std::io;

fn main() {
    println("Hello World!");
}
};

pub def __LIB_CONTENT__ = str #{use std::io;

pub fn foo() {
    println("Hello from lib");
}
};

pub def __FST_TEST_CONTENT__ = str #{use std::io;

__test {
    println("Example of first test");

    // To make a test fail, throw an exception
    // for example, assert(false);
}
};

/**
 * The content of the gitignore file
 * @info: every generated file is named explicitly, rather than covered by a blanket '.*': git
 *   refuses to re-include a file whose parent directory is excluded, so ignoring every dot entry
 *   would take '.github/', '.vscode/' and the like with it, with no negation able to bring them
 *   back
 */
pub def __GITIGNORE_CONTENT__ = str #{
# Machine local configuration
gyllir.toml.override

# Dependencies resolved by gyllir
.deps/

# Build cache and generated documentation
.target/
__doc/

# Left behind by a test run
.ymir_test_success
.ymir_coverage_*
.ymir_coverage.json

# Produced artifacts
};

/**
 * The source directory name
 */
pub def __SRC_DIR__ = "src";

pub def __DEBUG_DIR__    = "debug";
pub def __RELEASE_DIR__  = "release";
pub def __LIB_DIR__      = "__libs";
pub def __TEST_DIR__     = "test";
pub def __DOC_DIR__      = "__doc";
pub def __COVERAGE_DIR__ = "__coverage";
pub def __YIL_DIR__      = "yils";
pub def __DEPENCY_DIR__  = ".deps";

/**
 * The name under which a resolved std lib(midgard) is cloned into '__DEPENCY_DIR__', when it is
 * not the one bundled with the compiler
 */
pub def __STD_DEP_NAME__ = "std";

/**
 * The name of the link, in '__DEPENCY_DIR__', to the installation of the gyc pinned by a
 * '[compiler]' table, in the gyllir cache
 */
pub def __COMPILER_DEP_NAME__ = "compiler";

/**
 * The environment variable naming the gyllir cache directory, '~/.local/gyllir' when it is unset
 */
pub def __CACHE_ENV_VAR__ = "GYLLIR_CACHE_DIR";

/**
 * The file of the gyllir cache listing what was installed in it
 */
pub def __CACHE_INDEX_FILENAME__ = "cache.toml";

/**
 * The sub directory of the gyllir cache holding one installation of gyc per release
 */
pub def __CACHE_COMPILER_DIR__ = "compiler";

/**
 * The environment variable naming where the releases of gyc are downloaded from, in place of
 * '__GYC_RELEASE_URL__'
 */
pub def __GYC_RELEASE_ENV_VAR__ = "GYLLIR_GYC_RELEASE_URL";

/**
 * Where the releases of gyc are downloaded from, as '<url>/<version>/<asset>'
 */
pub def __GYC_RELEASE_URL__ = "https://github.com/GNU-Ymir/gymir/releases/download";

/**
 * The target a gyc release is built for, and the architecture of its .deb
 */
pub def __GYC_TRIPLE__ = "x86_64-linux-gnu";
pub def __GYC_ARCH__   = "amd64";

/**
 * The driver of gyc, relative to the directory a release was installed into
 */
pub def __GYC_BINARY__ = "usr/bin/gyc";

/**
 * The prefix of the system gcc installation, whose pieces(collect2, the crt files, the lto
 * plugin...) a gyc release relies on without shipping them
 */
pub def __SYSTEM_GCC_PREFIX__ = "/usr";

/**
 * @returns: the gyllir cache directory, holding what gyllir installs for every package of the
 *    machine: '$GYLLIR_CACHE_DIR', or '~/.local/gyllir'
 * */
pub fn gyllirCacheDir()-> Path {
    let dir = unsafe { std::env::getVar(__CACHE_ENV_VAR__) };
    if (dir != "") { return Path(dir); }

    Path(unsafe { std::env::getVar("HOME") }).push(".local").push("gyllir")
}

/**
 * @params:
 *    - gccMajor: the major version of the gcc the release is built with
 *    - version: the release of gyc
 * @returns: the name of the .deb of a release of gyc
 * */
pub fn gycAsset(gccMajor: [c8], version: [c8])-> [c8] {
    "gyc-" ~ gccMajor ~ "_" ~ version ~ "_" ~ __GYC_ARCH__ ~ ".deb"
}

/**
 * The file at the root of a std lib(midgard) checkout declaring the 'YMIR_BOOTSTRAP_VERSION' it
 * was built against, used to warn when a resolved std lib was bootstrapped with a different Ymir
 * compiler than the one that is actually going to build it
 */
pub def __YMIR_VERSION_FILENAME__ = "YMIR_VERSION";

/**
 * The scratch directory, under '__DEPENCY_DIR__', a blobless partial clone of the std lib remote
 * is checked out into while ranking its tags by Ymir-compatibility - torn down once that ranking
 * is done, never left behind as part of the resolved dependency tree
 */
pub def __STD_PROBE_DIR__ = ".std-probe";

/**
 * The coverage files a unittest executable writes into the directory it runs in(the root of the
 * package): one per process ('<prefix><pid><suffix>'), listing the functions the process entered,
 * and, when it printed a coverage report ('-cov'), the merged report it printed, which also lists
 * the functions no test entered
 * @info: named by midgard's test runtime ('test-rt/utils/coverage/store.yr')
 */
pub def __COVERAGE_REPORT_FILE__ = ".ymir_coverage.json";
pub def __COVERAGE_PID_PREFIX__  = ".ymir_coverage_";
pub def __COVERAGE_PID_SUFFIX__  = ".json";

/**
 * The machine readable summary written next to the coverage pages(see 'repo::coverage')
 */
pub def __COVERAGE_SUMMARY_FILE__ = "coverage.json";

/**
 * The build cache of a package, holding one sub directory per target
 * @info: '__CACHE_TMP_DIR__' is the only one shared by every target, gyllir builds the targets of
 *   a package one after the other, so they never write it at the same time
 */
pub def __CACHE_ALL_DIR__ = ".target/";
pub def __CACHE_TMP_DIR__ = ".target/tmp";

/**
 * The sub directories of '.target/<target>/', one per kind of build
 */
pub def __CACHE_RELEASE_DIR__      = "release";
pub def __CACHE_DEBUG_DIR__        = "debug";
pub def __CACHE_UNIT_DEBUG_DIR__   = "unit_debug";
pub def __CACHE_UNIT_RELEASE_DIR__ = "unit_release";
pub def __CACHE_DOC_DIR__          = "doc";
pub def __CACHE_TEST_DIR__         = "test";

/**
 * The build cache of a target
 * @params:
 *    - cwd: the root directory of the package the target belongs to
 *    - target: the name of the target
 *    - kind: the kind of build, one of the '__CACHE_*_DIR__' sub directories
 * @returns: '<cwd>/.target/<target>/<kind>'
 * */
pub fn targetCacheDir(cwd: Path, target: [c8], kind: [c8])-> Path {
    cwd.push(__CACHE_ALL_DIR__).push(target).push(kind)
}

pub def __YMIR_EXTENSION__     = "yr";
pub def __OBJECT_EXTENSION__   = "o";
pub def __YIL_EXTENSION__      = "yil";
pub def __DEPS_EXTENSION__     = "deps";
pub def __SYM_LIST_EXTENSION__ = "syms";
pub def __DOC_EXTENSION__      = "doc.json";
pub def __MARKDOWN_EXTENSION__ = "md";
pub def __LIBRARY_EXTENSION__  = "a";
pub def __HTML_EXTENSION__     = "html";
pub def __C_EXTENSION__        = "c";

/**
 * The sub directory of a target's build cache holding the object files compiled from its
 * 'c-sources'
 */
pub def __CACHE_C_DIR__ = "c-objs";

/**
 * The archiver invoked to add the object files compiled from a target's 'c-sources' into its
 * produced static library
 */
pub def __AR_COMMAND__ = "ar";
