in errors;

use std::{config::_, stream};

/*!
 * Every error raised while reading a gyllir.toml is an 'AssertError' whose message is written for
 * the user: 'GyllirManager::loadToml' prints that message, prefixed by the path of the
 * configuration file, and nothing else. Such a message therefore names the entry at fault, says
 * what was expected of it, and shows what a correct one looks like:
 *
 *     missing required entry 'name', for example: name = "my-package"
 *     '[dependencies.foo]', 'version' is invalid: ">x" is not a version filter, ...
 *
 * An error carrying no message('CastFailure' and friends) is never thrown by those parsers: it
 * would reach the user as a class name and a stack trace into the configuration parser, which
 * says nothing about what has to be fixed.
 * */

/**
 * @params:
 *    - table: the name of a table of the configuration file('dependencies', 'targets', ...)
 *    - name: the name of one of its entries
 * @returns: the prefix naming the '[<table>.<name>]' table an error message comes from
 * */
pub fn inTable(table: [c8], name: [c8])-> [c8] {
    "'[" ~ table ~ "." ~ name ~ "]', "
}

/**
 * Reject any entry of 'd' that is not one of 'known': a field that is neither read nor rejected
 * is silently ignored, which lets a typo or a stray entry pass without warning.
 *
 * 'known' is a template variadic rather than a '[[c8]]' slice so that the usual call, a handful
 * of string literals, allocates nothing.
 *
 * @params:
 *    - d: the table to check
 *    - ctx: the prefix naming the table an error message comes from, for example the result of
 *      'inTable', or "" for the top level table of the configuration file
 *    - known: the entries 'd' is allowed to declare
 * @throws:
 *    - AssertError: on the first entry of 'd' that is not in 'known'
 * */
pub fn rejectUnknown {T...} (d: &Dict, ctx: [c8], known: T)
    throws AssertError
{
    for k, _ in d[] {
        let mut found = false;

        cte if (T,)::arity > 1 {
            for n in (expand known,) {
                if (k == n) { found = true; }
            }
        } else {
            found = (k == known);
        }

        if (!found) {
            throw copy AssertError(ctx ~ "'" ~ k ~ "' is not a known entry");
        }
    }
}

/**
 * Error thrown when a recursive dependency is detected between two gyllir packages
 * */
@final
pub class RecursiveDependency over Exception {
    pub let msg: [c8];
    pub let sub: (&Exception)?;

    pub self (msg: [c8], subError: (&Exception)? = none)
        with msg = msg
        , sub = subError
    {}

    impl Streamable {
        pub over toStream(self, dmut stream: &StringStream) {
            stream:.write("Recursive dependencies: ", self.msg);
            if let Ok(sub) = self.sub {
                stream:.writeln(""):.write(" => "s8):.write("\t"s8):.write(sub);
            }
        }
    }
}
