in command;

use std::{config, stream};
use std::algorithm::sorting;
use std::fs;

/**
 * A custom command to run, made of one or several command lines run one after the other
 * */
pub record Command {
    // The command lines to run, in order, as written(placeholders unresolved)
    let _cmds: [[c8]];

    // True iif 'cmd' was declared as an array, kept to be written back the same way
    let _isList: bool;

    // True iif the command is a post command
    let _isPost: bool;

    // The path location of the command
    let _cwd: Path;

    /**
     * @params:
     *    - cmd: the command line to run
     *    - post: true iif the command is executed after the generation
     *    - cwd: the location of the command execution
     * */
    pub self (cmd: [c8], post: bool, cwd: Path = Path("."))
        with _cmds = copy [cmd]
        , _isList = false
        , _isPost = post
        , _cwd = cwd
    {}

    /**
     * @params:
     *    - cmds: the command lines to run, in order
     *    - post: true iif the command is executed after the generation
     *    - cwd: the location of the command execution
     * */
    pub self list (cmds: [[c8]], post: bool, cwd: Path = Path("."))
        with _cmds = cmds
        , _isList = true
        , _isPost = post
        , _cwd = cwd
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the command lines to run, in order, as written
     * */
    @field
    pub fn cmds(self)-> [[c8]] {
        self._cmds
    }

    /**
     * @returns: true iif 'cmd' was declared as an array of command lines rather than a single one
     * */
    pub fn isList(self)-> bool {
        self._isList
    }

    pub fn isPost(self)-> bool {
        self._isPost
    }

    @field
    pub fn cwd(self)-> Path {
        self._cwd
    }
}

/**
 * A command list, the '[<table>.<name>]' tables of a gyllir.toml: the '[commands]' run around a
 * build, or the '[install]' run by 'gyllir install'
 * */
pub class CustomCommandList {

    // The list of command in the list
    let dmut _lst: [[c8] => Command] = copy [];

    // The table the commands are declared in, for error reporting
    let _table: [c8] = "commands";

    // False iif the commands of the table have no 'post' entry: the '[install]' commands run once
    // the package is built, there is no before and after to choose from
    let _withPost: bool = true;

    /**
     * Create an empty command list
     * */
    pub self () {}

    /**
     * Create a command list from a configuration
     * @params:
     *    - cfg: the content of the table
     *    - table: the name of the table, for error reporting
     *    - withPost: false to refuse a 'post' entry in the commands of the table
     * */
    pub self (cfg: &Config, table: [c8] = "commands", withPost: bool = true)
        with _table = table
        , _withPost = withPost
        throws AssertError
    {
        if let d: &Dict = cfg {
            self:.insert(d);
        } else throw copy AssertError("'" ~ table ~ "' must be a table, one '[" ~ table ~ ".<name>]' entry per command");
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the list of command
     * */
    pub fn opIndex(self)-> [[c8] => Command] {
        self._lst
    }

    /**
     * @returns: the commands, by name, in the alphabetical order of their names: the order of the
     *    tables of a gyllir.toml is not kept, so this is the order commands that have to run one
     *    after the other are run in
     * */
    pub fn sorted(self)-> [([c8], Command)] {
        let names: [[c8]]       = copy [k for k, _ in self._lst];
        let mut res: [mut [c8]] = copy names;
        sorting::sort(alias res, |x, y| {
            let mut i     = 0us;
            let mut lower = x.len < y.len;
            while i < x.len && i < y.len {
                if (x[i] != y[i]) {
                    lower = x[i] < y[i];
                    break;
                }

                i += 1us;
            }

            lower
        });

        let mut out: [([c8], Command)] = [];
        for n in res if let Ok(c) = self._lst[n] {
            out ~= [(n, c)];
        }

        out
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Insert commands a dictionnary configuration
     * @throws:
     *    - AssertError: on the first entry that is missing, or that does not have the expected
     *      shape. Its message names the command it comes from
     * */
    prv fn insert(mut self, cfg: &Dict)
        throws AssertError
    {
        for k, v in cfg[] {
            let ctx = gyllir::config::errors::inTable(self._table, k);

            let (cmds, isList) = self.readCmd(v, ctx, k);

            // a mistyped 'post' used to be read as a pre build command, silently running it at the
            // wrong moment, which is worse than refusing the configuration. In a table that has no
            // 'post', it is refused as any unknown entry, by 'rejectUnknown' below
            let post = if (!self._withPost) {
                false
            } else if let Ok(Bool(value-> p)) = v["post"]? {
                p
            } else if let Ok(Str(value-> p)) = v["post"]? {
                if (p != "true" && p != "false") {
                    throw copy AssertError(ctx ~ "'post' must be a boolean, either true or false");
                }

                p == "true"
            } else if let Ok(_) = v["post"]? {
                throw copy AssertError(ctx ~ "'post' must be a boolean, either true or false");
            } else { false };

            let cwd = if let Ok(Str(value-> c)) = v["cwd"]? {
                Path(c)
            } else if let Ok(_) = v["cwd"]? {
                throw copy AssertError(ctx ~ "'cwd' must be a string, the directory the command is run from");
            } else { Path(".") };

            if let vd: &Dict = v {
                if (self._withPost) {
                    gyllir::config::errors::rejectUnknown(vd, ctx, "cmd", "post", "cwd");
                } else {
                    gyllir::config::errors::rejectUnknown(vd, ctx, "cmd", "cwd");
                }
            }

            if (isList) {
                self._lst[k] = Command::list(cmds, post, cwd-> cwd);
            } else {
                self._lst[k] = Command(cmds[0], post, cwd-> cwd);
            }
        }
    }

    /**
     * Read the 'cmd' entry of a command table, either a single command line or an array of them
     * @params:
     *    - v: the content of the command table
     *    - ctx: the prefix naming the command, for error reporting
     *    - name: the name of the command, for the example of the error message
     * @returns:
     *    - .0: the command lines, in the declared order
     *    - .1: true iif they were declared as an array
     * @throws:
     *    - AssertError: 'cmd' is missing, is neither a string nor an array of strings, or is an empty
     *      array, which would make a command that does nothing
     * */
    prv fn readCmd(self, v: &Config, ctx: [c8], name: [c8])-> ([[c8]], bool)
        throws AssertError
    {
        let shape = "'cmd' must be a string, the command line to run, or an array of strings, the command lines to "
            ~ "run in order";

        if let Ok(Str(value-> c)) = v["cmd"]? {
            return (copy [c], false);
        } else if let Ok(a: &Array) = v["cmd"]? {
            let mut res: [[c8]] = [];
            for i in a[] {
                if let Str(value-> c) = i {
                    res ~= [c];
                } else throw copy AssertError(ctx ~ shape);
            }

            if (res.len == 0us) {
                throw copy AssertError(ctx ~ "'cmd' is an empty array, it must hold at least one command line");
            }

            return (res, true);
        } else if let Ok(_) = v["cmd"]? {
            throw copy AssertError(ctx ~ shape);
        }

        throw copy AssertError(ctx ~ "missing required entry 'cmd', for example: cmd = \"./tools/" ~ name ~ ".sh\"");
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          MISC          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Streamable;
    impl Serializable {

        pub over serialize(self)-> &Config {
            let dmut ret = copy Dict();
            for k, c in self._lst {
                let dmut cmd = copy Dict();
                // written back the way it was declared: a single command line stays a string, which
                // an older gyllir reading the file still understands
                if (c.isList()) {
                    cmd["cmd"] = copy Array(copy [copy Str(i) for i in c.cmds]);
                } else {
                    cmd["cmd"] = copy Str(c.cmds[0]);
                }
                if (self._withPost) {
                    cmd["post"] = copy Bool(c.isPost());
                }

                cmd["cwd"] = copy Str(c.cwd.toStr());

                ret[k] = cmd;
            }

            ret
        }
    }
}
