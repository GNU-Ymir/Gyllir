in command;

use std::{config::_, fs::path, config::conv};
use std::stream;

/**
 * A custom command line to run
 * */
pub record Command {
    // The command to run
    let _cmd: [c8];

    // True iif the command is a post command
    let _isPost: bool;

    // The path location of the command
    let _cwd: Path;

    /**
     * @params:
     *    - cmd: the command to run
     *    - post: true iif the command is executed after the generation
     *    - cwd: the location of the command execution
     * */
    pub self (cmd: [c8], post: bool, cwd: Path = Path("."))
        with _cmd = cmd
        , _isPost = post
        , _cwd = cwd
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    @field
    pub fn cmd(self)-> [c8] {
        self._cmd
    }

    pub fn isPost(self)-> bool {
        self._isPost
    }

    @field
    pub fn cwd(self)-> Path {
        self._cwd
    }
}

/**
 * A command list
 * */
pub class CustomCommandList {

    // The list of command in the list
    let dmut _lst: [[c8] => Command] = copy [];

    /**
     * Create an empty command list
     * */
    pub self () {}

    /**
     * Create a command list from a configuration
     * */
    pub self (cfg: &Config)
        throws AssertError
    {
        if let d: &Dict = cfg {
            self:.insert(d);
        } else throw copy AssertError("'commands' must be a table, one '[commands.<name>]' entry per command");
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the list of command
     * */
    pub fn opIndex(self)-> [[c8] => Command] {
        self._lst
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Insert commands a dictionnary configuration
     * @throws:
     *    - AssertError: on the first entry that is missing, or that does not have the expected
     *      shape. Its message names the command it comes from
     * */
    prv fn insert(mut self, cfg: &Dict)
        throws AssertError
    {
        for k, v in cfg[] {
            let ctx = gyllir::config::errors::inTable("commands", k);

            let cmd = if let Ok(Str(value-> c)) = v["cmd"]? {
                c
            } else if let Ok(_) = v["cmd"]? {
                throw copy AssertError(ctx ~ "'cmd' must be a string, the command line to run");
            } else {
                throw copy AssertError(ctx ~ "missing required entry 'cmd', for example: cmd = \"./tools/" ~ k ~ ".sh\"");
            };

            // a mistyped 'post' used to be read as a pre build command, silently running it at the
            // wrong moment, which is worse than refusing the configuration
            let post = if let Ok(Bool(value-> p)) = v["post"]? {
                p
            } else if let Ok(Str(value-> p)) = v["post"]? {
                if (p != "true" && p != "false") {
                    throw copy AssertError(ctx ~ "'post' must be a boolean, either true or false");
                }

                p == "true"
            } else if let Ok(_) = v["post"]? {
                throw copy AssertError(ctx ~ "'post' must be a boolean, either true or false");
            } else { false };

            let cwd = if let Ok(Str(value-> c)) = v["cwd"]? {
                Path(c)
            } else if let Ok(_) = v["cwd"]? {
                throw copy AssertError(ctx ~ "'cwd' must be a string, the directory the command is run from");
            } else { Path(".") };

            self._lst[k] = Command(cmd, post, cwd-> cwd);
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          MISC          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Streamable;
    impl Serializable {

        pub over serialize(self)-> &Config {
            let dmut ret = copy Dict();
            for k, c in self._lst {
                let dmut cmd = copy Dict();
                cmd["cmd"] = copy Str(c.cmd);
                cmd["post"] = copy Bool(c.isPost());
                cmd["cwd"] = copy Str(c.cwd.toStr());

                ret[k] = cmd;
            }

            ret
        }
    }

}
