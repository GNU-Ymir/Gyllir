in filter;

use std::{config::_, stream};
use std::syntax::tokenizer;

use gyllir::config::version;

enum FilterKind: u8
| SUP    = 1
| SUP_EQ = 2
| INF    = 3
| INF_EQ = 4
| EQ     = 5;

/**
 * A filter the check compatible version
 * */
pub record VersionFilter {

    let mut _filters: [mut(FilterKind, Version)] = [];

    /**
     * Construct a version from a string
     * @params:
     *    - filters: the declared filters
     *    - entry: the name of the configuration entry they were read from, for error reporting
     * */
    pub self (filters: [[c8]], entry: [c8] = "'version'")
        throws AssertError
    {
        self:.parseFilters(filters, entry);
    }

    /**
     * Deserialize a version number
     * @params:
     *    - cfg: the value of the entry declaring the filters
     *    - entry: the name of that entry, for error reporting
     */
    pub self (cfg: &Config, entry: [c8] = "'version'")
        throws AssertError
    {
        if let Str(value-> version) = cfg {
            self:.parseFilter(version, self.createTokenizer(), entry);
        }

        else if let a: &Array = cfg {
            self:.parseFilters(a[], entry);
        }

        else throw copy AssertError(entry ~ " must be a version filter, or an array of them, for example: version = \">=1.0.0\"");
    }

    /**
     * @returns: the version into a string
     */
    pub fn opIndex(self)-> [(FilterKind, Version)] {
        self._filters
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          FILTERING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Select a version that passes the filter
     * @params:
     *    - versions: the versions to choose from
     *    - name: the name of the dependency they were read from, for error reporting
     * @throws:
     *    - AssertError: when no version passes the filter. Its message lists the versions that were
     *      offered, the filter alone leaves the user guessing which ones actually exist
     * */
    pub fn select(self, versions: [(Version, [c8])], name: [c8] = "")-> (Version, [c8])
        throws AssertError
    {
        let dmut stream = copy StringStream();
        let mut hasBest = false;
        let mut best: (Version, [c8]) = (Version(0u32, 0u32, 0u32), "");

        for i, v in versions {
            let mut found = true;
            for f in self._filters {
                if !self.passFilter(f, v._0) {
                    found = false;
                    break;
                }
            }

            if found && (!hasBest || v._0 > best._0) {
                best = v;
                hasBest = true;
            }

            if (i != 0) stream:.write(", ");
            stream:.write(v._0);
        }

        if hasBest return best;

        let dmut msg = copy StringStream();
        if (name != "") {
            msg:.write("dependency '", name, "' has no version matching ", self);
        } else {
            msg:.write("no version matching ", self);
        }

        if (versions.len == 0us) {
            msg:.write(", it declares no version at all");
        } else {
            msg:.write(", available versions are [", stream[], "]");
        }

        throw copy AssertError(msg[]);
    }

    /**
     * Check wether a version pass the filter
     * */
    pub fn pass(self, version: Version)-> bool {
        for f in self._filters {
            if !self.passFilter(f, version) {
                return false;
            }
        }

        return true;
    }

    /**
     * Check wether the version passes the filter
     * */
    prv fn passFilter(self, filter: (FilterKind, Version), v: Version)-> bool {
        if (filter._1).isIgnore() { return true; }

        match (filter.0) {
            FilterKind::SUP => {
                return v > filter.1;
            }
            FilterKind::INF => {
                return v < filter.1;
            }
            FilterKind::INF_EQ => {
                return v <= filter.1;
            }
            FilterKind::SUP_EQ => {
                return v >= filter.1;
            }
            _ => {
                return filter._1 == v;
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          MISC          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Serialize a version filter
     * */
    prv fn serializeFilter(self, filter: (FilterKind, Version))-> &Config {
        let dmut stream = copy StringStream();
        if !(filter._1).isIgnore() {
            match filter._0 {
                FilterKind::SUP => { stream:.write('>'); }
                FilterKind::SUP_EQ => { stream:.write(">="); }
                FilterKind::INF => { stream:.write('<'); }
                FilterKind::INF_EQ => { stream:.write("<="); }
                FilterKind::EQ => { stream:.write("="); }
            }
        }

        stream:.write(filter._1);
        return copy Str(stream[]);
    }

    impl Hashable;
    impl Streamable {
        pub over toStream(self, dmut stream: &StringStream) {
            stream:.write('[');
            for i, f in self._filters {
                if i != 0 { stream:.write(", "); }
                if !(f._1).isIgnore() {
                    match f._0 {
                        FilterKind::SUP => { stream:.write('>'); }
                        FilterKind::SUP_EQ => { stream:.write(">="); }
                        FilterKind::INF => { stream:.write('<'); }
                        FilterKind::INF_EQ => { stream:.write("<="); }
                        FilterKind::EQ => { stream:.write("="); }
                    }
                }
                stream:.write(f._1);
            }
            stream:.write(']');
        }
    }


    impl Serializable {
        pub over serialize(self)-> &Config {
            if self._filters.len == 1 {
                return self.serializeFilter(self._filters[0]);
            }

            let dmut result = copy Array();
            for i in self._filters {
                result:.push(self.serializeFilter(i));
            }

            result
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Create a tokenizer to split version filters
     * */
    prv fn createTokenizer(self)-> Tokenizer!{c8} {
        let mut tzer = Tokenizer!{c8} ();
        tzer:.insert("<");
        tzer:.insert(">");
        tzer:.insert(">=");
        tzer:.insert("<=");
        tzer:.insert(" ", isSkip-> true);

        tzer
    }

    /**
     * Parse version from string literals
     * */
    prv fn parseFilters(mut self, version: [[c8]], entry: [c8])
        throws AssertError
    {
        let tzer = self.createTokenizer();
        for v in version {
            self:.parseFilter(v, tzer, entry);
        }
    }

    /**
     * Parse version filters from string configs
     * */
    prv fn parseFilters(mut self, version: [&Config], entry: [c8])
        throws AssertError
    {
        let tzer = self.createTokenizer();
        for v in version {
            if let Str(value-> ve) = v {
                self:.parseFilter(ve, tzer, entry);
            }

            else throw copy AssertError(entry ~ " must be an array of version filter strings, for example: version = [\">=1.0.0\", \"<2.0.0\"]");
        }
    }

    /**
     * Parse a version filter from a string
     * @params:
     *    - version: the declared filter
     *    - tzer: the tokenizer splitting the comparator from the version
     *    - entry: the name of the configuration entry the filter was read from, for error reporting
     * */
    prv fn parseFilter(mut self, version: [c8], tzer: Tokenizer!{c8}, entry: [c8])
        throws AssertError
    {
        let components = tzer.tokenizeWithoutSkips(version);
        let ver = if components.len == 2 {
            Version(components[1])
        } else if components.len == 1 {
            Version(components[0])
        }  else {
            throw copy AssertError(self.malformed(entry, version));
        };


        if (components.len == 2) {
            if !ver.isNumbered() {
                throw copy AssertError(entry ~ " is invalid: \"" ~ version ~ "\" compares against \"" ~ ver[]
                                       ~ "\", which is not a numbered version, only a version like \"1.0.0\" can be compared");
            }

            let kind = match components[0] {
                ">" => { FilterKind::SUP }
                "<" => { FilterKind::INF }
                "<=" => { FilterKind::INF_EQ }
                ">=" => { FilterKind::SUP_EQ }
                _ => {
                    throw copy AssertError(self.malformed(entry, version));
                }
            };

            self._filters ~= [(kind, ver)];
        } else {
            self._filters ~= [(FilterKind::EQ, ver)];
        }
    }

    /**
     * @returns: the message of a filter that could not be parsed at all
     * */
    prv fn malformed(self, entry: [c8], version: [c8])-> [c8] {
        entry ~ " is invalid: \"" ~ version ~ "\" is not a version filter, expecting a version like \"1.0.0\", "
            ~ "a name like \"master\", or \"*\" for any of them, optionally prefixed by '>', '>=', '<' or '<='"
    }

}
