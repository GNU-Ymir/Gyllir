in lock;

use std::{config::_, stream};
use std::algorithm::sorting;
use gyllir::config::{dependency, url, version};

/**
 * The lock format understood by this build of gyllir. Bumped whenever the shape of
 * 'gyllir.lock' changes in a way that is not backward compatible.
 * */
pub def __LOCK_VERSION__ = 1u32;

/**
 * The comment opening every generated 'gyllir.lock': the file is written by gyllir, and read back
 * by it, editing it by hand only survives until the next resolution
 * */
pub def __LOCK_HEADER__ = str#{# This file is generated by gyllir, and records the exact dependency versions the package was
# last resolved with. It is meant to be committed, and not to be edited by hand.
};

/**
 * @returns: 'strs', in alphabetical order
 * */
fn sortedStrings(strs: [[c8]])-> [[c8]] {
    let mut res: [mut [c8]] = copy strs;
    sorting::sort(alias res, |x, y| {
        let mut i = 0us;
        let mut lower = x.len < y.len;
        while i < x.len && i < y.len {
            if (x[i] != y[i]) {
                lower = x[i] < y[i];
                break;
            }

            i += 1us;
        }

        lower
    });

    res
}

/**
 * A single resolved package, one '[[package]]' entry of 'gyllir.lock'
 * */
pub record LockedPackage {

    // The url the package was resolved from
    let mut _url: Url = Url();

    // The exact version that was resolved
    let mut _version: Version = Version(0u32, 0u32, 0u32);

    // The exact commit the resolved version was checked out at, "" for a 'local:' package, which
    // is never pinned to a commit
    let mut _sha: [c8] = "";

    // The urls of the packages this one depends on, at the time it was resolved
    let mut _dependencies: [Url] = [];

    pub self (url: Url, version: Version, dependencies: [Url] = [], sha: [c8] = "")
        with _url = url
        , _version = version
        , _dependencies = dependencies
        , _sha = sha
    {}

    /**
     * Deserialize a locked package from a configuration
     * @params:
     *    - cfg: one element of the '[[package]]' array of tables
     *    - ctx: the prefix naming the package an error message comes from
     * */
    pub self (cfg: &Config, ctx: [c8])
        throws AssertError
    {
        self:.parse(cfg, ctx);
    }

    /**
     * Parse and validate every field of a '[[package]]' entry
     * @info: "name" is read by 'LockFile::readPackageName' before this entry's own 'ctx' can be
     *   built(the name is what names the entry in the error message), so it is only accepted here,
     *   not read again
     * */
    prv fn parse(mut self, cfg: &Config, ctx: [c8])
        throws AssertError
    {
        self._url = if let Ok(u) = cfg["url"]? {
            Url(u, entry-> ctx ~ "'url'")
        } else {
            throw copy AssertError(ctx ~ "missing required entry 'url', for example: url = \"git:git@github.com:me/foo.git\"");
        };

        self._version = if let Ok(v) = cfg["version"]? {
            Version(v, entry-> ctx ~ "'version'")
        } else {
            throw copy AssertError(ctx ~ "missing required entry 'version', for example: version = \"1.0.0\"");
        };

        self._sha = self.readSha(cfg, self._url, ctx);
        self._dependencies = self.readDependencies(cfg, ctx);

        if let d: &Dict = cfg {
            gyllir::config::errors::rejectUnknown(d, ctx, "name", "url", "version", "sha", "dependencies");
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    @field
    pub fn url(self)-> Url {
        self._url
    }

    @field
    pub fn version(self)-> Version {
        self._version
    }

    @field
    pub fn sha(self)-> [c8] {
        self._sha
    }

    @field
    pub fn dependencies(self)-> [Url] {
        self._dependencies
    }

    /**
     * @returns: true iif the package is pinned to a commit, false for a 'local:' package, which is
     *    only ever recorded, never enforced against a fixed commit
     * */
    pub fn pinned(self)-> bool {
        self._sha != ""
    }

    /**
     * @params:
     *    - dep: a dependency declared by a 'gyllir.toml'
     * @returns: true iif this entry is a valid resolution of 'dep': it was resolved from the url
     *    'dep' declares, and the version it pinned still passes the filter 'dep' declares. A lock
     *    entry that does not match is out of date, and the dependency is resolved again
     * */
    pub fn matches(self, dep: Dependency)-> bool {
        let url = dep.url;
        if (self._url != url) { return false; }

        dep.version.pass(self._version)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Read the optional "sha" entry, only meaningful for a 'git:' package
     * @throws:
     *    - AssertError: a 'local:' package declares a "sha" (it is never pinned to a commit), or a
     *      'git:' package declares none (a lock entry with no commit locks nothing)
     * */
    prv fn readSha(self, cfg: &Config, url: Url, ctx: [c8])-> [c8]
        throws AssertError
    {
        if let Ok(Str(value-> s)) = cfg["sha"]? {
            if (url.type == UrlType::LOCAL) {
                throw copy AssertError(ctx ~ "'sha' cannot be declared for a local dependency, "
                                       ~ "only a 'git:' url is pinned to a commit");
            }

            return s;
        }

        else if let Ok(_) = cfg["sha"]? {
            throw copy AssertError(ctx ~ "'sha' must be a string, the exact commit the resolved version was checked out at");
        }

        if (url.type == UrlType::GIT) {
            throw copy AssertError(ctx ~ "missing required entry 'sha', for example: sha = \"a1b2c3d4e5f6...\", "
                                   ~ "the exact commit the resolved version was checked out at");
        }

        ""
    }

    /**
     * Read the optional "dependencies" entry, the urls of the packages this one depends on
     * */
    prv fn readDependencies(self, cfg: &Config, ctx: [c8])-> [Url]
        throws AssertError
    {
        if let Ok(a: &Array) = cfg["dependencies"]? {
            let mut deps: [Url] = [];
            for i in a[] {
                deps ~= [Url(i, entry-> ctx ~ "'dependencies'")];
            }

            return deps;
        }

        else if let Ok(_) = cfg["dependencies"]? {
            throw copy AssertError(ctx ~ "'dependencies' must be an array of urls, the packages this one depends on");
        }

        []
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          MISC          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Streamable;
    impl Serializable {

        /**
         * @info: an url is written as the "<scheme>:<path>" string form rather than as a sub table,
         *   a lock file is read in code review, and a table would split every entry in two blocks
         * */
        pub over serialize(self)-> &Config {
            let dmut res = copy Dict();
            res["url"] = copy Str(self._url.toStr());
            res["version"] = self._version.serialize();

            if (self._sha != "") {
                res["sha"] = copy Str(self._sha);
            }

            if (self._dependencies.len != 0us) {
                res["dependencies"] = copy Array(copy [copy Str(d.toStr()) for d in self._dependencies]);
            }

            res
        }
    }

}

/**
 * The full content of 'gyllir.lock': the lock format version, and the flattened, transitive
 * closure of every resolved package, one '[[package]]' entry each
 * */
pub class LockFile {

    // The lock format this file was written with
    let mut _lockVersion: u32 = __LOCK_VERSION__;

    // The resolved packages, by the name they were first declared under
    let mut _packages: [[c8] => mut LockedPackage] = copy [];

    /**
     * Create an empty lock file, at the current lock format
     * */
    pub self () {}

    /**
     * Create a lock file from a map of already resolved packages
     * */
    pub self (mut packages: [[c8] => mut LockedPackage], lockVersion: u32 = __LOCK_VERSION__)
        with _packages = alias packages
        , _lockVersion = lockVersion
    {}

    /**
     * Deserialize a lock file from a configuration
     * @throws:
     *    - AssertError: 'lock-version' is missing, malformed, or names a lock format this build of
     *      gyllir does not understand; or one of the '[[package]]' entries is invalid
     * */
    pub self (cfg: &Config)
        throws AssertError
    {
        if let d: &Dict = cfg {
            self:.parseLockVersion(d);
            self:.parsePackages(d);
            gyllir::config::errors::rejectUnknown(d, "", "lock-version", "package");
        }

        else throw copy AssertError("expecting a table, the root of a gyllir.lock file");
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    @field
    pub fn lockVersion(self)-> u32 {
        self._lockVersion
    }

    /**
     * @returns: the resolved packages, by the name they were first declared under
     * */
    pub fn opIndex(self)-> [[c8] => LockedPackage] {
        self._packages
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          SETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Record a resolved package, replacing the entry it was locked at before, if any
     * @params:
     *    - name: the name the package is declared under
     *    - package: its resolution
     * */
    pub fn insert(mut self, name: [c8], package: LockedPackage) {
        self._packages[name] = package;
    }

    /**
     * Drop every entry that the package no longer depends on, directly or through another entry.
     *
     * A build only ever resolves the dependencies of the targets it builds, so an entry that was
     * not visited is kept rather than dropped('gyllir build <one-target>' must not unlock the
     * dependencies of the other ones). Reachability is what tells the two apart: a dependency that
     * was removed from 'gyllir.toml' is no longer reachable from it, and goes.
     *
     * @params:
     *    - roots: the urls of the dependencies declared by the package the lock file belongs to
     * */
    pub fn prune(mut self, roots: [Url]) {
        let dmut kept: [[c8] => LockedPackage] = copy [];
        let mut front = roots;

        while front.len > 0us {
            let mut next: [Url] = [];
            for u in front {
                for name, p in self._packages if name !in kept {
                    let url = p.url;
                    if (url == u) {
                        kept[name] = p;
                        next ~= p.dependencies;
                    }
                }
            }

            front = next;
        }

        self._packages = alias kept;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          DUMPING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Dump the lock file the way gyllir writes it: one '[[package]]' block per resolved package,
     * the packages sorted by name and their fields always in the same order.
     * @info: a lock file lands in code review and in merge conflicts, so two resolutions of the
     *   same graph have to produce the same bytes, which the iteration order of a map does not
     *   give('std::config::toml::dump' writes the entries in whatever order the map holds them)
     * @returns: the content of a 'gyllir.lock' file
     * */
    pub fn toToml(self)-> [c8] {
        let dmut stream = copy StringStream();
        stream:.write(__LOCK_HEADER__);
        stream:.write("lock-version = ", self._lockVersion, "\n");

        for name in sortedStrings(copy [k for k, _ in self._packages]) {
            if let Ok(p) = self._packages[name] {
                stream:.write("\n[[package]]\n");
                stream:.write("name = \"", name, "\"\n");
                stream:.write("url = \"", p.url.toStr(), "\"\n");
                stream:.write("version = \"", p.version[], "\"\n");

                if (p.sha != "") {
                    stream:.write("sha = \"", p.sha, "\"\n");
                }

                if (p.dependencies.len != 0us) {
                    stream:.write("dependencies = [");
                    for i, d in sortedStrings(copy [u.toStr() for u in p.dependencies]) {
                        if (i != 0) { stream:.write(", "); }
                        stream:.write("\"", d, "\"");
                    }

                    stream:.write("]\n");
                }
            }
        }

        stream[]
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Parse and validate the "lock-version" entry
     * @throws:
     *    - AssertError: missing, not an integer, or not the exact lock format this build of gyllir
     *      understands (there is no migration between lock formats yet: a mismatch either way means
     *      this gyllir and this lock file disagree on the shape of the rest of the fields)
     * */
    prv fn parseLockVersion(mut self, d: &Dict)
        throws AssertError
    {
        if let Ok(Int(value-> v)) = d["lock-version"]? {
            if (cast!u32 (v) != __LOCK_VERSION__) {
                let dmut msg = copy StringStream();
                msg:.write("gyllir.lock has lock-version ", v, ", this build of gyllir only understands lock-version ",
                          __LOCK_VERSION__, ": delete gyllir.lock and let it be regenerated, or use a matching gyllir version");
                throw copy AssertError(msg[]);
            }

            self._lockVersion = __LOCK_VERSION__;
        }

        else if let Ok(_) = d["lock-version"]? {
            throw copy AssertError("'lock-version' must be an integer, for example: lock-version = 1");
        }

        else throw copy AssertError("missing required entry 'lock-version', for example: lock-version = 1");
    }

    /**
     * Parse the optional "package" array of tables, one entry per resolved package
     * */
    prv fn parsePackages(mut self, d: &Dict)
        throws AssertError
    {
        if let Ok(pkgs: &Array) = d["package"]? {
            for entry in pkgs[] {
                if let t: &Dict = entry {
                    let name = self.readPackageName(t);
                    let ctx = gyllir::config::errors::inTableArray("package", name);
                    self._packages[name] = LockedPackage(t, ctx);
                }

                else throw copy AssertError("'[[package]]' entries must be tables");
            }
        }

        else if let Ok(_) = d["package"]? {
            throw copy AssertError("'package' must be an array of tables, one '[[package]]' entry per resolved dependency");
        }
    }

    /**
     * Read the required "name" entry of a '[[package]]' entry, the name it was resolved under.
     * @info: read ahead of 'LockedPackage::parse' so that the rest of the entry's errors can be
     *   named by it
     * */
    prv fn readPackageName(self, d: &Dict)-> [c8]
        throws AssertError
    {
        if let Ok(Str(value-> s)) = d["name"]? {
            return s;
        }

        else if let Ok(_) = d["name"]? {
            throw copy AssertError("'[[package]]', 'name' must be a string, the name the package is declared under");
        }

        throw copy AssertError("'[[package]]', missing required entry 'name', for example: name = \"somelib\"");
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          MISC          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Streamable;
    impl Serializable {
        pub over serialize(self)-> &Config {
            let dmut res = copy Dict();
            res["lock-version"] = copy Int(cast!i64 (self._lockVersion));

            let dmut pkgs = copy Array();
            for k, p in self._packages {
                let dmut entry = copy Dict();
                entry["name"] = copy Str(k);

                if let inner: &Dict = p.serialize() {
                    for fk, fv in inner[] {
                        entry[fk] = fv;
                    }
                }

                pkgs:.push(entry);
            }

            res["package"] = pkgs;

            res
        }
    }

}
