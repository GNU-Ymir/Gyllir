in dependency;

use std::{config::_, stream};
use gyllir::config::{url, version, version::filter};

/**
 * A dependency to an external package
 * */
pub record Dependency {

    // The version of the dependency package
    let _version: VersionFilter;

    // The url of the dependency
    let _url: Url;

    // The names of the dependency's targets to link ([] selects every one of its library targets)
    let _targets: [[c8]];

    pub self (version: VersionFilter, url: Url, targets: [[c8]] = [])
        with _version = version
        , _url = url
        , _targets = targets
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    @field
    pub fn version(self)-> VersionFilter {
        self._version
    }

    @field
    pub fn url(self)-> Url {
        self._url
    }

    @field
    pub fn targets(self)-> [[c8]] {
        self._targets
    }

}

/**
 * A dependency list is a map of Dependency, that can be serialized into configuration
 */
pub class DependencyList {

    /**
     * The list of dependencies
     */
    let mut _package: [[c8] => mut Dependency] = copy [];

    /**
     * Create an empty dependency list
     */
    pub self () {}

    /**
     * Create a dependency list from a map of Dependency
     */
    pub self (mut elem: [[c8] => mut Dependency])
        with _package = alias elem
    {}

    /**
     * Create a dependency list from a configuration
     * This constructor can be used by the std for serialization
     * @example:
     * =================
     * def getConfiguration()-> &Config;
     *
     * let dmut list = getConfiguration().to!{&DependencyList} ();
     * =================
     */
    pub self (cfg: &Config)
        throws AssertError
    {
        if let d: &Dict = cfg {
            self:.insert(d);
        }

        else throw copy AssertError("'dependencies' must be a table, one '[dependencies.<name>]' entry per dependency"s8);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GET/SET          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Remove a dependency from the list
     * @params:
     *   - elem: the name of dependency to remove
     */
    pub fn remove(mut self, elem: [c8]) {
        self._package:.remove(elem);
    }

    /**
     * @returns: the list of dependencies
     */
    pub fn opIndex(self)-> [[c8] => Dependency] {
        self._package
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          MISC          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Streamable;
    impl Serializable {
        pub over serialize(self)-> &Config {
            let dmut res = copy Dict();
            for k, d in self._package {
                let dmut dep = copy Dict();
                dep["version"] = d.version.serialize();
                dep["url"] = d.url.serialize();

                if (d.targets.len != 0us) {
                    dep["link-targets"] = copy Array(copy [copy Str(i) for i in d.targets]);
                }

                res[k] = dep;
            }

            res
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */


    /**
     * Insert the dependencies from a configuration dictionnary
     */
    /**
     * Insert the dependencies from a configuration dictionnary
     * @throws:
     *    - AssertError: one of the entries is named "std", which is reserved for the std lib
     *      resolved by '[std]'('gyllir::repo::defaults::__STD_DEP_NAME__') - a dependency sharing
     *      that name would collide with it in the lock file and in '.deps/'
     * */
    prv fn insert(mut self, cfg: &Dict)
        throws AssertError
    {
        for k, v in cfg[] {
            if (k == "std") {
                throw copy AssertError("'[dependencies.std]', 'std' is reserved for the std lib resolved by '[std]', "
                                       ~ "name this dependency differently");
            }

            self._package[k] = self.parseDependency(k, v);
        }
    }

    /**
     * Parse a single '[dependencies.<name>]' table
     * @params:
     *    - name: the name of the dependency, the key of its table
     *    - cfg: the content of its table
     * @throws:
     *    - AssertError: on the first entry that is missing, or that does not have the expected
     *      shape. Its message names the dependency it comes from
     * */
    prv fn parseDependency(self, name: [c8], cfg: &Config)-> Dependency
        throws AssertError
    {
        let ctx = gyllir::config::errors::inTable("dependencies", name);

        let version = if let Ok(v) = cfg["version"]? {
            VersionFilter(v, entry-> ctx ~ "'version'")
        } else {
            throw copy AssertError(ctx ~ "missing required entry 'version', for example: version = \">=1.0.0\", or \"*\" for any version");
        };

        let url = if let Ok(u) = cfg["url"]? {
            Url(u, entry-> ctx ~ "'url'")
        } else {
            throw copy AssertError(ctx ~ "missing required entry 'url', for example: url = \"git:git@github.com:me/" ~ name ~ ".git\"");
        };

        if let d: &Dict = cfg {
            gyllir::config::errors::rejectUnknown(d, ctx, "version", "url", "link-targets");
        }

        Dependency(version-> version, url, targets-> self.readTargets(cfg, ctx))
    }

    /**
     * Read the optional "link-targets" entry of a dependency table
     * @params:
     *    - cfg: the content of the dependency table
     *    - ctx: the prefix naming the dependency, for error reporting
     * @returns: the names of the dependency's targets to link, [] when the key is absent (meaning
     *    every one of its library targets)
     * @throws:
     *    - AssertError: the key is present but not an array of strings, or an explicitly empty one
     * */
    prv fn readTargets(self, cfg: &Config, ctx: [c8])-> [[c8]]
        throws AssertError
    {
        if let Ok(a: &Array) = cfg["link-targets"]? {
            let mut targets: [[c8]] = [];
            for i in a[] {
                if let Str(value-> t) = i {
                    targets ~= [t];
                } else {
                    throw copy AssertError(ctx ~ "'link-targets' must be an array of strings, the names of the targets to link");
                }
            }

            if (targets.len == 0us) {
                throw copy AssertError(ctx ~ "'link-targets' is empty, omit the entry to link every target of the dependency");
            }

            return targets;
        }

        else if let Ok(_) = cfg["link-targets"]? {
            throw copy AssertError(ctx ~ "'link-targets' must be an array of strings, the names of the targets to link");
        }

        []
    }


}
