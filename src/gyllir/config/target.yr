in target;

use gyllir::config::type;

use std::{char, config, fs, stream};

/**
 * The source directory of a target that does not declare one
 * */
pub def __DEFAULT_SOURCE_DIR__ = "src";

/**
 * The test directory of a target that does not declare one
 * */
pub def __DEFAULT_TEST_DIR__ = "test";

/**
 * The directory the artifacts of a target are written to when neither the target nor its package
 * declares one: the package directory itself
 * */
pub def __DEFAULT_OUTPUT_DIR__ = ".";

/**
 * A build target, declared by a '[targets.<name>]' table of a gyllir.toml.
 *
 * A package declaring no such table still has exactly one target, synthesized from its top level
 * fields by 'GyllirPackageConfiguration::targets', so the rest of gyllir only ever builds targets
 * and never has to special case the single target packages.
 * */
pub record Target {

    // The name of the target, the key of its '[targets.<name>]' table
    let _name: [c8];

    // The kind of artifact produced by the target
    let _type: BuildType;

    // The short description of the target ("" when it declares none)
    let _description: [c8];

    // The directory holding the sources of the target, relative to the package directory
    let _sourceDir: [c8];

    // The root module of the target, relative to '_sourceDir' and without extension
    // ("" when the target declares none, the name of the target is used instead)
    let _packageRoot: [c8];

    // The directory holding the unittests of the target, relative to the package directory
    let _testDir: [c8];

    // The root module of the unittests of the target, relative to '_testDir'
    // ("" when the target declares none)
    let _testRoot: [c8];

    // False iif the target opted out of unittesting, in which case it declares neither '_testDir'
    // nor '_testRoot'
    let _tests: bool;

    // The name of the produced artifact ("" when the name of the target is used instead)
    let _output: [c8];

    // The directory the artifacts of the target are written to, relative to the package directory
    // unless absolute ("" when the target declares none, the one of its package is used instead)
    let _outputDir: [c8];

    // The raw options passed to the compiler when building the target
    let _flags: [[c8]];

    // The C libraries linked into the target
    let _libraries: [[c8]];

    // The version identifiers the target is compiled with, each passed as '-fversion=<ident>' so
    // the 'cte if __pragma!has_version(<ident>)' blocks of its sources can be gated per target
    let _version: [[c8]];

    // The names of the package dependencies linked by the target
    // ([] selects every dependency declared by the package)
    let _dependencies: [[c8]];

    // The names of the targets of the same package linked by the target
    let _targets: [[c8]];

    // The C source files compiled and archived into the target. Each entry is either a literal
    // path, a '<dir>/*.<ext>' non-recursive glob, or a '<dir>/**/*.<ext>' recursive glob, all
    // relative to the package directory
    let _cSources: [[c8]];

    // The raw options passed to the C compiler when building 'cSources', appended last so a
    // target can add its own include directories or defines (e.g. "-I", "-D...")
    let _cFlags: [[c8]];

    // True iif the target was synthesized from the top level fields of a package declaring no
    // '[targets.<name>]' table, in which case its root module keeps the historical fallback to
    // 'src/main.yr' that a declared target does not have
    let _synthesized: bool;

    /**
     * @params:
     *    - name: the name of the target
     *    - type: the kind of artifact it produces
     *    - description: the short description of the target
     *    - sourceDir: the directory holding its sources
     *    - packageRoot: its root module, relative to 'sourceDir' and without extension
     *    - testDir: the directory holding its unittests
     *    - testRoot: the root module of its unittests, relative to 'testDir'
     *    - tests: false to opt the target out of unittesting
     *    - output: the name of the produced artifact
     *    - outputDir: the directory the artifacts are written to
     *    - flags: the raw options passed to the compiler
     *    - libraries: the C libraries to link
     *    - version: the version identifiers the target is compiled with
     *    - dependencies: the names of the package dependencies to link
     *    - targets: the names of the targets of the same package to link
     *    - cSources: the C source files to archive
     *    - cFlags: the raw options passed to the C compiler when building 'cSources'
     *    - synthesized: true iif the target is not declared by a '[targets.<name>]' table
     * */
    pub self (name: [c8],
              type: BuildType,
              description: [c8] = "",
              sourceDir: [c8] = __DEFAULT_SOURCE_DIR__,
              packageRoot: [c8] = "",
              testDir: [c8] = __DEFAULT_TEST_DIR__,
              testRoot: [c8] = "",
              tests: bool = true,
              output: [c8] = "",
              outputDir: [c8] = "",
              flags: [[c8]] = [],
              libraries: [[c8]] = [],
              version: [[c8]] = [],
              dependencies: [[c8]] = [],
              targets: [[c8]] = [],
              cSources: [[c8]] = [],
              cFlags: [[c8]] = [],
              synthesized: bool = false)
        with _name = name
        , _type = type
        , _description = description
        , _sourceDir = sourceDir
        , _packageRoot = packageRoot
        , _testDir = testDir
        , _testRoot = testRoot
        , _tests = tests
        , _output = output
        , _outputDir = outputDir
        , _flags = flags
        , _libraries = libraries
        , _version = version
        , _dependencies = dependencies
        , _targets = targets
        , _cSources = cSources
        , _cFlags = cFlags
        , _synthesized = synthesized
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    @field
    pub fn name(self)-> [c8] {
        self._name
    }

    @field
    pub fn type(self)-> BuildType {
        self._type
    }

    @field
    pub fn description(self)-> [c8] {
        self._description
    }

    @field
    pub fn sourceDir(self)-> [c8] {
        self._sourceDir
    }

    @field
    pub fn packageRoot(self)-> [c8] {
        self._packageRoot
    }

    @field
    pub fn testDir(self)-> [c8] {
        self._testDir
    }

    @field
    pub fn testRoot(self)-> [c8] {
        self._testRoot
    }

    @field
    pub fn tests(self)-> bool {
        self._tests
    }

    @field
    pub fn output(self)-> [c8] {
        self._output
    }

    /**
     * @returns: the directory the artifacts of the target are written to, as it is declared ("" when
     *    it declares none), see 'outputDirectory' for the one actually used
     * */
    @field
    pub fn outputDir(self)-> [c8] {
        self._outputDir
    }

    @field
    pub fn flags(self)-> [[c8]] {
        self._flags
    }

    @field
    pub fn libraries(self)-> [[c8]] {
        self._libraries
    }

    @field
    pub fn version(self)-> [[c8]] {
        self._version
    }

    @field
    pub fn dependencies(self)-> [[c8]] {
        self._dependencies
    }

    @field
    pub fn targets(self)-> [[c8]] {
        self._targets
    }

    @field
    pub fn cSources(self)-> [[c8]] {
        self._cSources
    }

    @field
    pub fn cFlags(self)-> [[c8]] {
        self._cFlags
    }

    @field
    pub fn synthesized(self)-> bool {
        self._synthesized
    }

    /**
     * @returns: the root module of the target, the name of the target when it declares none
     * */
    pub fn rootModule(self)-> [c8] {
        if (self._packageRoot != "") { return self._packageRoot; }

        self._name
    }

    /**
     * @returns: the name of the artifact produced by the target, the name of the target when it
     *    declares none
     * */
    pub fn outputName(self)-> [c8] {
        if (self._output != "") { return self._output; }

        self._name
    }

    /**
     * @returns: the directory the artifacts of the target are written to, '.'(the package directory)
     *    when it declares none
     * */
    pub fn outputDirectory(self)-> [c8] {
        if (self._outputDir != "") { return self._outputDir; }

        __DEFAULT_OUTPUT_DIR__
    }

    /**
     * @params:
     *    - cwd: the package directory
     * @returns: the directory the artifacts of the target are written to, 'outputDirectory' resolved
     *    against the package directory, unless it is absolute
     * */
    pub fn outputPath(self, cwd: Path)-> Path {
        let dir = Path(self.outputDirectory());
        if (dir.isAbsolute()) { return dir.normalize(); }

        cwd.push(dir).normalize()
    }

    /**
     * @params:
     *    - cwd: the package directory
     *    - file: the name of an artifact of the target
     * @returns: the path of that artifact, in the output directory of the target
     * */
    pub fn artifactPath(self, cwd: Path, file: [c8])-> Path {
        self.outputPath(cwd).push(file)
    }

    /**
     * @params:
     *    - file: the name of an artifact of the target
     * @returns: how that artifact is named to the user: relative to the package directory, unless the
     *    output directory is absolute, and without a leading './'
     * */
    pub fn artifactDisplay(self, file: [c8])-> [c8] {
        let dir = Path(self.outputDirectory()).normalize();
        if (dir.isAbsolute()) { return dir.push(file).toStr(); }
        if (dir.toStr() == ".") { return file; }

        dir.push(file).toStr()
    }

    /**
     * @params:
     *    - dir: the output directory to use
     * @returns: the target, writing its artifacts to 'dir'
     * */
    pub fn withOutputDir(self, dir: [c8])-> Target {
        Target(self._name, self._type,
               description-> self._description,
               sourceDir-> self._sourceDir,
               packageRoot-> self._packageRoot,
               testDir-> self._testDir,
               testRoot-> self._testRoot,
               tests-> self._tests,
               output-> self._output,
               outputDir-> dir,
               flags-> self._flags,
               libraries-> self._libraries,
               version-> self._version,
               dependencies-> self._dependencies,
               targets-> self._targets,
               cSources-> self._cSources,
               cFlags-> self._cFlags,
               synthesized-> self._synthesized)
    }

    /**
     * @params:
     *    - name: the name of a dependency declared by the package
     * @returns: true iif the target links that dependency
     * @info: a declared target links exactly what it lists, so omitting 'dependencies'(or writing an
     *    empty one) links none of them. The target synthesized for a package declaring none has no
     *    selector to write, so it keeps linking everything the package declares.
     * */
    pub fn selects(self, name: [c8])-> bool {
        if (self._synthesized) { return true; }

        for d in self._dependencies if d == name {
            return true;
        }

        false
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          MISC          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Streamable;
}

/**
 * A target list is a map of Target, that can be serialized into configuration
 * */
pub class TargetList {

    // The list of targets, by name
    let mut _targets: [[c8] => mut Target] = copy [];

    /**
     * Create an empty target list
     * */
    pub self () {}

    /**
     * Create a target list from a map of Target
     * */
    pub self (mut elem: [[c8] => mut Target])
        with _targets = alias elem
    {}

    /**
     * Create a target list from a configuration
     * This constructor can be used by the std for serialization
     * */
    pub self (cfg: &Config)
        throws AssertError
    {
        if let d: &Dict = cfg {
            self:.insert(d);
        } else throw copy AssertError("'targets' must be a table, one '[targets.<name>]' entry per target"s8);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GET/SET          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the list of targets
     * */
    pub fn opIndex(self)-> [[c8] => Target] {
        self._targets
    }

    /**
     * @returns: the number of declared targets
     * */
    pub fn len(self)-> usize {
        self._targets.len
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          MISC          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Streamable;
    impl Serializable {
        pub over serialize(self)-> &Config {
            let dmut res = copy Dict();
            for k, t in self._targets {
                let dmut trg = copy Dict();
                trg["type"] = t.type.serialize();

                if (t.description != "") {
                    trg["description"] = copy Str(t.description);
                }

                if (t.sourceDir != __DEFAULT_SOURCE_DIR__) {
                    trg["source-dir"] = copy Str(t.sourceDir);
                }

                if (t.packageRoot != "") {
                    trg["package-root"] = copy Str(t.packageRoot);
                }

                if (t.testDir != __DEFAULT_TEST_DIR__) {
                    trg["test-dir"] = copy Str(t.testDir);
                }

                if (t.testRoot != "") {
                    trg["test-root"] = copy Str(t.testRoot);
                }

                if (!t.tests) {
                    trg["tests"] = copy Bool(false);
                }

                if (t.output != "") {
                    trg["output"] = copy Str(t.output);
                }

                if (t.outputDir != "") {
                    trg["output-dir"] = copy Str(t.outputDir);
                }

                if (t.flags.len != 0us) {
                    trg["flags"] = copy Array(copy [copy Str(i) for i in t.flags]);
                }

                if (t.libraries.len != 0us) {
                    trg["libraries"] = copy Array(copy [copy Str(i) for i in t.libraries]);
                }

                if (t.version.len != 0us) {
                    trg["version"] = copy Array(copy [copy Str(i) for i in t.version]);
                }

                if (t.dependencies.len != 0us) {
                    trg["dependencies"] = copy Array(copy [copy Str(i) for i in t.dependencies]);
                }

                if (t.targets.len != 0us) {
                    trg["targets"] = copy Array(copy [copy Str(i) for i in t.targets]);
                }

                if (t.cSources.len != 0us) {
                    trg["c-sources"] = copy Array(copy [copy Str(i) for i in t.cSources]);
                }

                if (t.cFlags.len != 0us) {
                    trg["c-flags"] = copy Array(copy [copy Str(i) for i in t.cFlags]);
                }

                res[k] = trg;
            }

            res
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Insert the targets from a configuration dictionnary
     * */
    prv fn insert(mut self, cfg: &Dict)
        throws AssertError
    {
        for k, v in cfg[] {
            self._targets[k] = self.parseTarget(k, v);
        }
    }

    /**
     * Parse a single '[targets.<name>]' table
     * @params:
     *    - name: the name of the target, the key of its table
     *    - cfg: the content of its table
     * @throws:
     *    - AssertError: on the first entry that does not have the expected shape. Its message names
     *      the target it comes from
     * */
    prv fn parseTarget(self, name: [c8], cfg: &Config)-> Target
        throws AssertError
    {
        let ctx = gyllir::config::errors::inTable("targets", name);

        let type = if let Ok(t) = cfg["type"]? {
            BuildType(t, entry-> ctx ~ "'type'")
        } else { BuildType() };

        let tests = self.readBool(cfg, "tests", ctx, default-> true);
        if (!tests) {
            for k in ["test-dir", "test-root"] {
                if let Ok(_) = cfg[k]? {
                    throw copy AssertError(ctx ~ "'tests' is set to false, the target declares no unittest, it cannot "
                                           ~ "declare '" ~ k ~ "'");
                }
            }
        }

        if let d: &Dict = cfg {
            // 'name' is redundant with the key of the '[targets.<name>]' table itself(which is
            // where 'Target::name' actually comes from), but some published packages(including the
            // official std lib) still carry it, from an older schema, so it is accepted and ignored
            // rather than rejected
            gyllir::config::errors::rejectUnknown(d,
                                                  ctx,
                                                  "type",
                                                  "name",
                                                  "description",
                                                  "tests",
                                                  "source-dir",
                                                  "package-root",
                                                  "test-dir",
                                                  "test-root",
                                                  "output",
                                                  "output-dir",
                                                  "flags",
                                                  "libraries",
                                                  "version",
                                                  "dependencies",
                                                  "targets",
                                                  "c-sources",
                                                  "c-flags");
        }

        Target(name, type,
               description-> self.readString(cfg, "description", ctx),
               sourceDir-> self.readString(cfg, "source-dir", ctx, default-> __DEFAULT_SOURCE_DIR__),
               packageRoot-> self.readString(cfg, "package-root", ctx),
               testDir-> self.readString(cfg, "test-dir", ctx, default-> __DEFAULT_TEST_DIR__),
               testRoot-> self.readString(cfg, "test-root", ctx),
               tests-> tests,
               output-> self.readString(cfg, "output", ctx),
               outputDir-> readOutputDir(cfg, ctx),
               flags-> self.readStringArray(cfg, "flags", ctx),
               libraries-> self.readStringArray(cfg, "libraries", ctx),
               version-> self.readVersions(cfg, ctx),
               dependencies-> self.readStringArray(cfg, "dependencies", ctx),
               targets-> self.readStringArray(cfg, "targets", ctx),
               cSources-> self.readStringArray(cfg, "c-sources", ctx),
               cFlags-> self.readStringArray(cfg, "c-flags", ctx))
    }

    /**
     * Read an optional string entry of a target table
     * @params:
     *    - cfg: the content of the target table
     *    - key: the name of the entry to read
     *    - ctx: the prefix naming the target, for error reporting
     *    - default: the value returned when the entry is absent
     * */
    prv fn readString(self, cfg: &Config, key: [c8], ctx: [c8], default: [c8] = "")-> [c8]
        throws AssertError
    {
        if let Ok(Str(value-> v)) = cfg[key]? {
            return v;
        } else if let Ok(_) = cfg[key]? {
            throw copy AssertError(ctx ~ "'" ~ key ~ "' must be a string");
        }

        default
    }

    /**
     * Read an optional boolean entry of a target table
     * @params:
     *    - cfg: the content of the target table
     *    - key: the name of the entry to read
     *    - ctx: the prefix naming the target, for error reporting
     *    - default: the value returned when the entry is absent
     * */
    prv fn readBool(self, cfg: &Config, key: [c8], ctx: [c8], default: bool)-> bool
        throws AssertError
    {
        if let Ok(Bool(value-> v)) = cfg[key]? {
            return v;
        } else if let Ok(_) = cfg[key]? {
            throw copy AssertError(ctx ~ "'" ~ key ~ "' must be a boolean, either true or false");
        }

        default
    }

    /**
     * Read the 'version' entry of a target table, the version identifiers it is compiled with
     * @params:
     *    - cfg: the content of the target table
     *    - ctx: the prefix naming the target, for error reporting
     * @throws:
     *    - AssertError: an entry is not an identifier. The compiler would take it, but no
     *      '__pragma!has_version' block can ever name it, so it would be ignored in silence
     * */
    prv fn readVersions(self, cfg: &Config, ctx: [c8])-> [[c8]]
        throws AssertError
    {
        let res = self.readStringArray(cfg, "version", ctx);
        for v in res if !isIdentifier(v) {
            throw copy AssertError(ctx ~ "'version', '" ~ v ~ "' is not an identifier, a version is made of letters, "
                                   ~ "digits and '_', and does not start with a digit");
        }

        res
    }

    /**
     * Read an optional array of string entry of a target table
     * @params:
     *    - cfg: the content of the target table
     *    - key: the name of the entry to read
     *    - ctx: the prefix naming the target, for error reporting
     * */
    prv fn readStringArray(self, cfg: &Config, key: [c8], ctx: [c8])-> [[c8]]
        throws AssertError
    {
        if let Ok(a: &Array) = cfg[key]? {
            let mut res: [[c8]] = [];
            for i in a[] {
                if let Str(value-> v) = i {
                    res ~= [v];
                } else {
                    throw copy AssertError(ctx ~ "'" ~ key ~ "' must be an array of strings");
                }
            }

            return res;
        } else if let Ok(_) = cfg[key]? {
            throw copy AssertError(ctx ~ "'" ~ key ~ "' must be an array of strings");
        }

        []
    }
}

/**
 * @returns: true iif 'name' could be written as a Ymir identifier: letters, digits and '_', not
 *    starting with a digit
 * */
prv fn isIdentifier(name: [c8])-> bool {
    if (name.len == 0us || std::char::isDigit(name[0])) { return false; }

    for c in name if (!std::char::isAlpha(c) && !std::char::isDigit(c) && c != '_') {
        return false;
    }

    true
}

/**
 * Read the optional 'output-dir' entry of a table, the directory the artifacts of a target are
 * written to
 * @params:
 *    - cfg: the content of the table, the top level of the package or a '[targets.<name>]' one
 *    - ctx: the prefix naming the table, for error reporting
 * @returns: the declared directory, "" when the table declares none
 * @throws:
 *    - AssertError: the entry is not a string, or is an empty one, which names no directory
 * */
pub fn readOutputDir(cfg: &Config, ctx: [c8])-> [c8]
    throws AssertError
{
    if let Ok(Str(value-> v)) = cfg["output-dir"]? {
        if (v == "") {
            throw copy AssertError(ctx ~ "'output-dir' must name a directory, \"" ~ __DEFAULT_OUTPUT_DIR__
                                   ~ "\" being the package directory, for example: output-dir = \"bin\"");
        }

        return v;
    } else if let Ok(_) = cfg["output-dir"]? {
        throw copy AssertError(ctx ~ "'output-dir' must be a string, for example: output-dir = \"bin\"");
    }

    ""
}
