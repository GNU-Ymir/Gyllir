in type;

use std::{config::_, stream};

/**
 * Enum defining the type of the target
 * */
enum BuildTypeEnum
| EXECUTABLE = (0u8, "executable")
| LIBRARY    = (1u8, "library");


/**
 * Record used to transform configuration into a build type
 * */
pub record BuildType {

    // The type of the target to build
    let mut _type: u8 = BuildTypeEnum::EXECUTABLE.0;

    /**
     * executable target
     * */
    pub self () {}

    /**
     * @params:
     *    - type: a string defining the type of the target
     *    - entry: the name of the configuration entry being read, for error reporting
     * */
    pub self (type: [c8], entry: [c8] = "'type'")
        throws AssertError
    {
        self:.parseType(type, entry);
    }

    /**
     * Transform a configuration into a build type
     * @params:
     *    - cfg: the value of the entry declaring the type
     *    - entry: the name of that entry, for error reporting
     * */
    pub self (cfg: &Config, entry: [c8] = "'type'")
        throws AssertError
    {
        if let Str(value-> type) = cfg {
            self:.parseType(type, entry);
        }

        else throw copy AssertError(entry ~ " must be a string, one of " ~ typeNames());
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub fn isExecutable(self)-> bool {
        self._type == BuildTypeEnum::EXECUTABLE.0
    }

    pub fn isLibrary(self)-> bool {
        self._type == BuildTypeEnum::LIBRARY.0
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          MISC          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Streamable;
    impl Serializable {
        pub over serialize(self)-> &Config {
            for i in BuildTypeEnum::__members__ {
                if i.0 == self._type {
                    return copy Str(i.1);
                }
            }

            panic;
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Parse the type from a string
     * @params:
     *    - value: the declared type
     *    - entry: the name of the configuration entry it was read from, for error reporting
     * */
    prv fn parseType(mut self, value: [c8], entry: [c8])
        throws AssertError
    {
        for i in BuildTypeEnum::__members__ {
            if i.1 == value {
                self._type = i.0;
                return;
            }
        }

        throw copy AssertError(entry ~ " is invalid: \"" ~ value ~ "\" is not a build type, expecting one of " ~ typeNames());
    }
}

/**
 * @returns: the build types a target can declare, quoted and comma separated, for an error message
 * */
pub fn typeNames()-> [c8] {
    let dmut stream = copy StringStream();
    for i, m in BuildTypeEnum::__members__ {
        if (i != 0us) { stream:.write(", "s8); }
        stream:.write("\""s8):.write(m.1):.write("\""s8);
    }

    stream[]
}
