in url;

use std::{config::_, fs::path, stream};
use std::algorithm::searching;

/**
 * There are two types of url for the moment
 * - Local ones, that are refering to file datas
 * - Git ones, that are refering to a git repository on a remote server
 */
pub enum UrlType
| LOCAL = 0u8
| GIT   = 2u8;

pub enum UrlStarts
| LOCAL = "local:"
| GIT   = "git:";


/**
 * An url that is used to get refer to package repositories
 * Url seems to be a common object, maybe it has its place in the std, in the use std::net module
 */
pub record Url {

    // The path of the url
    let mut _path: Path = Path("");

    // The type of the url
    let mut _type: UrlType = UrlType::LOCAL;

    // True iif the url is valid
    let mut _valid: bool = false;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Create an empty url
     */
    pub self () {}

    /**
     * Create an url from a string
     */
    pub self (c: [c8]) {
        self:.parseStr(c);
        self._valid = true;
    }

    /**
     * Create an url from a configuration
     * This constructor can be used by the std for deserialization
     * @params:
     *    - cfg: the value of the entry declaring the url
     *    - entry: the name of that entry, for error reporting
     * @example:
     * ====================
     * fn getConfiguration()-> &Config;
     *
     * let dmut list = getConfiguration().to!{&Url} ();
     * ====================
     */
    pub self (cfg: &Config, entry: [c8] = "'url'")
        throws AssertError
    {
        if let Ok(Str(value-> url)) = cfg["local"]? {
            if let d: &Dict = cfg {
                gyllir::config::errors::rejectUnknown(d, entry ~ " ", "local");
            }

            self._path = Path(url);
            self._type = UrlType::LOCAL;
            self._valid = true;
        }

        else if let Ok(Str(value-> url)) = cfg["git"]? {
            if let d: &Dict = cfg {
                gyllir::config::errors::rejectUnknown(d, entry ~ " ", "git");
            }

            self._path = Path(url);
            self._type = UrlType::GIT;
            self._valid = true;
        }


        else if let Str(value-> url)  = cfg {
            self:.parseStr(url);
            self._valid = true;
        }

        // a table declaring the right key, but not with a string, otherwise falls in the generic
        // message below, which says nothing about the key that is actually at fault
        else if let Ok(_) = cfg["local"]? {
            throw copy AssertError(entry ~ " is invalid: 'local' must be a string, the path of a local package");
        }

        else if let Ok(_) = cfg["git"]? {
            throw copy AssertError(entry ~ " is invalid: 'git' must be a string, the remote of a git repository");
        }

        else throw copy AssertError(entry ~ " is invalid: expecting a string like \"git:<remote>\" or \"local:<path>\", "
                                    ~ "or a table declaring a 'git' or a 'local' entry");
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the type of url
     */
    @field
    pub fn type(self)-> UrlType {
        self._type
    }

    /**
     * @returns: the path of the url
     */
    @field
    pub fn path(self)-> Path {
        self._path
    }

    /**
     * @returns: true if the url parsing succeded
     */
    pub fn isValid(self)-> bool {
        self._valid
    }

    /**
     * @returns: the url written the way it is declared in a configuration file, its path prefixed
     *    by the scheme it was read from
     * @example:
     * ====================
     * assert(Url("git:git@github.com:me/foo.git").toStr() == "git:git@github.com:me/foo.git");
     * assert(Url("../foo").toStr() == "git:../foo"); // an url with no scheme is a git one
     * ====================
     */
    pub fn toStr(self)-> [c8] {
        if (self._type == UrlType::LOCAL) {
            return UrlStarts::LOCAL ~ self._path.toStr();
        }

        UrlStarts::GIT ~ self._path.toStr()
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          COMPARISON          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: true if self == o
     */
    pub fn opEquals(self, ref o: Url)-> bool {
        if (self._path != o._path) return false;
        if (self._type != o._type) return false;
        if (self._valid != o._valid) return false;

        true
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PARSING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Parse an url from a string
     * @params:
     *    - url: the url to parse
     */
    prv fn parseStr(mut self, url: [c8]) {
        if startsWith(url, UrlStarts::LOCAL) {
            self._path = Path(url[UrlStarts::LOCAL.len .. $]);
            self._type = UrlType::LOCAL;
        }

        else if (startsWith(url, UrlStarts::GIT)) {
            self._path = Path(url[UrlStarts::GIT.len .. $]);
            self._type = UrlType::GIT;
        }

        else {
            self._path = Path(url);
            self._type = UrlType::GIT;
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          MISC          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Hashable;
    impl Streamable;
    impl Serializable {

        /**
         * Transform the url into a configuration
         */
        pub over serialize(self)-> &Config {
            let dmut d = copy Dict();
            match self._type {
                UrlType::LOCAL => {
                    d["local"] = copy Str(self._path.toStr());
                }
                _ => { d["git"] = copy Str(self._path.toStr()); }
            }

            d
        }
    }

}
