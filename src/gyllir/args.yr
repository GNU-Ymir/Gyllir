in args;

use std::config::_;
use std::{io, stream, concurrency::process};
use std::syntax::tokenizer;
use std::fs::_;


/**
 * The version of the gyllir binary.
 * @info: kept in sync with the 'version' field of gyllir.toml by 'tools/set-version.sh',
 *   declared as a pre build command in the '[commands]' table of gyllir.toml.
 * */
pub def __GYLLIR_VERSION__ = "1.5.1";

/**
 * Format the version banner of gyllir
 * @params:
 *    - compiler: the version of the compiler that gyllir drives ("" if unknown)
 * @returns: the text printed by 'gyllir --version'
 * */
pub fn versionString(compiler: [c8] = "")-> [c8] {
    let dmut stream = copy StringStream();
    stream:.write("gyllir "s8):.write(__GYLLIR_VERSION__);
    if (compiler != "") {
        stream:.write("\n"s8):.write(compiler);
    }

    stream[]
}

/**
 * Ask the compiler for its own version
 * @params:
 *    - compiler: the name of the compiler binary
 * @returns: the first line printed by '<compiler> --version', or "" if it cannot be run
 * */
pub fn compilerVersion(compiler: [c8] = "gyc")-> [c8] {
    let dmut proc = copy SubProcess(compiler, copy ["--version"s8]);
    proc:.start();

    if (proc:.wait() != 0) return "";

    let dmut pipe = alias proc.stdout;
    let dmut res: [c8] = [];
    while let Ok(c) = pipe:.read!c8()? {
        if (c == '\n') break;
        res ~= [c];
    }

    res
} catch {
    _ => ""
}

/**
 * Ask the compiler for the version of the std lib(midgard) it was bundled with
 * @params:
 *    - compiler: the name of the compiler binary
 * @returns: the version printed on the compiler's 'Midgard version <version> <date>' line of its
 *    '--version' output (e.g. "1.3.0"), or "" if it cannot be run, or prints no such line
 * */
pub fn compilerStdVersion(compiler: [c8] = "gyc")-> [c8] {
    let dmut proc = copy SubProcess(compiler, copy ["--version"s8]);
    proc:.start();

    if (proc:.wait() != 0) return "";

    let dmut pipe = alias proc.stdout;
    let dmut line: [c8] = [];
    while let Ok(c) = pipe:.read!c8()? {
        if (c == '\n') {
            let v = midgardVersionOfLine(line);
            if (v != "") return v;
            line = [];
        } else {
            line ~= [c];
        }
    }

    midgardVersionOfLine(line)
} catch {
    _ => ""
}

/**
 * Locates the compiler's own bundled std include directory('<prefix>/include/ymir/<ver>/'), the
 * one '-iprefix' redirects when a '[std]' resolves a version other than the one bundled with the
 * compiler: rather than turning the compiler's implicit prelude import off entirely('-nostdinc'
 * has no way to redirect it to a custom '-I' - every source file would need its own explicit
 * 'use core::_;'/'use etc::_;' just to get back what it already has for free by default), a
 * synthetic directory shaped exactly like this one, but pointing at the resolved std lib, is
 * built and passed as '-iprefix' instead - keeping 'Hashable', 'AssertError',
 * 'etc::c::process::_yrt_exit', etc. available exactly as they are without '[std]' at all.
 * @params:
 *    - compiler: the name of the compiler binary
 * @returns: '[<the compiler's own include/ymir/<ver> directory>]', or '[]' if it could not be
 *    found(a compiler too old to support '-print-prog-name', or a non-standard install layout)
 * */
pub fn compilerCoreVersionDir(compiler: [c8] = "gyc")-> [Path] {
    let dmut proc = copy SubProcess(compiler, copy ["-print-prog-name=ymir1"s8]);
    proc:.start();

    if (proc:.wait() != 0) return [];

    let dmut pipe = alias proc.stdout;
    let dmut res: [c8] = [];
    while let Ok(c) = pipe:.read!c8()? {
        if (c == '\n') break;
        res ~= [c];
    }

    let mut empty: [Path] = [];

    let progPath = Path(res);
    if (!progPath.isAbsolute()) return empty; // 'gcc -print-prog-name' echoes the bare name back when it can't locate the program

    let includeRoot = progPath.parent().push("include"s8).push("ymir"s8);
    if (!isDir(includeRoot)) return empty;

    for entry in readDir(includeRoot) {
        match entry {
            FsEntry(path-> p, kind-> FsEntryKind::DIR) => {
                if (isFile(p.push("core.yr"s8)) && isFile(p.push("etc.yr"s8)) && isFile(p.push("std.yr"s8))) {
                    return copy [p];
                }
            }
        }
    }

    empty
} catch {
    _ => []
}

/**
 * @params:
 *    - line: a single line of a compiler's '--version' output
 * @returns: the version on 'line' if it reads "Midgard version <version> ...", "" otherwise
 * */
pub fn midgardVersionOfLine(line: [c8])-> [c8] {
    versionOfLine(line, "Midgard", "version")
}

/**
 * @params:
 *    - line: a single line of a compiler's '--version' output
 * @returns: the version on 'line' if it reads "Ymir version <version> ...", "" otherwise
 * */
pub fn ymirVersionOfLine(line: [c8])-> [c8] {
    versionOfLine(line, "Ymir", "version")
}

/**
 * @params:
 *    - line: a single line of a compiler's '--version' output
 *    - word0: the first expected word of the line(e.g. "Ymir", "Midgard")
 *    - word1: the second expected word of the line(e.g. "version")
 * @returns: the third word of 'line' when it starts with 'word0 word1 ', "" otherwise
 * */
fn versionOfLine(line: [c8], word0: [c8], word1: [c8])-> [c8] {
    let dmut tzer = Tokenizer!c8();
    tzer:.insert(" ", isSkip-> true);
    let parts = tzer.tokenizeWithoutSkips(line);

    if (parts.len >= 3us && parts[0] == word0 && parts[1] == word1) {
        return parts[2];
    }

    ""
}


/**
 * Argument parser of the gyllir building tool
 * */
pub class GyllirArgumentParser {

    // The main argument parser leading to sub commands
    let dmut _mainParser: &ArgumentParser;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CTORS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self ()
        with _mainParser = copy ArgumentParser()
    {
        self._mainParser:.help("help", short-> "h", comments-> "print this help and exit");
        self._mainParser:.flag("version", short-> "V", comments-> "print version information and exit");

        self._mainParser:.sub("init", cmd-> &self.parseInit, comments-> "initialize a gyllir repository and create the config file.", hyphenated-> false);
        self._mainParser:.sub("build", &self.parseBuild, comments-> "build the project in the current directory", hyphenated-> false);
        self._mainParser:.sub("run", &self.parseRun, comments-> "build the project and run the produced executable", hyphenated-> false);
        self._mainParser:.sub("publish", &self.parsePublish, comments-> "publish a version to the package registry", hyphenated-> false);
        self._mainParser:.sub("clean", &self.parseClean, comments-> "clean the project (remove generated files)", hyphenated-> false);
        self._mainParser:.sub("doc", &self.parseDoc, comments-> "build the documentation", hyphenated-> false);
        self._mainParser:.sub("test", &self.parseTest, comments-> "build and run the unit tests", hyphenated-> false);
    }

    /**
     * Parse the command line and returns the created configuration
     * @returns: the configuration
     * @warning: exits if the configuration was malformed
     * */
    pub fn parse(self, args: [[c8]])-> &Config {
        {
            let ret = self._mainParser.parse(args);
            if let Ok(Bool(value-> _ = true)) = ret["version"]? {
                std::io::println(versionString(compiler-> compilerVersion()));
                etc::c::process::_yrt_exit(0);
                panic;
            }

            let mut found = false;
            for i in ["init", "build", "run", "publish", "clean", "doc", "test"] {
                if (i in ret) {
                    found = true;
                    break;
                }
            }

            if !found {
                std::io::eprintln(self._mainParser.getUsage(usage-> "gyllir"));
                etc::c::process::_yrt_exit(-1);
            }

            ret
        } catch {
            e => {
                std::io::eprintln(self._mainParser.explain(e, usage-> "gyllir"));
                etc::c::process::_yrt_exit(-1);
                panic;
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          SUB COMMANDS          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Parse the init sub command
     * @params:
     *    - args: the argument passed to the sub command
     * */
    prv fn parseInit(self, args: [[c8]])-> (&Config)? {
        let dmut parser = (copy ArgumentParser)
            :.help("help", short-> "h", comments-> "print this help and exit");

        return ({
            parser.parse(args)
        } catch {
            err: &std::config::args::errors::HelpRequestError => {
                std::io::eprintln(parser.explain(err, usage-> "gyllir init"));
                etc::c::process::_yrt_exit(-1);
                panic;
            }
            e => throw e;
        })?;
    }

    /**
     * Parse the build sub command
     * @params:
     *    - args: the argument passed to the sub command
     * */
    prv fn parseBuild(self, args: [[c8]])-> (&Config)? {
        let dmut parser = (copy ArgumentParser)
            :.help("help", short-> "h", comments-> "print this help and exit")
            :.flag("release", comments-> "build the release mode (debug by default)")
            :.option!{i32} ("j", comments-> "number of parallel threads to spawn")
            :.flag("verbose", short-> "v", comments-> "verbose mode");

        let (rest, target) = self.extractTarget(args, copy ["j"]);
        return ({
            self.withTarget(parser.parse(rest), target)
        } catch {
            err: &std::config::args::errors::HelpRequestError => {
                std::io::eprintln(parser.explain(err, usage-> "gyllir build [target]"));
                etc::c::process::_yrt_exit(-1);
                panic;
            }
            e => throw e;
        })?;
    }

    /**
     * parse the run sub command
     * @params:
     *    - args: the argument passed to the sub command
     * */
    prv fn parseRun(self, args: [[c8]])-> (&Config)? {
        let dmut result = copy Array();
        for i in args[1 .. $] { // first element is 'run'
            result:.push(copy Str(i));
        }

        (result)?
    }

    /**
     * Parse the publish sub command
     * @params:
     *    - args: the arguments passed to the sub command
     * */
    prv fn parsePublish(self, args: [[c8]])-> (&Config)? {
        let dmut parser = (copy ArgumentParser)
            :.help("help", short-> "h", comments-> "print this help and exit")
            :.flag("major", comments-> "publish a major version")
            :.flag("minor", comments-> "publish a minor version")
            :.flag("patch", comments-> "publish a patch")
            :.flag("dry", comments-> "do not verify the package before publishing (neither building nor testing)")
            :.flag("yes", short-> "y", comments-> "do not ask for validation")
            :.position!{[c8]} ("message", comments-> "the message of the version");

        return ({
            let res = parser.parse(args);
            let mut nb = 0;
            for i in ["major", "minor", "patch"] {
                if let Ok(Bool(value-> _ = true)) = res[i]? {
                    nb += 1;
                }
            }

            if nb > 1 {
                std::io::eprintln(parser.getUsage(usage-> "gyllir publish"));
                utils::log::error("Error", "flags 'major', 'minor' and 'patch' are exclusive");
                etc::c::process::_yrt_exit(-1);
            }

            res
        } catch {
            err: &std::config::args::errors::HelpRequestError => {
                std::io::println(parser.explain(err, usage-> "gyllir publish"));
                etc::c::process::_yrt_exit(-1);
                panic;
            }
            e => throw e;
        })?;
    }

    /**
     * Parse the clean sub command
     * @params:
     *    - args: the arguments passed to the sub command
     * */
    prv fn parseClean(self, args: [[c8]])-> (&Config)? {
        let dmut parser = (copy ArgumentParser)
            :.help("help", short-> "h", comments-> "print this help and exit")
            :.flag("doc", comments-> "clean the documentation")
            :.flag("all", short-> "a", comments-> "clean all the generated files (including the documentation)");

        return ({
            parser.parse(args)
        } catch {
            err: &std::config::args::errors::HelpRequestError => {
                std::io::eprintln(parser.explain(err, usage-> "gyllir clean"));
                etc::c::process::_yrt_exit(-1);
                panic;
            }
            e => throw e;
        })?;
    }

    /**
     * Parse the documentation generation sub command
     * @params:
     *    - args: the arguments passed to the sub command
     * */
    prv fn parseDoc(self, args: [[c8]])-> (&Config)? {
        let dmut parser = (copy ArgumentParser)
            :.help("help", short-> "h", comments-> "print this help and exit")
            :.flag("verbose", short-> "v", comments-> "verbose mode")
            :.option!{[c8]} ("input", short-> "i", comments-> "input json file already produced by a previous compilation")
            :.option!{[c8]} ("output", short-> "o", comments-> "output directory");

        let (rest, target) = self.extractTarget(args, copy ["input", "i", "output", "o"]);
        return ({
            self.withTarget(parser.parse(rest), target)
        } catch {
            err: &std::config::args::errors::HelpRequestError => {
                std::io::eprintln(parser.explain(err, usage-> "gyllir doc [target]"));
                etc::c::process::_yrt_exit(-1);
                panic;
            }
            e => throw e;
        })?;
    }

    /**
     * Parse the test sub command
     * @params:
     *     - args: the arguments passed to the sub command
     * */
    prv fn parseTest(self, args: [[c8]])-> (&Config)? {
        let dmut parser = (copy ArgumentParser)
            :.help("help", short-> "h", comments-> "print this help and exit")
            :.flag("verbose", short-> "v", comments-> "clean the documentation")
            :.flag("dry", comments-> "only compile the test executable, but does not run them")
            :.flag("release", comments-> "compile tests in release mode (debug by default)")
            :.option!{i32} ("j", comments-> "number of parallel threads to spawn");

        let (rest, target) = self.extractTarget(args, copy ["j"]);
        return ({
            self.withTarget(parser.parse(rest), target)
        } catch {
            err: &std::config::args::errors::HelpRequestError => {
                std::io::eprintln(parser.explain(err, usage-> "gyllir test [target]"));
                etc::c::process::_yrt_exit(-1);
                panic;
            }
            e => throw e;
        })?;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          TARGETS          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Split the optional '<target>' argument of a sub command out of its arguments.
     *
     * The std argument parser has no optional positional argument(every declared position is
     * mandatory), so the target name is taken out of the command line before parsing, and put back
     * into the parsed configuration by 'withTarget'.
     *
     * @params:
     *    - args: the arguments of the sub command, 'args[0]' being its name
     *    - valued: the long and short names of the options of the sub command that take a value, whose
     *      value must not be mistaken for the target name
     * @returns:
     *    - .0: the arguments, without the target name
     *    - .1: the name of the target, "" if the command line names none
     * */
    prv fn extractTarget(self, args: [[c8]], valued: [[c8]])-> ([[c8]], [c8]) {
        let mut rest: [[c8]] = [];
        let mut target = "";

        let mut i = 0us;
        while i < args.len {
            let a = args[i];
            rest ~= [a];

            // the sub command name is 'args[0]', and never a target
            if (i != 0us && a.len > 0us && a[0] == '-') {
                // '-j 4' passes the value in the next argument, '-j=4' in this one
                if (i + 1us < args.len && self.isValued(a, valued)) {
                    i += 1us;
                    rest ~= [args[i]];
                }
            }

            else if (i != 0us && target == "") {
                target = a;
                rest = rest[0 .. $ - 1us];
            }

            i += 1us;
        }

        (rest, target)
    }

    /**
     * @params:
     *    - arg: a hyphenated argument of the command line
     *    - valued: the names of the options taking a value
     * @returns: true iif 'arg' names one of them, and takes its value in the next argument
     * */
    prv fn isValued(self, arg: [c8], valued: [[c8]])-> bool {
        let mut name = arg;
        while name.len > 0us && name[0] == '-' {
            name = name[1us .. $];
        }

        // '--opt=value' carries its value, the next argument is not one
        for c in name if c == '=' {
            return false;
        }

        for v in valued if v == name {
            return true;
        }

        false
    }

    /**
     * @params:
     *    - cfg: the configuration parsed for a sub command
     *    - target: the name of the target extracted from its command line
     * @returns: 'cfg', with a 'target' entry when the command line named one
     * */
    prv fn withTarget(self, cfg: &Config, target: [c8])-> &Config {
        if (target == "") { return cfg; }

        let dmut res = copy Dict();
        if let d: &Dict = cfg {
            for k, v in d[] {
                res[k] = v;
            }
        }

        res["target"] = copy Str(target);
        res
    }

}
