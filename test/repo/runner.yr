use ::repo::fixture;
use gyllir::repo::runner;
use gyllir::config::_;

use std::config::_;
use std::config::json;
use std::concurrency::process;
use std::fs::_;

/**
 * Write an executable shell script exiting with a given code, standing in for an artifact that
 * 'RepoRunner' would have built
 * @params:
 *    - dir: the directory holding the script
 *    - name: the name of the script
 *    - code: the exit code, as it is written in the script
 * */
fn mkArtifact(dir: Path, name: [c8], code: [c8])
    throws FsError
{
    let dmut f = File::create(dir.push(name), write-> true);
    f:.write("#!/bin/sh\nexit " ~ code ~ "\n");
    f:.close();

    let dmut proc = copy SubProcess("chmod", copy ["+x", dir.push(name).toStr()], cwd-> dir);
    proc:.start();
    proc:.wait();
}

/**
 * Write an executable shell script that records the arguments it was called with, standing in for
 * an artifact that forwards its command line to a file 'run()' can then assert on
 * @params:
 *    - dir: the directory holding the script
 *    - name: the name of the script
 *    - witness: the name of the file the script writes its arguments to
 * */
fn mkArgRecordingArtifact(dir: Path, name: [c8], witness: [c8])
    throws FsError
{
    let dmut f = File::create(dir.push(name), write-> true);
    f:.write("#!/bin/sh\necho \"$@\" > " ~ witness ~ "\n");
    f:.close();

    let dmut proc = copy SubProcess("chmod", copy ["+x", dir.push(name).toStr()], cwd-> dir);
    proc:.start();
    proc:.wait();
}

/**
 * Write an executable shell script that kills itself with a signal, standing in for an artifact
 * that crashes instead of exiting normally
 * @params:
 *    - dir: the directory holding the script
 *    - name: the name of the script
 * */
fn mkSignalKilledArtifact(dir: Path, name: [c8])
    throws FsError
{
    let dmut f = File::create(dir.push(name), write-> true);
    f:.write("#!/bin/sh\nkill -9 $$\n");
    f:.close();

    let dmut proc = copy SubProcess("chmod", copy ["+x", dir.push(name).toStr()], cwd-> dir);
    proc:.start();
    proc:.wait();
}

__test reject_library_target_run {
    // run() on a library target (not forUnitTest) rejects before doing anything else
    let cfg = GyllirPackageConfiguration(
        "mylib", "MIT", "d", BuildType("library"), Url("local:some/registry"), Version(1u32, 0u32, 0u32), []
    );

    let runner = RepoRunner(Path("."), copy Dict(), cfg, soleTarget(cfg), false);

    let mut msg = "";
    {
        runner.run();
    } catch {
        a: &AssertError => { msg = a.msg; }
        _: &FsError => { msg = ""; }
    }

    assert(msg == "target 'mylib' is a library, 'gyllir run' only runs an executable target",
           "unexpected error: " ~ msg);
}

__test run_returns_artifact_exit_code {
    // The runner returns the exit code of the artifact instead of exiting itself, so that
    // 'gyllir test' can run the tests of every target before failing on the first one that did not pass
    let dir = sys::tempDirectory(prefix-> "gyllir_runner_test_");
    let cfg = mkConfig("myapp", "executable");
    mkArtifact(dir, "myapp", "0");

    assert(RepoRunner(dir, copy Dict(), cfg, soleTarget(cfg), false).run() == 0, "a passing artifact should report 0");

    mkArtifact(dir, "myapp", "3");
    assert(RepoRunner(dir, copy Dict(), cfg, soleTarget(cfg), false).run() == 3, "the exit code of the artifact should be reported");
}

__test unittest_run_executes_test_binary {
    // A unittest run executes "<output>.test", not the artifact itself
    let dir = sys::tempDirectory(prefix-> "gyllir_runner_test_");
    let cfg = mkConfig("myapp", "executable");
    mkArtifact(dir, "myapp", "1");
    mkArtifact(dir, "myapp.test", "0");

    assert(RepoRunner(dir, copy Dict(), cfg, soleTarget(cfg), true).run() == 0, "the unittest executable should be the one run");
}

__test run_executes_renamed_output_artifact {
    // The runner executes the artifact of the target, which "output" may have renamed
    let dir = sys::tempDirectory(prefix-> "gyllir_runner_test_");
    let cfg = mkTargetsConfig("myapp", json#{"app" : {"output" : "renamed"}});
    mkArtifact(dir, "renamed", "5");

    assert(RepoRunner(dir, copy Dict(), cfg, namedTarget(cfg, "app"), false).run() == 5,
           "the runner should execute the artifact named by \"output\"");
}

__test library_target_unittest_runs_normally {
    // A library target is only a library for 'gyllir run': its unittest executable is run like any other
    let dir = sys::tempDirectory(prefix-> "gyllir_runner_test_");
    let cfg = mkTargetsConfig("multi", json#{"mylib" : {"type" : "library"}});
    mkArtifact(dir, "mylib.test", "2");

    assert(RepoRunner(dir, copy Dict(), cfg, namedTarget(cfg, "mylib"), true).run() == 2,
           "the unittest executable of a library target should be run");
}

__test run_forwards_command_line_arguments_to_the_artifact {
    // 'gyllir run' forwards its own command line to the artifact it runs
    let dir = sys::tempDirectory(prefix-> "gyllir_runner_test_");
    let cfg = mkConfig("myapp", "executable");
    mkArgRecordingArtifact(dir, "myapp", "witness.txt");

    let dmut args = copy Array();
    args:.push(copy Str("--some-flag"));
    args:.push(copy Str("positional"));

    assert(RepoRunner(dir, args, cfg, soleTarget(cfg), false).run() == 0, "the recording artifact should exit 0");

    let dmut f = File::open(dir.push("witness.txt"), read-> true);
    let content = f:.readAll();
    f:.close();

    assert(content == "--some-flag positional\n", "unexpected forwarded arguments: \"" ~ content ~ "\"");
}

__test run_reports_signal_as_128_plus_signal_number {
    // A run() killed by a signal reports "128 + <signal>", the way a shell does, rather than 0
    let dir = sys::tempDirectory(prefix-> "gyllir_runner_test_");
    let cfg = mkConfig("myapp", "executable");
    mkSignalKilledArtifact(dir, "myapp");

    assert(RepoRunner(dir, copy Dict(), cfg, soleTarget(cfg), false).run() == 128 + 9,
           "a SIGKILL'd artifact should report 128 + 9");
}
