use ::repo::fixture;
use gyllir::config::_;
use gyllir::repo::cleaner;

use std::{config, config::json, fs};

__test clean_doc_removes_doc_directory {
    // cleanDoc() removes the "__doc" directory under the repo's cwd
    let dir    = fs::tempDirectory(prefix-> "gyllir_cleaner_test_");
    let docDir = dir.push("__doc");
    fs::createDir(docDir);
    let dmut f = File::create(docDir.push("index.html"), write-> true);
    f:.write("hello");
    f:.close();

    assert(fs::isDir(docDir), "sanity: __doc should exist before cleaning");

    let cfg     = GyllirPackageConfiguration::empty();
    let cleaner = RepoCleaner(dir, copy Dict(), cfg);
    cleaner.cleanDoc();

    assert(!fs::isDir(docDir), "cleanDoc() should remove the __doc directory");
}

__test clean_outputs_removes_target_and_executable {
    // cleanOutputs() removes .target, and the built executable/test file named after the config
    let dir       = fs::tempDirectory(prefix-> "gyllir_cleaner_test_");
    let targetDir = dir.push(".target");
    fs::createDir(targetDir);

    let cfg = GyllirPackageConfiguration("myexe",
                                         "MIT",
                                         "d",
                                         BuildType("executable"),
                                         Version(1u32, 0u32, 0u32),
                                         []);

    let exePath = dir.push("myexe");
    let dmut ef = File::create(exePath, write-> true);
    ef:.write("binary");
    ef:.close();

    let testPath = dir.push("myexe").addExtension("test");
    let dmut tf  = File::create(testPath, write-> true);
    tf:.write("test binary");
    tf:.close();

    let cleaner = RepoCleaner(dir, copy Dict(), cfg);
    cleaner.cleanOutputs();

    assert(!fs::isDir(targetDir), "cleanOutputs() should remove the .target directory");
    assert(!fs::isFile(exePath), "cleanOutputs() should remove the built executable");
    assert(!fs::isFile(testPath), "cleanOutputs() should remove the built test executable");
}

__test clean_outputs_removes_library_archive {
    // For a library config, cleanOutputs() removes "lib<name>.a" instead of a bare executable
    let dir = fs::tempDirectory(prefix-> "gyllir_cleaner_test_");
    let cfg = GyllirPackageConfiguration("mylib",
                                         "MIT",
                                         "d",
                                         BuildType("library"),
                                         Version(1u32, 0u32, 0u32),
                                         []);

    let libPath = dir.push("libmylib.a");
    let dmut f  = File::create(libPath, write-> true);
    f:.write("archive");
    f:.close();

    let cleaner = RepoCleaner(dir, copy Dict(), cfg);
    cleaner.cleanOutputs();

    assert(!fs::isFile(libPath), "cleanOutputs() should remove the built library archive");
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          TARGETS          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

__test clean_outputs_removes_all_target_artifacts {
    // cleanOutputs() removes the artifact and the unittest executable of every declared target,
    // whatever "output" named them
    let dir = fs::tempDirectory(prefix-> "gyllir_cleaner_test_");
    let cfg = mkTargetsConfig("multi", json #{
        "mylib" : {"type" : "library"},
        "cli" : {"type" : "executable"},
        "tool" : {"type" : "executable", "output" : "renamed"}
    });

    for name in copy ["libmylib.a", "mylib.test", "cli", "cli.test", "renamed", "renamed.test"] {
        let dmut f = File::create(dir.push(name), write-> true);
        f:.write("an artifact");
        f:.close();
    }

    fs::createDir(dir.push(".target").push("cli"), recursive-> true);

    RepoCleaner(dir, copy Dict(), cfg).cleanOutputs();

    assert(!fs::isDir(dir.push(".target")), "the build cache of every target should be removed");
    for name in copy ["libmylib.a", "mylib.test", "cli", "cli.test", "renamed", "renamed.test"] {
        assert(!fs::isFile(dir.push(name)), "the artifact \"" ~ name ~ "\" should have been removed");
    }
}

__test clean_outputs_missing_artifact_is_not_error {
    // The artifact of a target that was never built is simply not there, cleaning is not an error
    let dir = fs::tempDirectory(prefix-> "gyllir_cleaner_test_");
    let cfg = mkTargetsConfig("multi", json #{"cli" : {"type" : "executable"}});

    RepoCleaner(dir, copy Dict(), cfg).cleanOutputs();

    assert(!fs::isFile(dir.push("cli")), "nothing should have been produced by a clean");
}
