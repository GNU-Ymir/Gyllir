use gyllir::repo::doc_server;

/**
 * @returns: a page as 'res/html/footer.html' generates it
 * */
prv fn page(config: [c8])-> [c8] {
    "<body>\n  <script>\n    " ~ config ~ "\n  </script>\n</body>\n"
}

__test serve_flag_is_added_to_the_page_configuration {
    // A served page tells its javascript to query '/symbol' instead of searching itself only
    let served = doc_server::withServeFlag(page("window.GYLLIR_DOC = { title: \"app\", sourceRepo: \"\" };"));

    assert(served == page("window.GYLLIR_DOC = { serve: true, title: \"app\", sourceRepo: \"\" };"),
           "the flag should be added to the configuration object, leaving the rest of the page alone");
}

__test a_page_without_configuration_is_served_untouched {
    // A page generated by another version of gyllir declares no such object : it is served as is,
    // its search box just stays local to the page
    let content = page("var Title = 'app';");

    assert(doc_server::withServeFlag(content) == content, "the page should be left untouched");
}
