/**
 * Helpers shared by the integration tests of the 'repo' sub commands: they materialize a real,
 * tiny gyllir project in a temporary directory, so 'RepoBuilder'/'GyllirManager' & co can be
 * driven end to end against the real 'gyc' toolchain rather than against mocks.
 * */

use gyllir::{config::_, utils::_};
use gyllir::repo::defaults;

use std::{config::_, config::json, config::toml, fs::_};
use std::concurrency::process;
use std::conv::errors;

/**
 * Write 'content' to 'path', creating the parent directory if needed
 * */
pub fn writeSource(path: Path, content: [c8])
    throws FsError
{
    if !sys::isDir(path.parent()) {
        sys::createDir(path.parent(), recursive-> true);
    }

    let dmut f = File::create(path, write-> true);
    f:.write(content);
    f:.close();
}

/**
 * A minimal executable project: 'src/main.yr' printing a constant
 * @params:
 *    - name: the package name, also the name of the produced executable
 * @returns: the root directory of the created project
 * */
pub fn mkExecutableProject(name: [c8])-> Path
    throws FsError
{
    let dir = sys::tempDirectory(prefix-> "gyllir_it_");
    writeSource(dir.push(defaults::__SRC_DIR__).push(defaults::__MAIN_FILE__),
                "use std::io;\n\nfn main() {\n    println(\"hello from " ~ name ~ "\");\n}\n");

    dir
}

/**
 * A minimal library project: 'src/__lib__.yr' exporting a single function.
 * '__lib__.yr' is the naming convention 'findRootSourceFile' falls back to for a library when no
 * 'package-root' is configured, regardless of the package name.
 * @returns: the root directory of the created project
 * */
pub fn mkLibraryProject()-> Path
    throws FsError
{
    let dir = sys::tempDirectory(prefix-> "gyllir_it_");
    writeSource(dir.push(defaults::__SRC_DIR__).push(defaults::__LIB_FILE__),
                "pub mod helper;\n\npub fn root()-> i32 {\n    42\n}\n");
    writeSource(dir.push(defaults::__SRC_DIR__).push("helper").addExtension(defaults::__YMIR_EXTENSION__),
                "pub fn helper()-> i32 {\n    1\n}\n");

    dir
}

/**
 * Add a 'test/__test__.yr' root holding one always-passing unittest to an existing project
 * */
pub fn addUnitTests(dir: Path)
    throws FsError
{
    // the asserted value is read at runtime: gyc rejects an assertion it can prove statically
    writeSource(dir.push(defaults::__TEST_DIR__).push(defaults::__FST_TEST_FILE__),
                "use std::env;\n\n__test {\n    assert(currentDir().toStr().len > 0us, \"the fixture unittest should pass\");\n}\n");
}

/**
 * A configuration for a project laid out by 'mkExecutableProject'/'mkLibraryProject'
 * @params:
 *    - name: the package name
 *    - type: "executable" or "library"
 * */
pub fn mkConfig(name: [c8], type: [c8])-> GyllirPackageConfiguration
    throws AssertError
{
    GyllirPackageConfiguration(name, "MIT", "an integration test project", BuildType(type),
                               Url("local:some/registry"), Version(1u32, 0u32, 0u32), [])
}

/**
 * @returns: true iif 'dir' contains a readable file at 'rel'
 * */
pub fn hasFile(dir: Path, rel: [c8])-> bool {
    sys::isFile(dir.push(rel))
}

/**
 * @returns: true iif the build cache of a target contains a readable file
 * @params:
 *    - dir: the root directory of the project
 *    - target: the name of the target
 *    - kind: the kind of build, one of the '__CACHE_*_DIR__' sub directories
 *    - rel: the path of the file, relative to '<dir>/.target/<target>/<kind>'
 * */
pub fn hasCacheFile(dir: Path, target: [c8], kind: [c8], rel: [c8])-> bool {
    sys::isFile(defaults::targetCacheDir(dir, target, kind).push(rel))
}

/**
 * The single target of a package declaring no '[targets.<name>]' table, the one synthesized from
 * its top level fields
 * @throws:
 *    - AssertError: if the package declares targets of its own
 * */
pub fn soleTarget(cfg: GyllirPackageConfiguration)-> Target
    throws AssertError
{
    if let Ok(t) = cfg.targets()[cfg.name] {
        return t;
    }

    throw copy AssertError("the package declares no target named after itself");
}

/**
 * @params:
 *    - cfg: the configuration of a package declaring targets
 *    - name: the name of one of them
 * @throws:
 *    - AssertError: if the package declares no such target
 * */
pub fn namedTarget(cfg: GyllirPackageConfiguration, name: [c8])-> Target
    throws AssertError
{
    if let Ok(t) = cfg.targets()[name] {
        return t;
    }

    throw copy AssertError("the package declares no target '" ~ name ~ "'");
}

/**
 * A command line configuration
 * @params:
 *    - flags: the name of the boolean flags to set to true
 * */
pub fn mkArgs(flags: [[c8]])-> &Config {
    let dmut d = copy Dict();
    for f in flags {
        d[f] = copy Bool(true);
    }

    d
}

/**
 * The command line configuration used by the tests that actually compile something: it pins the
 * compilation to a single thread
 * @warning: the coverage runtime is not thread safe, it segfaults when the task pool of
 *   'compileFilesToYIL' hits it from two workers at once, so a covered test run must not spawn more
 *   than one of them
 * @params:
 *    - flags: the name of the boolean flags to set to true
 * */
pub fn mkBuildArgs(flags: [[c8]] = [])-> &Config {
    let dmut d = copy Dict();
    for f in flags {
        d[f] = copy Bool(true);
    }

    d["j"] = copy Int(1i64);

    d
}

/**
 * Write the 'gyllir.toml' of a project, so that it can be resolved as a dependency
 * */
pub fn writeToml(dir: Path, cfg: GyllirPackageConfiguration)
    throws FsError
{
    let dmut f = File::create(dir.push(defaults::__GYLLIR_CONFIG_FILENAME__), write-> true);
    f:.write(std::config::toml::dump(cfg.serialize()));
    f:.close();
}

/**
 * Turn 'dir' into a git repository, with everything it contains committed on the default branch.
 * A dependency is always resolved through git, so even a 'local:' one has to be a repository
 * */
pub fn gitInit(dir: Path)
    throws GitError, FsError
{
    let git = GitManager(cwd-> dir);
    git.init();

    // some environments sign commits globally, which fails non interactively
    let dmut proc = copy SubProcess("git", copy ["config", "commit.gpgsign", "false"], cwd-> dir);
    proc:.start();
    proc:.wait();

    git.add(dir.push("."));
    git.commit("initial commit");
}

/**
 * A configuration declaring a single local dependency, whose version filter accepts anything
 * @params:
 *    - name: the package name
 *    - type: "executable" or "library"
 *    - depName: the name of the dependency
 *    - depPath: the directory holding the dependency
 *    - version: the version filter of the dependency, accepting anything by default
 * */
pub fn mkConfigWithDependency(name: [c8], type: [c8], depName: [c8], depPath: Path, version: [c8] = "*")-> GyllirPackageConfiguration
    throws AssertError
{
    let dmut url = copy Dict();
    url["local"] = copy Str(depPath.toStr());

    let dmut dep = copy Dict();
    dep["version"] = copy Str(version);
    dep["url"] = url;

    let dmut deps = copy Dict();
    deps[depName] = dep;

    let dmut cfg = copy Dict();
    cfg["name"] = copy Str(name);
    cfg["license"] = copy Str("MIT");
    cfg["description"] = copy Str("an integration test project");
    cfg["type"] = copy Str(type);
    cfg["version"] = copy Str("1.0.0");
    cfg["registry"] = copy Str("local:some/registry");
    cfg["dependencies"] = deps;

    GyllirPackageConfiguration(cfg)
}

/**
 * A project holding three targets over a single source directory: a library 'mylib', an executable
 * 'cli' linking it, and an executable 'tool' linking nothing.
 * @info: the library is deliberately not named 'core', which collides with the module of the
 *   runtime and cannot be imported
 * @returns: the root directory of the created project
 * */
pub fn mkMultiTargetProject()-> Path
    throws FsError
{
    let dir = sys::tempDirectory(prefix-> "gyllir_it_multi_");
    let src = dir.push(defaults::__SRC_DIR__);

    writeSource(src.push("mylib").addExtension(defaults::__YMIR_EXTENSION__),
                "pub mod ::helper;\n\npub fn root()-> i32 {\n    42\n}\n");
    writeSource(src.push("mylib").push("helper").addExtension(defaults::__YMIR_EXTENSION__),
                "pub fn helper()-> i32 {\n    1\n}\n");

    // 'cli' reaches the library through the '-I' of the target it links
    writeSource(src.push("cli").addExtension(defaults::__YMIR_EXTENSION__),
                "use std::io;\nuse mylib;\n\nfn main() {\n    println(\"cli says \", mylib::root());\n}\n");
    writeSource(src.push("tool").addExtension(defaults::__YMIR_EXTENSION__),
                "use std::io;\n\nfn main() {\n    println(\"tool\");\n}\n");

    dir
}

/**
 * The configuration of a project laid out by 'mkMultiTargetProject'
 * */
pub fn mkMultiTargetConfig()-> GyllirPackageConfiguration
    throws AssertError
{
    GyllirPackageConfiguration(json#{
        "name" : "multi",
        "license" : "MIT",
        "description" : "an integration test project",
        "version" : "1.0.0",
        "registry" : {"local" : "some/registry"},
        "targets" : {
            "mylib" : {"type" : "library"},
            "cli" : {"type" : "executable", "targets" : ["mylib"]},
            "tool" : {"type" : "executable"}
        }
    })
}

/**
 * A library project holding two independent library targets over a single source directory: 'foo'
 * and 'bar' (producing 'libfoo.a'/'libbar.a'), neither linking the other.
 * @info: target names are deliberately not prefixed with 'lib' themselves -- the artifact naming
 *   already adds that prefix ('lib' ~ outputName), so a target named 'libfoo' would produce
 *   'liblibfoo.a'
 * @returns: the root directory of the created project
 * */
pub fn mkMultiLibProject()-> Path
    throws FsError
{
    let dir = sys::tempDirectory(prefix-> "gyllir_it_multilib_");
    let src = dir.push(defaults::__SRC_DIR__);

    writeSource(src.push("foo").addExtension(defaults::__YMIR_EXTENSION__),
                "pub fn foo()-> i32 {\n    1\n}\n");
    writeSource(src.push("bar").addExtension(defaults::__YMIR_EXTENSION__),
                "pub fn bar()-> i32 {\n    2\n}\n");

    dir
}

/**
 * The configuration of a project laid out by 'mkMultiLibProject'
 * */
pub fn mkMultiLibConfig()-> GyllirPackageConfiguration
    throws AssertError
{
    GyllirPackageConfiguration(json#{
        "name" : "multilib",
        "license" : "MIT",
        "description" : "an integration test project",
        "version" : "1.0.0",
        "registry" : {"local" : "some/registry"},
        "targets" : {
            "foo" : {"type" : "library"},
            "bar" : {"type" : "library"}
        }
    })
}

/**
 * A configuration declaring a single local dependency, with an explicit "link-targets" selection
 * over the sub-targets it links
 * @params:
 *    - name: the package name
 *    - type: "executable" or "library"
 *    - depName: the name of the dependency
 *    - depPath: the directory holding the dependency
 *    - targets: the names of the dependency's targets to select
 * */
pub fn mkConfigWithSelectedDependency(name: [c8], type: [c8], depName: [c8], depPath: Path, targets: [[c8]])-> GyllirPackageConfiguration
    throws AssertError
{
    let dmut url = copy Dict();
    url["local"] = copy Str(depPath.toStr());

    let dmut dep = copy Dict();
    dep["version"] = copy Str("*");
    dep["url"] = url;
    dep["link-targets"] = copy Array(copy [copy Str(t) for t in targets]);

    let dmut deps = copy Dict();
    deps[depName] = dep;

    let dmut cfg = copy Dict();
    cfg["name"] = copy Str(name);
    cfg["license"] = copy Str("MIT");
    cfg["description"] = copy Str("an integration test project");
    cfg["type"] = copy Str(type);
    cfg["version"] = copy Str("1.0.0");
    cfg["registry"] = copy Str("local:some/registry");
    cfg["dependencies"] = deps;

    GyllirPackageConfiguration(cfg)
}

/**
 * A configuration declaring targets, and optionally a single local dependency for them to select
 * @params:
 *    - name: the package name
 *    - targets: the content of the '[targets.*]' tables
 *    - depName: the name of the dependency, "" for a package declaring none
 *    - depPath: the directory holding the dependency
 * */
pub fn mkTargetsConfig(name: [c8], targets: &Config, depName: [c8] = "", depPath: Path = Path(""))-> GyllirPackageConfiguration
    throws AssertError
{
    let dmut cfg = copy Dict();
    cfg["name"] = copy Str(name);
    cfg["license"] = copy Str("MIT");
    cfg["description"] = copy Str("an integration test project");
    cfg["version"] = copy Str("1.0.0");
    cfg["registry"] = copy Str("local:some/registry");
    cfg["targets"] = targets;

    if (depName != "") {
        let dmut url = copy Dict();
        url["local"] = copy Str(depPath.toStr());

        let dmut dep = copy Dict();
        dep["version"] = copy Str("*");
        dep["url"] = url;

        let dmut deps = copy Dict();
        deps[depName] = dep;
        cfg["dependencies"] = deps;
    }

    GyllirPackageConfiguration(cfg)
}

/**
 * A project holding a library target 'mylib' that compiles a C source through a recursive glob,
 * bound by a single Ymir module, and an executable target 'cli' linking it and exiting with the
 * value the C code computes: a passing run with that exact exit code proves the C source was
 * actually compiled, archived, and linked
 * @returns: the root directory of the created project
 * */
pub fn mkCSourceProject()-> Path
    throws FsError
{
    let dir = sys::tempDirectory(prefix-> "gyllir_it_csrc_");
    let src = dir.push(defaults::__SRC_DIR__);

    writeSource(src.push("mylib").addExtension(defaults::__YMIR_EXTENSION__),
                "extern (C) fn c_answer()-> i32;\n\npub fn answer()-> i32 {\n    return c_answer();\n}\n");
    writeSource(src.push("cli").addExtension(defaults::__YMIR_EXTENSION__),
                "use mylib;\n\nfn main()-> i32 {\n    return mylib::answer();\n}\n");

    writeSource(dir.push("csrc").push("nested").push("answer").addExtension(defaults::__C_EXTENSION__),
                "int c_answer(void) {\n    return 42;\n}\n");

    dir
}

/**
 * The configuration of a project laid out by 'mkCSourceProject': the library target declares its
 * C source through the recursive glob under the 'csrc' directory
 * */
pub fn mkCSourceConfig()-> GyllirPackageConfiguration
    throws AssertError
{
    GyllirPackageConfiguration(json#{
        "name" : "csrc-demo",
        "license" : "MIT",
        "description" : "an integration test project",
        "version" : "1.0.0",
        "registry" : {"local" : "some/registry"},
        "targets" : {
            "mylib" : {"type" : "library", "c-sources" : ["csrc/**/*.c"]},
            "cli" : {"type" : "executable", "targets" : ["mylib"]}
        }
    })
}

/**
 * The sources of a project exercising most of the constructs the documentation generator knows
 * about: every kind of symbol, every kind of type, and doc comments using the markup of
 * 'gyllir::doc::comment'
 * */
def __RICH_ROOT__ = str#{/**
 * A module exercising most of the constructs the documentation generator knows about.
 * */

use std::io;

pub mod ::sub;

/**
 * A documented alias
 * */
pub def MAX_SIZE = 1024;

/**
 * A lazy global
 * @warning: it is lazy
 * */
pub lazy COUNT: i32 = 0;

/**
 * An enumeration
 * */
pub enum Color: i32
| RED = 0
| GREEN = 1;

/**
 * A documented function
 * @params:
 *    - a: the first one
 *    - b: the second one
 * @returns: their sum
 * @throws:
 *    - AssertError: never
 * @example:
 * ```
 * let x = add(1, 2);
 * ```
 * */
pub fn add(a: i32, b: i32 = 0)-> i32
    throws AssertError
{
    assert(a + b >= a, "no overflow");
    a + b
}

/**
 * A templated function
 * */
pub fn if (isIntegral!{T}) generic {T} (x: T)-> T {
    x
}

/**
 * A trait
 * */
pub trait Printable {
    pub fn print(self);
}

/**
 * A documented class
 * */
@final
pub class Foo {

    cte assert(true, "always");

    // the wrapped value
    prv let mut _value: i32 = 0;

    /**
     * Build a Foo
     * */
    pub self (value: i32) with _value = value {}

    /**
     * @returns: the wrapped value
     * */
    @field
    pub fn value(self)-> i32 {
        self._value
    }

    /**
     * A templated method
     * */
    pub fn conv {T} (self)-> T {
        cast!T (self._value)
    }

    impl Printable {
        pub over print(self) {
            println(self._value);
        }
    }
}

/**
 * A record with a mutable field
 * */
pub record Pair {
    pub let mut fst: i32 = 0;
    pub let mut snd: [c8] = "";

    pub self () {}
}

/**
 * A macro
 * */
pub macro mymacro {

    /**
     * The constructor rule of the macro
     * */
    self (a=(__expr)) skips (" " | "\n") #{ #{a} }

    /**
     * Another rule of the macro
     * */
    fn rule (a=(__expr)) skips (" ") #{ #{a} }
}

/**
 * Every kind of type in a single signature
 * */
pub fn types(arr: [i32 ; 3], sli: [u8], mp: [i32 => f64], tup: (i32, bool),
             opt: (i32)?, ptr: *void, fp: fn (i32)-> bool,
             c: &Foo, e: Color)-> void
{
    arr; sli; mp; tup; opt; ptr; fp; c; e;
}

fn main() {
    println("hello");
}
};

def __RICH_SUB__ = str#{/**
 * A sub module
 * */

/**
 * A function of the sub module
 * */
pub fn helper()-> i32 { 1 }
};

/**
 * A project whose sources hold one declaration of about every kind, so that 'gyllir doc' can be
 * driven over a realistic documentation tree
 * @returns: the root directory of the created project
 * */
pub fn mkRichProject()-> Path
    throws FsError
{
    let dir = sys::tempDirectory(prefix-> "gyllir_it_rich_");
    writeSource(dir.push(defaults::__SRC_DIR__).push(defaults::__MAIN_FILE__), __RICH_ROOT__);
    writeSource(dir.push(defaults::__SRC_DIR__).push("main").push("sub").addExtension(defaults::__YMIR_EXTENSION__), __RICH_SUB__);

    dir
}
