use ::repo::fixture;
use gyllir::repo::manager;
use gyllir::repo::builder;
use gyllir::repo::cleaner;
use gyllir::repo::defaults;
use gyllir::config::_;
use gyllir::config::version::filter;
use gyllir::utils::errors;
use gyllir::utils::git;

use std::config::_;
use std::config::json;
use std::concurrency::process;
use std::fs::_;
use std::stream;

/**
 * The library targets of a package as 'resolveDependency' would compute them: every declared
 * target that is not an executable one
 * */
fn libTargetsOf(cfg: GyllirPackageConfiguration)-> [[c8] => ()] {
    let dmut res: [[c8] => ()] = copy [];
    for k, t in cfg.targets() if !t.type.isExecutable() {
        res[k] = ();
    }

    res
}

__test to_version_list_dedups_and_skips_detached {
    // toVersionList(): dedups, skips "(HEAD detached...)" markers, and parses each entry as a Version
    // args[0] is treated as the program name and skipped by the argument parser, so it must be
    // present (any value) alongside the real subcommand, e.g. ["gyllir", "clean"]
    let mgr = copy GyllirManager(copy ["gyllir", "clean"]);

    let list = "master\n(HEAD detached at abc123)\nv1.0.0\nv1.0.0\nv2.0.0\n";
    let versions = mgr.toVersionList(list);

    assert(versions.len == 3us, "expected 3 unique, non-detached versions");
    assert(versions[0]._1 == "master" && versions[0]._0[] == "master", "unexpected first entry");
    assert(versions[1]._1 == "v1.0.0" && versions[1]._0[] == "1.0.0", "unexpected second entry");
    assert(versions[2]._1 == "v2.0.0" && versions[2]._0[] == "2.0.0", "unexpected third entry (duplicate v1.0.0 should be dropped)");
}

__test to_version_list_empty_input {
    // toVersionList() on an empty list returns an empty list
    let mgr = copy GyllirManager(copy ["gyllir", "clean"]);
    let versions = mgr.toVersionList("");

    assert(versions.len == 0us, "an empty tag list should produce no versions");
}

__test run_process_reports_exit_success_and_failure {
    // runProcess() runs a real subprocess and reports success/failure via its exit code
    let mgr = copy GyllirManager(copy ["gyllir", "clean"]);

    assert(mgr.runProcess("true", []), "\"true\" should report success");
    assert(!mgr.runProcess("false", []), "\"false\" should report failure");
}

__test run_process_missing_command_reports_failure {
    // runProcess() on a command that doesn't exist reports failure rather than throwing
    let mgr = copy GyllirManager(copy ["gyllir", "clean"]);

    assert(!mgr.runProcess("this-command-does-not-exist-xyz", []), "a missing command should report failure, not throw");
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ==================================          INTEGRATION          ===================================
 * ====================================================================================================
 * ====================================================================================================
 * Dependency resolution, driven end to end on the tiny projects materialized by 'repo::fixture'
 */

__test local_dependency_symlinked_built_and_exported {
    // A local dependency is symlinked into ".deps", built, and exported to the dependent project
    let lib = mkLibraryProject();
    writeToml(lib, mkConfig("mylib", "library"));
    gitInit(lib);

    let app = mkExecutableProject("myapp");
    let cfg = mkConfigWithDependency("myapp", "executable", "mylib", lib);
    let dmut mgr = copy GyllirManager(copy ["gyllir", "build"]);

    let (includes, links) = RepoBuilder(app, mkBuildArgs(), cfg, soleTarget(cfg), forUnitTest-> false).run(alias mgr);

    assert(sys::isLink(app.push(defaults::__DEPENCY_DIR__).push("mylib")), "a local dependency should be symlinked into .deps");
    assert(hasFile(lib, "libmylib.a"), "the dependency should have been built");

    assert(includes.len == 2us, "both the dependency root file and the project's own should be exported");
    // the dependency is built through its symlink, so it exports paths rooted in ".deps"
    let depPath = app.push(defaults::__DEPENCY_DIR__).push("mylib");
    assert(includes[0] == depPath.push(defaults::__SRC_DIR__).push(defaults::__LIB_FILE__), "unexpected dependency root file");
    assert(links.len == 1us && links[0] == depPath.push("libmylib.a"), "the dependency archive should be linked");
    assert(hasFile(app, "myapp"), "the executable should be produced");
}

__test resolving_dependency_twice_reuses_symlink {
    // Resolving the same dependency twice in a row reuses the symlink instead of failing on it
    let lib = mkLibraryProject();
    writeToml(lib, mkConfig("mylib", "library"));
    gitInit(lib);

    let app = mkExecutableProject("myapp");
    let cfg = mkConfigWithDependency("myapp", "executable", "mylib", lib);
    let dmut mgr = copy GyllirManager(copy ["gyllir", "build"]);

    RepoBuilder(app, mkBuildArgs(), cfg, soleTarget(cfg), forUnitTest-> false).run(alias mgr);
    RepoBuilder(app, mkBuildArgs(), cfg, soleTarget(cfg), forUnitTest-> false).run(alias mgr);

    assert(sys::isLink(app.push(defaults::__DEPENCY_DIR__).push("mylib")), "the dependency symlink should still be there");
    assert(hasFile(app, "myapp"), "the executable should be produced");
}

__test dependency_cycle_is_reported {
    // A dependency cycle is reported instead of being followed forever
    let lib = mkLibraryProject();
    writeToml(lib, mkConfigWithDependency("selfdep", "library", "selfdep", lib));
    gitInit(lib);

    let app = mkExecutableProject("myapp");
    let cfg = mkConfigWithDependency("myapp", "executable", "selfdep", lib);
    let dmut mgr = copy GyllirManager(copy ["gyllir", "build"]);

    let target = soleTarget(cfg);
    let mut threw = false;
    {
        RepoBuilder(app, mkBuildArgs(), cfg, target, forUnitTest-> false).run(alias mgr);
    } catch {
        _: &RecursiveDependency => { threw = true; }
    }

    assert(threw, "a dependency depending on itself should be reported as recursive");
}

__test clean_all_removes_dependencies_recursively {
    // "clean --all" removes the outputs, the documentation and the resolved dependencies, recursively
    let lib = mkLibraryProject();
    writeToml(lib, mkConfig("mylib", "library"));
    gitInit(lib);

    let app = mkExecutableProject("myapp");
    let cfg = mkConfigWithDependency("myapp", "executable", "mylib", lib);
    let dmut mgr = copy GyllirManager(copy ["gyllir", "build"]);

    RepoBuilder(app, mkBuildArgs(), cfg, soleTarget(cfg), forUnitTest-> false).run(alias mgr);
    assert(hasFile(lib, "libmylib.a"), "sanity: the dependency should have been built");

    RepoCleaner(app, mkArgs(copy ["all"]), cfg).run(alias mgr);

    assert(!sys::isDir(app.push(defaults::__CACHE_ALL_DIR__)), "the build cache should be removed");
    assert(!sys::isDir(app.push(defaults::__DEPENCY_DIR__)), "the resolved dependencies should be removed");
    assert(!hasFile(app, "myapp"), "the executable should be removed");

    assert(!sys::isDir(lib.push(defaults::__CACHE_ALL_DIR__)), "the cache of the dependency should be cleaned as well");
    assert(!hasFile(lib, "libmylib.a"), "the outputs of the dependency should be cleaned as well");
}

__test run_process_verbose_logs_command {
    // runProcess() in verbose mode logs the command line it runs, and still reports its exit code
    let mgr = copy GyllirManager(copy ["gyllir", "clean"]);

    assert(mgr.runProcess("true", copy ["an-argument"], verbose-> true), "\"true\" should report success");
}

__test progress_bar_renders_partial_and_complete {
    // progressBar() renders a partial bar, then a complete one closing the line
    let mgr = copy GyllirManager(copy ["gyllir", "clean"]);

    mgr.progressBar(0u32, 10u32);
    mgr.progressBar(5u32, 10u32);
    mgr.progressBar(10u32, 10u32);
}

__test dependency_resolved_through_fetched_tags {
    // A dependency whose version filter rejects the branch it sits on is resolved through the tags
    // fetched from its remote
    let remote = sys::tempDirectory(prefix-> "gyllir_dep_remote_");
    let dmut init = copy SubProcess("git", copy ["init", "--bare"], cwd-> remote);
    init:.start();
    init:.wait();

    let source = mkLibraryProject();
    writeToml(source, mkConfig("mylib", "library"));
    gitInit(source);

    let sourceGit = GitManager(cwd-> source);
    let dmut sign = copy SubProcess("git", copy ["config", "tag.gpgsign", "false"], cwd-> source);
    sign:.start();
    sign:.wait();

    sourceGit.createTag("v1.0.0");
    sourceGit.setRemote(remote.toStr());
    sourceGit.push(copy ["master", "v1.0.0"]);

    // the dependency the project points at is a clone: it has a remote to fetch its tags from
    let lib = sys::tempDirectory(prefix-> "gyllir_dep_clone_");
    GitManager(cwd-> lib).clone(remote.toStr());

    let app = mkExecutableProject("myapp");
    let cfg = mkConfigWithDependency("myapp", "executable", "mylib", lib, version-> ">=1.0.0");

    let dmut mgr = copy GyllirManager(copy ["gyllir", "build"]);
    RepoBuilder(app, mkBuildArgs(), cfg, soleTarget(cfg), forUnitTest-> false).run(alias mgr);

    assert(hasFile(app, "myapp"), "the executable should be produced");
    assert(hasFile(lib, "libmylib.a"), "the dependency should have been built");
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          LOCKING          ====================================
 * ====================================================================================================
 * ====================================================================================================
 * What a build writes to 'gyllir.lock', and what the next build does with it
 */

/**
 * Resolve and build a package the way 'GyllirManager::run()' does for 'gyllir build': honoring the
 * lock file, and rewriting it with what was resolved
 * @params:
 *    - dir: the root directory of the package
 *    - cfg: its configuration
 *    - args: the configuration of the sub command
 *    - update: the names of the dependencies to resolve again, ["*"] for all of them, [] to honor
 *      the lock file
 * */
fn buildWithLock(dir: Path, cfg: GyllirPackageConfiguration, args: &Config, update: [[c8]] = [])
    throws RecursiveDependency, AssertError
{
    let dmut mgr = copy GyllirManager(copy ["gyllir", "build"]);
    mgr:.loadLock(dir, args, cfg);

    if (update.len != 0us) {
        let dmut updateArgs = copy Dict();
        if (update != copy ["*"]) {
            updateArgs["packages"] = copy Array(copy [copy Str(u) for u in update]);
        }

        mgr:.selectUpdated(updateArgs, cfg);
    }

    mgr:.buildTargets(dir, args, cfg, copy [soleTarget(cfg).name => ()]);
    mgr.writeLock(dir, cfg);
}

__test lock_file_pins_a_git_dependency_to_its_commit {
    // A build records the version each dependency was resolved at, and the commit it was checked
    // out at: a tag can be moved, a commit cannot
    let lib = mkLibraryProject();
    writeToml(lib, mkConfig("mylib", "library"));
    gitInit(lib);
    commitAndTag(lib, "v1.0.0");

    let app = mkExecutableProject("myapp");
    let cfg = mkConfigWithGitDependency("myapp", "executable", "mylib", lib, version-> ">=1.0.0");

    buildWithLock(app, cfg, mkBuildArgs());

    assert(hasFile(app, defaults::__GYLLIR_LOCK_FILENAME__), "a build resolving a dependency should write a lock file");

    let locked = lockedPackage(app, "mylib");
    assert(locked.version == Version(1u32, 0u32, 0u32), "the resolved version should be recorded");
    assert(locked.url.type == UrlType::GIT, "the url the dependency was resolved from should be recorded");
    assert(locked.pinned(), "a git dependency should be pinned to a commit");
    assert(locked.sha == resolvedCommitOf(app, "mylib"), "the pinned commit should be the one the checkout sits at");
}

__test lock_file_is_honored_by_the_next_build {
    // A version published upstream after the lock file was written does not change what is built:
    // that is the whole point of locking
    let lib = mkLibraryProject();
    writeToml(lib, mkConfig("mylib", "library"));
    gitInit(lib);
    commitAndTag(lib, "v1.0.0");

    let app = mkExecutableProject("myapp");
    let cfg = mkConfigWithGitDependency("myapp", "executable", "mylib", lib, version-> ">=1.0.0");

    buildWithLock(app, cfg, mkBuildArgs());
    let first = lockedPackage(app, "mylib");

    commitAndTag(lib, "v2.0.0");
    buildWithLock(app, cfg, mkBuildArgs());

    let second = lockedPackage(app, "mylib");
    assert(second.version == Version(1u32, 0u32, 0u32), "a newer tag upstream should not move a locked dependency");
    assert(second.sha == first.sha, "the pinned commit should not move either");
    assert(resolvedCommitOf(app, "mylib") == first.sha, "the checkout should be brought back to the pinned commit");
}

__test update_moves_the_lock_file_forward {
    // 'gyllir update' is what deliberately picks the version published since the lock file was
    // written
    let lib = mkLibraryProject();
    writeToml(lib, mkConfig("mylib", "library"));
    gitInit(lib);
    commitAndTag(lib, "v1.0.0");

    let app = mkExecutableProject("myapp");
    let cfg = mkConfigWithGitDependency("myapp", "executable", "mylib", lib, version-> ">=1.0.0");

    buildWithLock(app, cfg, mkBuildArgs());
    let first = lockedPackage(app, "mylib");

    commitAndTag(lib, "v2.0.0");
    buildWithLock(app, cfg, mkBuildArgs(), update-> copy ["*"]);

    let updated = lockedPackage(app, "mylib");
    assert(updated.version == Version(2u32, 0u32, 0u32), "an update should resolve the version published since");
    assert(updated.sha != first.sha, "an update should pin the commit of the new version");
    assert(resolvedCommitOf(app, "mylib") == updated.sha, "the checkout should follow the update");
}

__test update_of_one_dependency_leaves_the_others_alone {
    // 'gyllir update <name>' only unlocks the dependency it names, the rest keep the version they
    // were locked at
    // the two libraries end up on the same link line, so they must not export the same symbols
    let first = mkLibraryProject(suffix-> "One");
    writeToml(first, mkConfig("libone", "library"));
    gitInit(first);
    commitAndTag(first, "v1.0.0");

    let second = mkLibraryProject(suffix-> "Two");
    writeToml(second, mkConfig("libtwo", "library"));
    gitInit(second);
    commitAndTag(second, "v1.0.0");

    let app = mkExecutableProject("myapp");
    let cfg = mkConfigWithGitDependencies("myapp", "executable", copy [("libone", first), ("libtwo", second)]);

    buildWithLock(app, cfg, mkBuildArgs());

    commitAndTag(first, "v2.0.0");
    commitAndTag(second, "v2.0.0");
    buildWithLock(app, cfg, mkBuildArgs(), update-> copy ["libone"]);

    assert(lockedPackage(app, "libone").version == Version(2u32, 0u32, 0u32), "the named dependency should be updated");
    assert(lockedPackage(app, "libtwo").version == Version(1u32, 0u32, 0u32),
           "a dependency that was not named should keep the version it was locked at");
}

__test lock_file_records_the_transitive_graph {
    // The lock file is flat, and holds the dependencies of the dependencies: an indirect dependency
    // that is not pinned is one that can move without anything in the package changing
    // the two libraries end up on the same link line, so they must not export the same symbols
    let sub = mkLibraryProject(suffix-> "Sub");
    writeToml(sub, mkConfig("mysub", "library"));
    gitInit(sub);
    commitAndTag(sub, "v1.0.0");

    let lib = mkLibraryProject();
    writeToml(lib, mkConfigWithGitDependency("mylib", "library", "mysub", sub, version-> ">=1.0.0"));
    gitInit(lib);
    commitAndTag(lib, "v1.0.0");

    let app = mkExecutableProject("myapp");
    let cfg = mkConfigWithGitDependency("myapp", "executable", "mylib", lib, version-> ">=1.0.0");

    buildWithLock(app, cfg, mkBuildArgs());

    let lock = readLockFile(app);
    assert(lock[].len == 2us, "both the direct and the indirect dependency should be locked");

    let direct = lockedPackage(app, "mylib");
    assert(direct.dependencies.len == 1us, "the direct dependency should record the package it depends on");
    assert(direct.dependencies[0].path.toStr() == sub.toStr(), "unexpected recorded dependency url");

    let indirect = lockedPackage(app, "mysub");
    assert(indirect.version == Version(1u32, 0u32, 0u32), "the indirect dependency should be locked at its resolved version");
    assert(indirect.pinned(), "the indirect dependency should be pinned to a commit");
}

__test local_dependency_is_recorded_without_a_commit {
    // A local path is a working checkout, not a released version: it is recorded, so that the lock
    // file describes the whole graph, but never pinned to a commit
    let lib = mkLibraryProject();
    writeToml(lib, mkConfig("mylib", "library"));
    gitInit(lib);

    let app = mkExecutableProject("myapp");
    let cfg = mkConfigWithDependency("myapp", "executable", "mylib", lib);

    buildWithLock(app, cfg, mkBuildArgs());

    let locked = lockedPackage(app, "mylib");
    assert(locked.url.type == UrlType::LOCAL, "the local url should be recorded");
    assert(!locked.pinned(), "a local dependency should not be pinned to a commit");
    assert(locked.sha == "", "a local dependency should carry no commit");
}

__test package_without_dependency_gains_no_lock_file {
    // A package that depends on nothing has nothing to lock
    let app = mkExecutableProject("myapp");
    let cfg = mkConfig("myapp", "executable");

    buildWithLock(app, cfg, mkBuildArgs());

    assert(!hasFile(app, defaults::__GYLLIR_LOCK_FILENAME__), "a package with no dependency should not gain a lock file");
}

__test std_only_package_keeps_its_lock_file {
    // A package resolving a remote std lib through '[std]', but declaring no '[dependencies]' of
    // its own, still has something to lock: 'std' must be a prune root just like any other
    // dependency, or its entry is unreachable and the lock file is written empty, then deleted
    let app = mkExecutableProject("myapp");
    let stdUrl = "git:https://example.com/fake-std.git";
    let cfg = GyllirPackageConfiguration(json#{
        "name" : "myapp",
        "license" : "MIT",
        "description" : "d",
        "type" : "executable",
        "version" : "1.0.0",
        "registry" : {"local" : "some/registry"},
        "std" : {"version" : "*", "url" : stdUrl}
    });

    let dmut lock = copy LockFile();
    lock:.insert("std", LockedPackage(Url(stdUrl), Version(1u32, 3u32, 2u32), sha-> "a1b2c3"));

    {
        let dmut f = File::create(app.push(defaults::__GYLLIR_LOCK_FILENAME__), write-> true);
        f:.write(lock.toToml());
        f:.close();
    }

    let dmut mgr = copy GyllirManager(copy ["gyllir", "build"]);
    mgr:.loadLock(app, mkBuildArgs(), cfg);
    mgr.writeLock(app, cfg);

    assert(hasFile(app, defaults::__GYLLIR_LOCK_FILENAME__), "a locked std lib should keep the lock file");

    let locked = lockedPackage(app, "std");
    assert(locked.version == Version(1u32, 3u32, 2u32), "the locked std version should survive the rewrite");
    assert(locked.sha == "a1b2c3", "the locked std commit should survive the rewrite");
}

__test resolve_std_reports_an_unreachable_remote_instead_of_no_matching_version {
    // A remote std lib repository that cannot be reached is reported as such, not silently turned
    // into "no version matching the filter" the way a genuinely tagless remote would be
    let app = mkExecutableProject("myapp");
    let cfg = GyllirPackageConfiguration(json#{
        "name" : "myapp",
        "license" : "MIT",
        "description" : "d",
        "type" : "executable",
        "version" : "1.0.0",
        "registry" : {"local" : "some/registry"},
        "std" : {"version" : "*", "url" : "git:/no/such/repository/here"}
    });

    let dmut mgr = copy GyllirManager(copy ["gyllir", "build"]);
    mgr:.loadLock(app, mkBuildArgs(), cfg);

    let mut msg = "";
    {
        mgr:.resolveStd(mkBuildArgs(), app, cfg, false);
    } catch {
        a: &AssertError => { msg = a.msg; }
        _: &RecursiveDependency => { assert(false, "no recursive dependency should be detected here"); }
    }

    let expectedPrefix = "could not list the versions offered by the std lib repository '/no/such/repository/here': ";
    assert(msg.len >= expectedPrefix.len && msg[0us .. expectedPrefix.len] == expectedPrefix,
           "unexpected error: " ~ msg);
}

__test update_std_flag_accepted_before_it_is_ever_locked {
    // '--std' is accepted by 'selectUpdated' even before the std lib was ever resolved as a remote
    // lock entry(the bundled compiler's std lib can already be satisfying the declared filter, in
    // which case nothing is cloned and 'std' never appears as a key of 'gyllir.lock')
    // 'selectUpdated' exits the process on an unrecognized name, so reaching past this call is
    // itself the assertion
    let app = mkExecutableProject("myapp");
    let cfg = GyllirPackageConfiguration(json#{
        "name" : "myapp",
        "license" : "MIT",
        "description" : "d",
        "type" : "executable",
        "version" : "1.0.0",
        "registry" : {"local" : "some/registry"},
        "std" : {"version" : "*"}
    });

    let dmut mgr = copy GyllirManager(copy ["gyllir", "build"]);
    mgr:.loadLock(app, mkBuildArgs(), cfg);

    let dmut updateArgs = copy Dict();
    updateArgs["std"] = copy Bool(true);

    mgr:.selectUpdated(updateArgs, cfg);
    assert(!hasFile(app, defaults::__GYLLIR_LOCK_FILENAME__),
           "'--std' should be accepted once '[std]' is declared, without writing a lock file on its own");
}

__test dropping_the_last_dependency_removes_the_lock_file {
    // An entry that the package no longer depends on is dropped, and a lock file with nothing left
    // to lock goes with it
    let lib = mkLibraryProject();
    writeToml(lib, mkConfig("mylib", "library"));
    gitInit(lib);

    let app = mkExecutableProject("myapp");
    let cfg = mkConfigWithDependency("myapp", "executable", "mylib", lib);

    buildWithLock(app, cfg, mkBuildArgs());
    assert(hasFile(app, defaults::__GYLLIR_LOCK_FILENAME__), "sanity: the build should have written a lock file");

    // the same package, with its dependency taken out of 'gyllir.toml'
    let dropped = mkConfig("myapp", "executable");
    let dmut mgr = copy GyllirManager(copy ["gyllir", "build"]);
    mgr:.loadLock(app, mkBuildArgs(), dropped);
    mgr.writeLock(app, dropped);

    assert(!hasFile(app, defaults::__GYLLIR_LOCK_FILENAME__), "a lock file with nothing left to lock should be removed");
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          TARGETS          ====================================
 * ====================================================================================================
 * ====================================================================================================
 * The selection, the validation and the build order of the targets of a package
 */

__test select_targets_defaults_to_every_target {
    // selectTargets() with no target named on the command line selects every declared target
    let mgr = copy GyllirManager(copy ["gyllir", "build"]);
    let cfg = mkMultiTargetConfig();

    let selected = mgr.selectTargets(cfg, copy Dict());

    assert(selected.len == 3us, "every declared target should be selected");
    assert("mylib" in selected && "cli" in selected && "tool" in selected, "unexpected selection");
}

__test select_targets_named_target_only {
    // A target named on the command line is the only one selected
    let mgr = copy GyllirManager(copy ["gyllir", "build"]);
    let cfg = mkMultiTargetConfig();

    let dmut args = copy Dict();
    args["target"] = copy Str("cli");

    let selected = mgr.selectTargets(cfg, args);

    assert(selected.len == 1us && "cli" in selected, "only the named target should be selected");
}

__test select_targets_unknown_target_rejected {
    // A command line naming a target the package does not declare is rejected, with the list of the
    // ones it does declare
    let mgr = copy GyllirManager(copy ["gyllir", "build"]);
    let cfg = mkMultiTargetConfig();

    let dmut args = copy Dict();
    args["target"] = copy Str("nope");

    let mut msg = "";
    {
        mgr.selectTargets(cfg, args);
    } catch {
        a: &AssertError => { msg = a.msg; }
    }

    assert(msg == "unknown target 'nope', declared targets are 'cli', 'mylib', 'tool'", "unexpected error: " ~ msg);
}

__test select_targets_synthesizes_single_target {
    // A package declaring no target selects the single one synthesized from its top level fields
    let mgr = copy GyllirManager(copy ["gyllir", "build"]);
    let cfg = mkConfig("myapp", "executable");

    let selected = mgr.selectTargets(cfg, copy Dict());

    assert(selected.len == 1us && "myapp" in selected, "the synthesized target should be selected");
}

__test select_test_targets_skips_opted_out {
    // selectTestTargets() with no target named on the command line selects every testable target,
    // skipping the ones that opted out
    let mgr = copy GyllirManager(copy ["gyllir", "test"]);
    let cfg = mkTargetsConfig("multi", json#{
        "cli" : {"type" : "executable"},
        "tool" : {"type" : "executable", "tests" : false}
    });

    let selected = mgr.selectTestTargets(cfg, copy Dict());

    assert(selected.len == 1us && "cli" in selected, "only the testable target should be selected");
}

__test select_test_targets_named_opted_out_rejected {
    // selectTestTargets() naming a target that opted out of unittesting is rejected
    let mgr = copy GyllirManager(copy ["gyllir", "test"]);
    let cfg = mkTargetsConfig("multi", json#{"tool" : {"type" : "executable", "tests" : false}});

    let dmut args = copy Dict();
    args["target"] = copy Str("tool");

    let mut msg = "";
    {
        mgr.selectTestTargets(cfg, args);
    } catch {
        a: &AssertError => { msg = a.msg; }
    }

    assert(msg == "target 'tool' has 'tests' set to false, it declares no unittest", "unexpected error: " ~ msg);
}

__test select_test_targets_no_testable_target_rejected {
    // selectTestTargets() with no target named, and no testable target at all, is rejected the same way
    let mgr = copy GyllirManager(copy ["gyllir", "test"]);
    let cfg = mkTargetsConfig("multi", json#{"tool" : {"type" : "executable", "tests" : false}});

    let mut msg = "";
    {
        mgr.selectTestTargets(cfg, copy Dict());
    } catch {
        a: &AssertError => { msg = a.msg; }
    }

    assert(msg == "no testable target, declared targets are 'tool'", "unexpected error: " ~ msg);
}

__test select_test_targets_unknown_target_rejected {
    // selectTestTargets() naming a target the package does not declare is rejected, just like
    // selectTargets()
    let mgr = copy GyllirManager(copy ["gyllir", "test"]);
    let cfg = mkMultiTargetConfig();

    let dmut args = copy Dict();
    args["target"] = copy Str("nope");

    let mut msg = "";
    {
        mgr.selectTestTargets(cfg, args);
    } catch {
        a: &AssertError => { msg = a.msg; }
    }

    assert(msg == "unknown target 'nope', declared targets are 'cli', 'mylib', 'tool'", "unexpected error: " ~ msg);
}

__test ordered_targets_orders_linked_and_alphabetical {
    // orderedTargets() puts a target after the ones it links, and orders the independent ones
    // alphabetically, so that the build order never depends on the iteration order of a map
    let mgr = copy GyllirManager(copy ["gyllir", "build"]);
    let cfg = mkMultiTargetConfig();

    let ordered = mgr.orderedTargets(cfg, cfg.targets());
    let names = copy [t.name for t in ordered];

    assert(names == copy ["mylib", "tool", "cli"], "unexpected build order");
}

__test ordered_targets_mutual_cycle_rejected {
    // Two targets linking each other are reported instead of blocking the build forever
    let mgr = copy GyllirManager(copy ["gyllir", "build"]);
    let cfg = mkTargetsConfig("multi", json#{
        "a" : {"targets" : ["b"]},
        "b" : {"targets" : ["a"]}
    });

    let mut msg = "";
    {
        mgr.orderedTargets(cfg, cfg.targets());
    } catch {
        r: &RecursiveDependency => { msg = r.msg; }
        a: &AssertError => { msg = a.msg; }
    }

    assert(msg == "targets of 'multi', 'a', 'b'", "unexpected recursion error: " ~ msg);
}

__test ordered_targets_self_link_rejected {
    // A target linking itself is a cycle of its own, reported before the build order is even computed
    let mgr = copy GyllirManager(copy ["gyllir", "build"]);
    let cfg = mkTargetsConfig("multi", json#{"a" : {"targets" : ["a"]}});

    let mut msg = "";
    {
        mgr.orderedTargets(cfg, cfg.targets());
    } catch {
        a: &AssertError => { msg = a.msg; }
        r: &RecursiveDependency => { msg = r.msg; }
    }

    assert(msg == "target 'a' links itself", "unexpected error: " ~ msg);
}

__test ordered_targets_unknown_linked_target_rejected {
    // A target linking a target the package does not declare is rejected
    let mgr = copy GyllirManager(copy ["gyllir", "build"]);
    let cfg = mkTargetsConfig("multi", json#{"a" : {"targets" : ["nope"]}});

    let mut msg = "";
    {
        mgr.orderedTargets(cfg, cfg.targets());
    } catch {
        a: &AssertError => { msg = a.msg; }
        r: &RecursiveDependency => { msg = r.msg; }
    }

    assert(msg == "target 'a' links the unknown target 'nope'", "unexpected error: " ~ msg);
}

__test ordered_targets_unknown_dependency_rejected {
    // "dependencies" selects among the "[dependencies.*]" of the package, it never declares one
    let mgr = copy GyllirManager(copy ["gyllir", "build"]);
    let cfg = mkTargetsConfig("multi", json#{"a" : {"dependencies" : ["nope"]}});

    let mut msg = "";
    {
        mgr.orderedTargets(cfg, cfg.targets());
    } catch {
        a: &AssertError => { msg = a.msg; }
        r: &RecursiveDependency => { msg = r.msg; }
    }

    assert(msg == "target 'a' selects the unknown dependency 'nope'", "unexpected error: " ~ msg);
}

__test unique_paths_drops_duplicate_keeps_first {
    // uniquePaths() keeps the first occurrence of each path: the same archive twice on the link line
    // is a "multiple definition" error from the linker
    let mgr = copy GyllirManager(copy ["gyllir", "build"]);

    let unique = mgr.uniquePaths(copy [Path("/a/libx.a"), Path("/b/liby.a"), Path("/a/libx.a")]);

    assert(unique.len == 2us, "the duplicated path should have been dropped");
    assert(unique[0] == Path("/a/libx.a") && unique[1] == Path("/b/liby.a"), "the first occurrence of each path should be kept");
}

__test select_run_target_single_target_no_name {
    // "gyllir run" on a package declaring a single target needs no target name
    let mgr = copy GyllirManager(copy ["gyllir", "run"]);
    let cfg = mkConfig("myapp", "executable");

    let (target, forwarded) = mgr.selectRunTarget(cfg, copy Array());

    assert(target.name == "myapp", "the single target should be selected");
    if let a: &Array = forwarded {
        assert(a[].len == 0us, "no argument should be forwarded");
    } else assert(false, "the forwarded arguments should be an array");
}

__test select_run_target_named_forwards_arguments {
    // "gyllir run <target>" selects that target, and forwards the rest of the command line
    let mgr = copy GyllirManager(copy ["gyllir", "run"]);
    let cfg = mkMultiTargetConfig();

    let dmut args = copy Array();
    args:.push(copy Str("cli"));
    args:.push(copy Str("--flag-for-the-program"));

    let (target, forwarded) = mgr.selectRunTarget(cfg, args);

    assert(target.name == "cli", "the named target should be selected");
    if let a: &Array = forwarded {
        assert(a[].len == 1us, "the arguments of the program should be forwarded");
        assert(to!{[c8]}(a[][0]) == "--flag-for-the-program", "unexpected forwarded argument");
    } else assert(false, "the forwarded arguments should be an array");
}

__test select_run_target_double_dash_forwards_all {
    // "--" forwards everything that follows, even when it happens to name a target
    let mgr = copy GyllirManager(copy ["gyllir", "run"]);
    let cfg = mkConfig("myapp", "executable");

    let dmut args = copy Array();
    args:.push(copy Str("--"));
    args:.push(copy Str("cli"));

    let (target, forwarded) = mgr.selectRunTarget(cfg, args);

    assert(target.name == "myapp", "the single target should still be selected");
    if let a: &Array = forwarded {
        assert(a[].len == 1us && to!{[c8]}(a[][0]) == "cli", "everything after \"--\" should be forwarded");
    } else assert(false, "the forwarded arguments should be an array");
}

__test select_run_target_multi_target_needs_name {
    // "gyllir run" on a package declaring several targets has no default: it asks for a name
    let mgr = copy GyllirManager(copy ["gyllir", "run"]);
    let cfg = mkMultiTargetConfig();

    let mut msg = "";
    {
        mgr.selectRunTarget(cfg, copy Array());
    } catch {
        a: &AssertError => { msg = a.msg; }
    }

    assert(msg == "'gyllir run' needs the name of a target, declared targets are 'cli', 'mylib', 'tool'",
           "unexpected error: " ~ msg);
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ================================          MULTI TARGET BUILD          ==============================
 * ====================================================================================================
 * ====================================================================================================
 */

__test build_targets_produces_artifact_per_target {
    // Building every target of a package produces one artifact per target, in an order where a
    // linked target comes first
    let dir = mkMultiTargetProject();
    let cfg = mkMultiTargetConfig();
    let dmut mgr = copy GyllirManager(copy ["gyllir", "build"]);

    let selected = mgr.selectTargets(cfg, copy Dict());
    let (built, _, _) = mgr:.buildTargets(dir, mkBuildArgs(), cfg, selected);

    assert(built.len == 3us, "every selected target should be reported as built");
    assert(built[0].name == "mylib", "a linked target should be built before the one linking it");

    assert(hasFile(dir, "libmylib.a"), "the library target should produce its archive");
    assert(hasFile(dir, "cli") && hasFile(dir, "tool"), "both executable targets should produce their binary");
    assert(hasCacheFile(dir, "cli", defaults::__CACHE_DEBUG_DIR__, "cli.a"), "every target should cache under its own name");
    assert(hasCacheFile(dir, "mylib", defaults::__CACHE_DEBUG_DIR__, "mylib.a"), "every target should cache under its own name");
}

__test build_targets_single_target_builds_links_only {
    // Building a single target builds the targets it links, and nothing else
    let dir = mkMultiTargetProject();
    let cfg = mkMultiTargetConfig();
    let dmut mgr = copy GyllirManager(copy ["gyllir", "build"]);

    let dmut args = copy Dict();
    args["target"] = copy Str("cli");
    args["j"] = copy Int(1i64);

    let selected = mgr.selectTargets(cfg, args);
    let (built, _, _) = mgr:.buildTargets(dir, args, cfg, selected);

    assert(built.len == 1us && built[0].name == "cli", "only the named target should be reported as built");
    assert(hasFile(dir, "cli"), "the named target should be built");
    assert(hasFile(dir, "libmylib.a"), "the target it links should be built first");
    assert(!hasFile(dir, "tool"), "an unrelated target should be left alone");
}

__test test_builds_and_runs_unittest_per_target {
    // "gyllir test" builds one unittest executable per target, and runs them one after the other
    let dir = mkMultiTargetProject();
    addUnitTests(dir);

    let cfg = mkMultiTargetConfig();
    let dmut mgr = copy GyllirManager(copy ["gyllir", "test"]);

    let selected = mgr.selectTargets(cfg, copy Dict());
    let (built, _, _) = mgr:.buildTargets(dir, mkBuildArgs(), cfg, selected, forUnitTest-> true);

    assert(hasFile(dir, "cli.test") && hasFile(dir, "mylib.test") && hasFile(dir, "tool.test"),
           "every target should produce a unittest executable of its own");
    assert(hasCacheFile(dir, "tool", defaults::__CACHE_UNIT_DEBUG_DIR__, "tool.a"), "the unittest build has a cache of its own");

    assert(mgr.runUnitTests(dir, cfg, built) == 0, "the tests of every target should pass");
}

__test build_targets_dependency_skips_executable_targets {
    // Only the library targets of a dependency are built: an executable it also declares is never
    // linked into the package depending on it
    let lib = mkMultiTargetProject();
    writeToml(lib, mkMultiTargetConfig());
    gitInit(lib);

    let app = mkExecutableProject("myapp");
    let cfg = mkConfigWithDependency("myapp", "executable", "multi", lib);
    let dmut mgr = copy GyllirManager(copy ["gyllir", "build"]);

    let (includes, links) = RepoBuilder(app, mkBuildArgs(), cfg, soleTarget(cfg), forUnitTest-> false).run(alias mgr);

    let depPath = app.push(defaults::__DEPENCY_DIR__).push("multi");
    assert(sys::isFile(depPath.push("libmylib.a")), "the library target of the dependency should be built");
    assert(!sys::isFile(depPath.push("cli")), "an executable target of a dependency should not be built");

    assert(links.len == 1us && links[0] == depPath.push("libmylib.a"), "only the library archive should be linked");
    assert(includes.len == 2us, "the root file of the library target and the one of the project should be exported");
    assert(hasFile(app, "myapp"), "the executable should be produced");
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ===========================          MULTI-TARGET DEPENDENCIES          ============================
 * ====================================================================================================
 * ====================================================================================================
 * "link-targets" selects which of a multi-target dependency's library targets are actually linked
 */

__test link_targets_absent_links_every_library {
    // Absent "link-targets", every library target of the dependency is linked: today's behaviour,
    // unaffected by a package that never uses the new key
    let lib = mkMultiLibProject();
    writeToml(lib, mkMultiLibConfig());
    gitInit(lib);

    let app = mkExecutableProject("myapp");
    let cfg = mkConfigWithDependency("myapp", "executable", "multilib", lib);
    let dmut mgr = copy GyllirManager(copy ["gyllir", "build"]);

    let (_, links) = RepoBuilder(app, mkBuildArgs(), cfg, soleTarget(cfg), forUnitTest-> false).run(alias mgr);

    let depPath = app.push(defaults::__DEPENCY_DIR__).push("multilib");
    assert(sys::isFile(depPath.push("libfoo.a")), "libfoo should be built");
    assert(sys::isFile(depPath.push("libbar.a")), "libbar should be built");
    assert(links.len == 2us, "both archives should be linked");
}

__test link_targets_narrows_to_named_subtargets {
    // "link-targets" narrows a dependency down to the named sub-targets: the other one is neither
    // built nor linked
    let lib = mkMultiLibProject();
    writeToml(lib, mkMultiLibConfig());
    gitInit(lib);

    let app = mkExecutableProject("myapp");
    let cfg = mkConfigWithSelectedDependency("myapp", "executable", "multilib", lib, copy ["foo"]);
    let dmut mgr = copy GyllirManager(copy ["gyllir", "build"]);

    let (includes, links) = RepoBuilder(app, mkBuildArgs(), cfg, soleTarget(cfg), forUnitTest-> false).run(alias mgr);

    let depPath = app.push(defaults::__DEPENCY_DIR__).push("multilib");
    assert(sys::isFile(depPath.push("libfoo.a")), "the selected target should be built");
    assert(!sys::isFile(depPath.push("libbar.a")), "the target left out of \"link-targets\" should not be built");

    assert(links.len == 1us && links[0] == depPath.push("libfoo.a"), "only the selected archive should be linked");
    assert(includes.len == 2us, "only the selected target's root file and the project's own should be exported");
    assert(hasFile(app, "myapp"), "the executable should be produced");
}

__test select_dependency_targets_empty_selection_keeps_all {
    // "selectDependencyTargets" is called directly here rather than driven through
    // "RepoBuilder.run()" -> "resolveDependency": that call chain wraps a thrown "AssertError" in a
    // catch that calls "etc::c::process::_yrt_exit(-1)", which would take the test binary down with
    // it instead of letting the test observe the exception -- the same reason "orderedTargets" and
    // "linkedTargets" are tested directly for YMI-72's own target-selection errors.

    // An empty selection is left untouched: it is what "absent link-targets" means
    let mgr = copy GyllirManager(copy ["gyllir", "build"]);
    let cfg = mkMultiTargetConfig();
    let libTargets = libTargetsOf(cfg);

    let selected = mgr.selectDependencyTargets("multi", Dependency(VersionFilter(copy ["*"]), Url("local:some/dir")), cfg.targets(), libTargets);

    assert(selected.len == 1us && "mylib" in selected, "an empty selection should keep every library target");
}

__test select_dependency_targets_unknown_target_rejected {
    // A "link-targets" naming a target the dependency does not declare is rejected
    let mgr = copy GyllirManager(copy ["gyllir", "build"]);
    let cfg = mkMultiTargetConfig();
    let libTargets = libTargetsOf(cfg);
    let dep = Dependency(VersionFilter(copy ["*"]), Url("local:some/dir"), targets-> copy ["nope"]);

    let mut msg = "";
    {
        mgr.selectDependencyTargets("multi", dep, cfg.targets(), libTargets);
    } catch {
        a: &AssertError => { msg = a.msg; }
    }

    assert(msg == "dependency 'multi' links the unknown target 'nope', declared targets are 'cli', 'mylib', 'tool'",
           "unexpected error: " ~ msg);
}

__test select_dependency_targets_executable_rejected {
    // A "link-targets" naming an executable target of the dependency is rejected: an executable is
    // never linked into the package that depends on it
    let mgr = copy GyllirManager(copy ["gyllir", "build"]);
    let cfg = mkMultiTargetConfig();
    let libTargets = libTargetsOf(cfg);
    let dep = Dependency(VersionFilter(copy ["*"]), Url("local:some/dir"), targets-> copy ["cli"]);

    let mut msg = "";
    {
        mgr.selectDependencyTargets("multi", dep, cfg.targets(), libTargets);
    } catch {
        a: &AssertError => { msg = a.msg; }
    }

    assert(msg == "dependency 'multi' links target 'cli', which is not a library", "unexpected error: " ~ msg);
}

__test link_targets_names_synthesized_target {
    // A "link-targets" naming the single target of a dependency declaring no "[targets.*]" table
    // (its synthesized target, named after the package) keeps working exactly as if the key had
    // been left out
    let lib = mkLibraryProject();
    writeToml(lib, mkConfig("mylib", "library"));
    gitInit(lib);

    let app = mkExecutableProject("myapp");
    let cfg = mkConfigWithSelectedDependency("myapp", "executable", "mylib", lib, copy ["mylib"]);
    let dmut mgr = copy GyllirManager(copy ["gyllir", "build"]);

    let (includes, links) = RepoBuilder(app, mkBuildArgs(), cfg, soleTarget(cfg), forUnitTest-> false).run(alias mgr);

    let depPath = app.push(defaults::__DEPENCY_DIR__).push("mylib");
    assert(links.len == 1us && links[0] == depPath.push("libmylib.a"), "the synthesized target should still be linked");
    assert(includes.len == 2us, "both root files should still be exported");
    assert(hasFile(app, "myapp"), "the executable should be produced");
}
