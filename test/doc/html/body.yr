        "<div class=\"row-fluid declaration y_decl\"><h3 class=\"y_dd_decl_name\">\n" ~
        "    <span class=\"symbol-target\" id=\"mymacro\">&nbsp;</span><span class=\"y_symbol_kind\" id=\"mymacro\">macro</span> <span class=\"y_symbol_name symbol-link\">mymacro</span> \n" ~
        "    <span class=\"symbol-closing\" id=\"mymacro-closing\">[−]</span></h3>\n" ~
        "</div>\n\n" ~
        "<div class=\"declaration-content y_dd_decl\" id=\"mymacro-content\"><pre><code class=\"language-ymir\">pub macro mymacro</code></pre>\n" ~
        "<div class=\"doc\"><dt class=\"head\"></dt><dd></dd></div><div class=\"member-list\"></div>\n" ~
        "</div>\n",
        "unexpected html for an empty macro");
}

__test class_field_module_links {
    // A class with a field whose type lives in the same module (a "#Name" link) and one in
    // another module ("othermod.html#Name"), a ctor and a method
    let dmut mod_ = copy Module("mymod", "", INTERNAL_LOCATION, Protection::PUB);
    let dmut c = copy ClassSymbol("Foo", "", INTERNAL_LOCATION, Protection::PUB);

    let dmut localField = copy Variable("x", "", INTERNAL_LOCATION, Protection::PUB);
    localField.type = copy ClassType("mymod::Bar", "", false);

    let dmut otherField = copy Variable("y", "", INTERNAL_LOCATION, Protection::PUB);
    otherField.type = copy ClassType("othermod::Baz", "", false);

    c.fields = copy [localField, otherField];
    c.ctors = copy [copy Ctor("self", "", INTERNAL_LOCATION, Protection::PUB)];
    c.methods = copy [copy Method("bar", "", INTERNAL_LOCATION, Protection::PUB)];

    let c2: &Symbol = c;
    mod_.childs = copy [c2];
    let out = dump(mod_);

    // link resolution: a field type belonging to the current module links to "#Name",
    // one belonging to another module links to "<module>.html#Name"
    assert(out.len > 0us, "sanity: output should not be empty");
    let localLink = "<a class=\"symbol-link\" href=\"#Bar\">mymod::Bar</a>";
    let otherLink = "<a class=\"symbol-link\" href=\"othermod.html#Baz\">othermod::Baz</a>";

    let mut foundLocal = false, mut foundOther = false;
    for i in 0us .. out.len {
        if (out.len - i >= localLink.len && out[i .. i + localLink.len] == localLink) { foundLocal = true; }
        if (out.len - i >= otherLink.len && out[i .. i + otherLink.len] == otherLink) { foundOther = true; }
    }

    assert(foundLocal, "expected a local (same-module) class type to link to \"#Bar\"");
    assert(foundOther, "expected a cross-module class type to link to \"othermod.html#Baz\"");
}

__test submodule_table {
    // Two nested modules populate the submodule table, sorted and formatted with an underscore-joined url
    let dmut mod_ = copy Module("mymod", "", INTERNAL_LOCATION, Protection::PUB);
    let sub: &Symbol = copy Module("mymod::sub", "docs for sub", INTERNAL_LOCATION, Protection::PUB);
    mod_.childs = copy [sub];

    assert(dump(mod_) == MODULE_HEAD ~
        "<div class=\"module description y_decl_small\">\n" ~
        "  <h3 class=\"y_dd_decl_name\">Inner modules</h3>\n" ~
        "  <span class=\"module-closing\" id=\"mod-desc-closing\">[−]</span>\n" ~
        "  <div class=\"inner\" style=\"display: block;\">\n" ~
        "    <table class=\"book\">\n" ~
        "      <caption></caption>\n" ~
        "      <tbody>\n" ~
        "        <tr><th class=\"fst\" scope=\"col\">Submodule</th> <th class=\"fst\" scope=\"col\">Protection</th> <th scope=\"col\">Documentation</th></tr>\n" ~
        "        <tr><td class=\"donthyphenate nobr\"><a href=\"mymod_sub.html\">sub</a></td><td><em>pub</em></td><td>docs for sub</td></tr>\n\n" ~
        "    </tbody></table>\n" ~
        "  </div>\n" ~
        "</div>\n\n" ~
        "<hr>\n",
        "unexpected html for a submodule table");
}

__test trait_with_method {
    // A trait with a method
    let dmut mod_ = copy Module("mymod", "", INTERNAL_LOCATION, Protection::PUB);
    let dmut t = copy TraitSymbol("Foo", "", INTERNAL_LOCATION, Protection::PUB);
    t.methods = copy [copy Method("bar", "", INTERNAL_LOCATION, Protection::PUB)];
    let t2: &Symbol = t;
    mod_.childs = copy [t2];

    let out = dump(mod_);
    assert(out.len > 0us, "sanity: output should not be empty");

    let needle = "<span class=\"y_symbol_kind\" id=\"Foo\">trait</span>";
    let mut found = false;
    for i in 0us .. out.len {
        if (out.len - i >= needle.len && out[i .. i + needle.len] == needle) { found = true; }
    }
    assert(found, "expected the trait declaration header to appear");
}

__test functions_sorted_alphabetically {
    // Functions are sorted alphabetically by name, regardless of declaration order
    let dmut mod_ = copy Module("mymod", "", INTERNAL_LOCATION, Protection::PUB);
    let f1: &Symbol = copy Function("zeta", "", INTERNAL_LOCATION, Protection::PUB);
    let f2: &Symbol = copy Function("alpha", "", INTERNAL_LOCATION, Protection::PUB);
    mod_.childs = copy [f1, f2];

    let out = dump(mod_);
    let alphaPos = findFirst(out, "id=\"alpha\"");
    let zetaPos = findFirst(out, "id=\"zeta\"");

    assert(alphaPos.0 && zetaPos.0, "both function markers should be present");
    assert(alphaPos.1 < zetaPos.1, "alpha should be rendered before zeta, alphabetically");
}

__test templated_function {
    // A function wrapped in a Template renders with the template's test condition and params
    let dmut mod_ = copy Module("mymod", "", INTERNAL_LOCATION, Protection::PUB);
    let dmut tmpl = copy Template("foo", "", INTERNAL_LOCATION, Protection::PUB);
    tmpl.test = "T != U";

    let params: [&TemplateParam] = copy [copy TemplateVarParam("T", "class")];
    tmpl.params = params;

    let f: &Symbol = copy Function("foo", "", INTERNAL_LOCATION, Protection::PUB);
    tmpl.inners = copy [f];

    let tmplSym: &Symbol = tmpl;
    mod_.childs = copy [tmplSym];

    assert(dump(mod_) == MODULE_HEAD ~
        "<!-- <hr> <\\!--  -\\-> -->\n" ~
        "<div class=\"row-fluid declaration y_decl\"><h3 class=\"y_dd_decl_name\">\n" ~
        "    <span class=\"symbol-target\" id=\"foo\">&nbsp;</span><span class=\"y_symbol_kind\" id=\"foo\">fn</span> <span class=\"y_symbol_name symbol-link\">foo</span>  {class T}\n" ~
        "    <span class=\"symbol-closing\" id=\"foo-closing\">[−]</span></h3>\n" ~
        "</div>\n\n" ~
        "<div class=\"declaration-content y_dd_decl\" id=\"foo-content\"><pre><code class=\"language-ymir\">pub fn if (T != U)\n" ~
        "       foo {class T} ()-> </code></pre>\n" ~
        "<div class=\"doc\"><dt class=\"head\"></dt><dd></dd></div></div>\n",
        "unexpected html for a templated function");
}

fn findFirst(haystack: [c8], needle: [c8])-> (bool, usize) {
    if needle.len == 0us || haystack.len < needle.len return (false, 0us);

    for i in 0us .. (haystack.len - needle.len + 1us) {
        if haystack[i .. i + needle.len] == needle return (true, i);
    }

    (false, 0us)
}

/**
 * @returns: true iif 'needle' appears in 'haystack'
 * */
fn contains(haystack: [c8], needle: [c8])-> bool {
    findFirst(haystack, needle).0
}

/**
 * @returns: the html rendering of a module holding 'sym' alone
 * */
fn dumpOne(sym: &Symbol)-> [c8] {
    let dmut mod_ = copy Module("mymod", "", INTERNAL_LOCATION, Protection::PUB);
    mod_.childs = copy [sym];

    dump(mod_)
}

/**
 * A parameter of a function/method/constructor
 * */
fn mkParam(name: [c8], type: &Type)-> &Variable {
    let dmut v = copy Variable(name, "", INTERNAL_LOCATION, Protection::PUB);
    v.type = type;

    v
}

__test every_type_rendered {
    // Every kind of type is rendered in the signature of the function taking it as a parameter
    let dmut f = copy Function("everyType", "", INTERNAL_LOCATION, Protection::PUB);
    f.parameters = copy [
        mkParam("arr", copy ArrayType("", copy ScalarType("i32", ""), 3us)),
        mkParam("sli", copy SliceType("", copy ScalarType("u8", ""))),
        mkParam("map", copy MapType("", copy ScalarType("i32", ""), copy ScalarType("f64", ""))),
        mkParam("tup", copy TupleType("", copy [copy ScalarType("i32", ""), copy ScalarType("bool", "")])),
        mkParam("opt", copy OptionType("", copy ScalarType("i32", ""))),
        mkParam("ptr", copy PointerType("", copy ScalarType("void", ""))),
        mkParam("rng", copy RangeType("", copy ScalarType("i32", "")))
    ];

    let out = dumpOne(f);

    assert(contains(out, "arr : [i32 ; 3]"), "unexpected rendering of an array type");
    assert(contains(out, "sli : [u8]"), "unexpected rendering of a slice type");
    assert(contains(out, "map : [i32 => f64]"), "unexpected rendering of a map type");
    assert(contains(out, "tup : (i32,bool)"), "unexpected rendering of a tuple type");
    assert(contains(out, "opt : (i32)?"), "unexpected rendering of an option type");
    assert(contains(out, "ptr : *(void)"), "unexpected rendering of a pointer type");
    assert(contains(out, "rng : ..i32"), "unexpected rendering of a range type");
}

__test function_pointer_and_delegate_types {
    // Function pointer and delegate types, and the mutability prefix of a type
    let dmut f = copy Function("pointers", "", INTERNAL_LOCATION, Protection::PUB);
    f.parameters = copy [
        mkParam("fptr", copy FuncPtrType("", false, copy [copy ScalarType("i32", "")], copy [false], copy [false], copy ScalarType("bool", ""))),
        mkParam("dg", copy FuncPtrType("", true, copy [copy ScalarType("i32", ""), copy ScalarType("u8", "")], copy [true, false], copy [false, true], copy ScalarType("void", ""))),
        mkParam("mutSlice", copy SliceType("mut", copy ScalarType("i32", ""))),
        mkParam("dmutSlice", copy SliceType("dmut", copy ScalarType("i32", "")))
    ];

    let out = dumpOne(f);

    assert(contains(out, "fptr : fn (i32)-> bool"), "unexpected rendering of a function pointer type");
    assert(contains(out, "dg : dg (ref i32, lazy u8)-> void"), "unexpected rendering of a delegate type");
    assert(contains(out, "mutSlice : mut [i32]"), "a mutable type should be prefixed with \"mut\"");
    assert(contains(out, "dmutSlice : dmut [i32]"), "a deeply mutable type should be prefixed with \"dmut\"");
}

__test function_attributes_and_params {
    // The attributes, the parameter annotations, the return type and the thrown types of a function
    let dmut f = copy Function("annotated", "", INTERNAL_LOCATION, Protection::PRV);
    f.isInline = true;
    f.isUnsafe = true;
    f.retType = copy ScalarType("i32", "");
    f.throwers = copy [copy ClassType("core::exception::AssertError", "", false)];

    let dmut byRef = copy Variable("byRef", "", INTERNAL_LOCATION, Protection::PUB);
    byRef.type = copy ScalarType("i32", "");
    byRef.isRef = true;

    let dmut byMut = copy Variable("byMut", "", INTERNAL_LOCATION, Protection::PUB);
    byMut.type = copy ScalarType("i32", "");
    byMut.isMut = true;
    byMut.defaultValue = "0";

    f.parameters = copy [byRef, byMut];

    let out = dumpOne(f);

    assert(contains(out, "@{unsafe, inline}"), "a function that is both inline and unsafe should carry both attributes");
    assert(contains(out, "prv fn"), "the protection of the function should be rendered");
    assert(contains(out, "ref byRef : i32"), "a reference parameter should be annotated");
    assert(contains(out, "mut byMut : i32 = 0"), "a mutable parameter and its default value should be rendered");
    assert(contains(out, "-> i32"), "the return type should be rendered");
    assert(contains(out, "throws"), "the thrown types should be rendered");
}

__test single_attribute_functions {
    // An inline-only and an unsafe-only function carry a single attribute
    let dmut inl = copy Function("inl", "", INTERNAL_LOCATION, Protection::PUB);
    inl.isInline = true;
    assert(contains(dumpOne(inl), "@inline"), "an inline function should carry the inline attribute");

    let dmut uns = copy Function("uns", "", INTERNAL_LOCATION, Protection::PROT);
    uns.isUnsafe = true;
    let out = dumpOne(uns);

    assert(contains(out, "@unsafe"), "an unsafe function should carry the unsafe attribute");
    assert(contains(out, "prot fn"), "the protection of the function should be rendered");
}

__test record_with_ancestor {
    // A record with an ancestor, an implemented trait, a cte assertion and a documented field
    let dmut c = copy ClassSymbol("Foo", "", INTERNAL_LOCATION, Protection::PUB);
    c.isRecord = true;
    c.ancestor = copy ClassType("mymod::Base", "", false);
    c.implements = copy [(copy ClassType("std::stream::Streamable", "", false), "")];

    let dmut a = Assertion();
    a.test = "sizeof(T) > 0";
    a.msg = "\"a type of its own\"";
    a.doc = "the type must not be empty";
    c.asserts = copy [a];

    let dmut field = copy Variable("value", "the wrapped value", INTERNAL_LOCATION, Protection::PRV);
    field.type = copy ScalarType("i32", "");
    field.isMut = true;
    field.defaultValue = "0";
    c.fields = copy [field];

    let out = dumpOne(c);

    assert(contains(out, "pub record"), "a record should be rendered as a record");
    assert(contains(out, "over "), "the ancestor of the class should be rendered");
    assert(contains(out, "impl "), "the implemented traits should be rendered");
    assert(contains(out, "Assertions"), "the assertions should get a section of their own");
    assert(contains(out, "cte assert (sizeof(T) > 0, \"a type of its own\")"), "unexpected rendering of a cte assertion");
    assert(contains(out, "Fields"), "the fields should get a section of their own");
    assert(contains(out, "prv let mut value : i32 = 0;"), "unexpected rendering of a mutable field with a default value");
}

__test conditional_and_templated_members {
    // The conditional and templated members of a class each get a section of their own
    let dmut c = copy ClassSymbol("Foo", "", INTERNAL_LOCATION, Protection::PUB);
    c.isFinal = true;

    let dmut condField = copy Variable("only", "", INTERNAL_LOCATION, Protection::PUB);
    condField.type = copy ScalarType("i32", "");
    c.condFields = copy [(condField, "T == i32")];

    c.condCtors = copy [(copy Ctor("self", "", INTERNAL_LOCATION, Protection::PUB), "T == i32")];
    c.condMethods = copy [(copy Method("cond", "", INTERNAL_LOCATION, Protection::PUB), "T == i32")];

    let dmut tmplCtor = copy Template("self", "", INTERNAL_LOCATION, Protection::PUB);
    tmplCtor.test = "U != i32";
    tmplCtor.params = copy [copy TemplateVarParam("U", "class")];
    tmplCtor.inners = copy [copy Ctor("self", "", INTERNAL_LOCATION, Protection::PUB)];
    c.templateCtors = copy [tmplCtor];

    let dmut tmplMethod = copy Template("tmpl", "", INTERNAL_LOCATION, Protection::PUB);
    tmplMethod.test = "U != i32";
    tmplMethod.params = copy [copy TemplateVarParam("U", "class")];
    tmplMethod.inners = copy [copy Method("tmpl", "", INTERNAL_LOCATION, Protection::PUB)];
    c.templateMethods = copy [tmplMethod];

    let out = dumpOne(c);

    assert(contains(out, "@final"), "a final class should carry the final attribute");
    assert(contains(out, "Conditional Fields"), "the conditional fields should get a section of their own");
    assert(contains(out, "Conditional Constructors"), "the conditional constructors should get a section of their own");
    assert(contains(out, "Conditional Methods"), "the conditional methods should get a section of their own");
    assert(contains(out, "Template Constructors"), "the template constructors should get a section of their own");
    assert(contains(out, "Template Methods"), "the template methods should get a section of their own");
    assert(contains(out, "if (T == i32)"), "the condition of a conditional member should be rendered");
    assert(contains(out, "if (U != i32)"), "the test of a templated member should be rendered");
}

__test abstract_class_named_ctor {
    // An abstract class, a named constructor and a method carrying several attributes
    let dmut c = copy ClassSymbol("Foo", "", INTERNAL_LOCATION, Protection::PUB);
    c.isAbstract = true;

    let dmut ctor = copy Ctor("named", "", INTERNAL_LOCATION, Protection::PROT);
    ctor.isUnsafe = true;
    ctor.parameters = copy [mkParam("x", copy ScalarType("i32", ""))];
    ctor.throwers = copy [copy ClassType("core::exception::AssertError", "", false)];
    c.ctors = copy [ctor];

    let dmut m = copy Method("size", "", INTERNAL_LOCATION, Protection::PUB);
    m.isFinal = true;
    m.isField = true;
    m.isMutable = true;
    m.retType = copy ScalarType("usize", "");
    m.throwers = copy [copy ClassType("core::exception::AssertError", "", false)];
    m.parameters = copy [mkParam("i", copy ScalarType("i32", ""))];
    c.methods = copy [m];

    let out = dumpOne(c);

    assert(contains(out, "@abstract"), "an abstract class should carry the abstract attribute");
    assert(contains(out, "Constructors"), "the constructors should get a section of their own");
    assert(contains(out, "prot self named ("), "a named constructor should be rendered with its name");
    assert(contains(out, "@{final, field}"), "a method carrying several attributes should list them all");
    assert(contains(out, "mut self"), "a mutable method should take a mutable self");
    assert(contains(out, "-> usize"), "the return type of the method should be rendered");
}

__test macro_ctor_rule_with_skips {
    // A macro with a constructor rule and a rule with skips
    let dmut m = copy Macro("mymacro", "", INTERNAL_LOCATION, Protection::PUB);

    let dmut ctor = copy MacroRule("self", "", INTERNAL_LOCATION, Protection::PUB);
    ctor.isCtor = true;
    ctor.rule = "expr=__expr";
    m.ctors = copy [ctor];

    let dmut rule = copy MacroRule("run", "", INTERNAL_LOCATION, Protection::PUB);
    rule.rule = "body=__expr";
    rule.skips = copy [" ", "\\n"];
    m.rules = copy [rule];

    let out = dumpOne(m);

    assert(contains(out, "Constructors"), "the constructor rules should get a section of their own");
    assert(contains(out, "Rules"), "the rules should get a section of their own");
    assert(contains(out, "pub self ("), "the constructor rule should be rendered as a constructor");
    assert(contains(out, "pub fn run ("), "a rule should be rendered as a function");
    assert(contains(out, "skips"), "the skipped tokens of a rule should be rendered");
}

__test thread_local_static_global {
    // A thread local static global, with a type and a value
    let dmut g = copy Global("COUNTER", "", INTERNAL_LOCATION, Protection::PUB);
    g.isStatic = true;
    g.isThreadLocal = true;
    g.type = copy ScalarType("i32", "");
    g.value = "0";

    let out = dumpOne(g);

    assert(contains(out, "@thread"), "a thread local global should carry the thread attribute");
    assert(contains(out, "pub static COUNTER : i32 = 0"), "unexpected rendering of a static global");
}

__test enum_cross_module_link {
    // An enum whose values come from another module link to that module's page
    let dmut e = copy EnumSymbol("Color", "", INTERNAL_LOCATION, Protection::PUB);
    e.type = copy EnumType("Color", "", copy ClassType("othermod::Shade", "", false));
    e.fields = copy [("RED", "Shade::RED", "the red shade")];

    let out = dumpOne(e);

    assert(contains(out, "othermod.html#Shade"), "a type of another module should link to that module's page");
    assert(contains(out, "RED = Shade::RED"), "the value of an enum field should be rendered");
    assert(contains(out, "the red shade"), "the documentation of an enum field should be rendered");
}

__test submodule_table_strips_template {
    // The submodule table strips the template instantiation off the name of a templated module
    let dmut mod_ = copy Module("mymod", "", INTERNAL_LOCATION, Protection::PUB);
    let sub: &Symbol = copy Module("mymod::vec!{i32}", "a templated module", INTERNAL_LOCATION, Protection::PUB);
    mod_.childs = copy [sub];

    let out = dump(mod_);

    assert(contains(out, "Inner modules"), "the submodule table should be rendered");
    assert(contains(out, "a templated module"), "the documentation of the submodule should be rendered");
}
