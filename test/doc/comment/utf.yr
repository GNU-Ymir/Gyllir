use gyllir::doc::comment::utf;

__test {
    // Content with no stars or escape sequences is left untouched
    assert(escapeChars("hello world") == "hello world", "unexpected result for plain text");
}

__test {
    // A "*" at the very start of the content is the doc-comment continuation marker, and is stripped
    assert(escapeChars("* text") == " text", "a leading star should be stripped");
}

__test {
    // Leading spaces before the star are kept, only the star itself is removed
    assert(escapeChars("   * text") == "    text", "leading spaces should be kept, only the star removed");
}

__test {
    // Only the first star of a run is stripped, further stars on the same line are kept
    assert(escapeChars("** text") == "* text", "only the first leading star should be stripped");
}

__test {
    // A star that isn't at the start of a line (i.e. preceded by non-space content) is kept as-is
    assert(escapeChars("abc*def") == "abc*def", "a star in the middle of a line should not be stripped");
}

__test {
    // Each line is considered independently: a newline resets the "start of line" state
    assert(escapeChars("one\n * two") == "one\n  two", "a star at the start of a subsequent line should also be stripped");

    // ...but a star right after another word (not a fresh line) is not special
    assert(escapeChars("a*\n*b") == "a*\nb", "unexpected result across a line boundary");
}

__test {
    // Known escape sequences are converted to their real control character
    assert(escapeChars("\\n") == "\n", "\\n should escape to a real line feed");
    assert(escapeChars("\\t") == "\t", "\\t should escape to a real tab");
    assert(escapeChars("\\r") == "\r", "\\r should escape to a real carriage return");
    assert(escapeChars("\\\\") == "\\", "\\\\ should escape to a single backslash");
    assert(escapeChars("\\'") == "'", "\\' should escape to a single quote");
    assert(escapeChars("\\\"") == "\"", "\\\" should escape to a double quote");

    // The remaining mappings target non-printable control characters
    assert(escapeChars("\\a") == "\u{7}", "\\a should escape to a real bell character");
    assert(escapeChars("\\b") == "\u{8}", "\\b should escape to a real backspace character");
    assert(escapeChars("\\f") == "\u{12}", "\\f should escape to a real form feed character");
    assert(escapeChars("\\v") == "\u{11}", "\\v should escape to a real vertical tab character");
}

__test {
    // A backslash followed by a character that has no known escape mapping is kept as-is
    assert(escapeChars("\\z") == "\\z", "an unknown escape sequence should be kept unmodified");
}

__test {
    // A lone trailing backslash (nothing left to escape) is kept as-is, and doesn't crash
    assert(escapeChars("abc\\") == "abc\\", "a trailing lone backslash should be kept unmodified");
}

__test {
    // Escaping and star stripping compose: an escaped newline also resets the star-stripping state
    assert(escapeChars("one\\n * two") == "one\n  two", "an escaped newline should reset the star-stripping state");
}
