use gyllir::doc::loader;
use gyllir::doc::symbols::_;
use gyllir::doc::symbols::template_::_;
use gyllir::doc::types::_;

use std::config::_;
use std::config::json;
use std::stream;

__test unknown_kind_loads_as_none {
    // An unrecognized "kind" (or a missing/malformed config) loads as a None symbol
    let l = SymbolLoader();

    let unknown = l.load(json#{"kind" : "not-a-real-kind", "name" : "x"});
    assert(unknown of none_::None, "an unknown kind should load as None");

    let noKind = l.load(json#{"name" : "x"});
    assert(noKind of none_::None, "a config without a \"kind\" should load as None");

    let notDict = l.load(copy Str("nope"));
    assert(notDict of none_::None, "a non-dict config should load as None");
}

__test load_standard_fields {
    // loadStandard(): name/doc/location/protection are all read from their respective keys
    let l = SymbolLoader();
    let f = l.load(json#{
        "kind" : "function",
        "name" : "foo",
        "doc" : "does foo things",
        "loc_file" : "src/foo.yr",
        "loc_line" : 12,
        "loc_col" : 3,
        "protect" : "prot"
    });

    if let fn_: &Function = f {
        assert(fn_.name == "foo", "unexpected name");
        assert(fn_.doc == "does foo things", "unexpected doc");
        assert(fn_.loc.filename.toStr() == "src/foo.yr", "unexpected loc filename");
        assert(fn_.loc.line == 12u64 && fn_.loc.col == 3u64, "unexpected loc line/col");
        assert(fn_.protect == Protection::PROT, "unexpected protection");
    } else assert(false, "expected a Function symbol");
}

__test protection_defaults_to_prv {
    // Protection defaults to PRV when "protect" is missing or unrecognized
    let l = SymbolLoader();
    let f = l.load(json#{"kind" : "function", "name" : "foo"});
    if let fn_: &Function = f {
        assert(fn_.protect == Protection::PRV, "protection should default to PRV");
    } else assert(false, "expected a Function symbol");
}

__test function_params_attrs_throwers {
    // A function: params (with a fptr-typed param exercising the refs/lazys arrays), attributes, throwers, ret_type
    let l = SymbolLoader();
    let f = l.load(json#{
        "kind" : "function",
        "name" : "foo",
        "attributes" : ["unsafe", "inline"],
        "params" : [
            {"name" : "cb", "type" : {
                "kind" : "fptr",
                "params" : [{"kind" : "scalar", "name" : "i32"}, {"kind" : "scalar", "name" : "bool"}],
                "refs" : ["true", "false"],
                "lazys" : ["false", "true"],
                "return" : {"kind" : "scalar", "name" : "void"}
            }}
        ],
        "throwers" : [{"kind" : "scalar", "name" : "Err"}],
        "ret_type" : {"kind" : "scalar", "name" : "i32"}
    });

    if let fn_: &Function = f {
        assert(fn_.isUnsafe && fn_.isInline, "unexpected attributes");
        assert(fn_.parameters.len == 1us, "expected a single parameter");
        assert(fn_.throwers.len == 1us, "expected a single thrower");

        let dmut retStream = copy StringStream();
        retStream:.write(fn_.retType);
        assert(retStream[] == "Scalar (i32)", "unexpected ret_type");

        if let fptrT: &FuncPtrType = fn_.parameters[0].type {
            assert(!fptrT.isDelegate, "expected a plain fptr, not a delegate");
            assert(fptrT.parameters.len == 2us, "expected two fptr parameters");
            // this is exactly the array that the loadFuncPtrType refs/lazys copy-paste bug corrupted
            assert(fptrT.refs == copy [true, false], "unexpected refs array");
            assert(fptrT.lazys == copy [false, true], "unexpected lazys array");
        } else assert(false, "expected the parameter's type to be a FuncPtrType");
    } else assert(false, "expected a Function symbol");
}

__test ctor_unsafe_and_params {
    // A ctor: unsafe attribute and parameters
    let l = SymbolLoader();
    let c = l.load(json#{
        "kind" : "ctor",
        "name" : "self",
        "attributes" : ["unsafe"],
        "params" : [{"name" : "x", "type" : {"kind" : "scalar", "name" : "i32"}}]
    });

    if let c_: &Ctor = c {
        assert(c_.isUnsafe, "expected isUnsafe to be set");
        assert(c_.parameters.len == 1us, "expected a single parameter");
    } else assert(false, "expected a Ctor symbol");
}

__test method_mutable_self_and_attrs {
    // A method: mutable self, field/final attributes, ret_type
    let l = SymbolLoader();
    let m = l.load(json#{
        "kind" : "method",
        "name" : "foo",
        "mutable" : "true",
        "attributes" : ["field", "final"],
        "ret_type" : {"kind" : "scalar", "name" : "bool"}
    });

    if let m_: &Method = m {
        assert(m_.isMutable, "expected isMutable to be set");
        assert(m_.isField && m_.isFinal && !m_.isUnsafe, "unexpected attributes");
    } else assert(false, "expected a Method symbol");
}

__test class_fields_ctor_method_assert {
    // A class: fields (one plain, one conditional), a ctor, a method, an assert, an implements, an ancestor
    let l = SymbolLoader();
    let c = l.load(json#{
        "kind" : "class",
        "name" : "Foo",
        "has_dtor" : "true",
        "abstract" : "true",
        "final" : "false",
        "ancestor" : {"kind" : "class", "name" : "Base"},
        "fields" : [
            {"name" : "x", "type" : {"kind" : "scalar", "name" : "i32"}},
            {"name" : "y", "type" : {"kind" : "scalar", "name" : "i32"}, "condition" : "is!{T}{i32}"}
        ],
        "ctors" : [{"kind" : "ctor", "name" : "self"}],
        "methods" : [{"kind" : "method", "name" : "bar"}],
        "asserts" : [{"test" : "true", "msg" : "always"}],
        "implements" : [{"trait" : {"kind" : "class", "name" : "Comparable"}}]
    });

    if let c_: &ClassSymbol = c {
        assert(c_.hasDtor && c_.isAbstract && !c_.isFinal, "unexpected flags");
        assert(c_.fields.len == 1us, "conditional fields should not go into the plain fields list");
        assert(c_.condFields.len == 1us && c_.condFields[0]._1 == "is!{T}{i32}", "unexpected condFields");
        assert(c_.ctors.len == 1us, "expected a single ctor");
        assert(c_.methods.len == 1us, "expected a single method");
        assert(c_.asserts.len == 1us && c_.asserts[0].test == "true", "unexpected asserts");
        assert(c_.implements.len == 1us, "expected a single implements entry");

        let dmut ancStream = copy StringStream();
        ancStream:.write(c_.ancestor);
        assert(ancStream[] == "Class (Base)", "unexpected ancestor");
    } else assert(false, "expected a ClassSymbol");
}

__test entity_and_record_flags {
    // "entity"/"record" kinds set the corresponding flags on the same ClassSymbol
    let l = SymbolLoader();
    let e = l.load(json#{"kind" : "entity", "name" : "Foo"});
    if let e_: &ClassSymbol = e {
        assert(e_.isEntity && !e_.isRecord, "unexpected entity flags");
    } else assert(false, "expected a ClassSymbol");

    let r = l.load(json#{"kind" : "record", "name" : "Foo"});
    if let r_: &ClassSymbol = r {
        assert(r_.isRecord && !r_.isEntity, "unexpected record flags");
    } else assert(false, "expected a ClassSymbol");
}

__test trait_methods_and_asserts {
    // A trait: methods (one conditional) and asserts
    let l = SymbolLoader();
    let t = l.load(json#{
        "kind" : "trait",
        "name" : "Foo",
        "methods" : [
            {"kind" : "method", "name" : "bar"},
            {"kind" : "method", "name" : "baz", "condition" : "is!{T}{i32}"}
        ],
        "asserts" : [{"test" : "true", "msg" : "always"}]
    });

    if let t_: &TraitSymbol = t {
        assert(t_.methods.len == 1us, "conditional methods should not go into the plain methods list");
        assert(t_.condMethods.len == 1us, "expected a single condMethods entry");
        assert(t_.asserts.len == 1us, "expected a single assert");
    } else assert(false, "expected a TraitSymbol");
}

__test enum_proxy_type_and_fields {
    // An enum: proxy type and fields (name, value, doc)
    let l = SymbolLoader();
    let e = l.load(json#{
        "kind" : "enum",
        "name" : "Color",
        "type" : {"kind" : "scalar", "name" : "u8"},
        "fields" : [{"name" : "RED", "value" : "0", "doc" : "the color red"}]
    });

    if let e_: &EnumSymbol = e {
        assert(e_.fields.len == 1us, "expected a single field");
        assert(e_.fields[0]._0 == "RED" && e_.fields[0]._1 == "0" && e_.fields[0]._2 == "the color red",
               "unexpected field tuple");

        let dmut typeStream = copy StringStream();
        typeStream:.write(e_.type);
        assert(typeStream[] == "Scalar (u8)", "unexpected proxy type");
    } else assert(false, "expected an EnumSymbol");
}

__test global_flags_type_value {
    // A global: thread_local/static flags, mutability, type, value
    let l = SymbolLoader();
    let g = l.load(json#{
        "kind" : "global",
        "name" : "COUNT",
        "thread_local" : "true",
        "static" : "true",
        "mutability" : "mut",
        "type" : {"kind" : "scalar", "name" : "i32"},
        "value" : "0"
    });

    if let g_: &Global = g {
        assert(g_.isThreadLocal && g_.isStatic && g_.isMutable, "unexpected flags");
        assert(g_.value == "0", "unexpected value");
    } else assert(false, "expected a Global symbol");
}

__test aka_with_literal_value {
    // A "def" (aka) with a literal value
    let l = SymbolLoader();
    let a = l.load(json#{"kind" : "def", "name" : "MAX", "value" : "42"});
    if let a_: &Aka = a {
        assert(a_.isValue && a_.value == "42", "unexpected value-form aka");
    } else assert(false, "expected an Aka symbol");
}

__test aka_with_type {
    // A "def" (aka) with a type
    let l = SymbolLoader();
    let a = l.load(json#{"kind" : "def", "name" : "MyInt", "type" : {"kind" : "scalar", "name" : "i32"}});
    if let a_: &Aka = a {
        assert(!a_.isValue, "unexpected value-form flag on a type aka");

        let dmut typeStream = copy StringStream();
        typeStream:.write(a_.type);
        assert(typeStream[] == "Scalar (i32)", "unexpected aka type");
    } else assert(false, "expected an Aka symbol");
}

__test macro_ctor_and_normal_rules {
    // A macro: ctor rules and normal rules, each with a rule string and skip alternatives
    let l = SymbolLoader();
    let m = l.load(json#{
        "kind" : "macro",
        "name" : "mymacro",
        "ctors" : [{"name" : "c1", "kind" : "ctor", "rule" : "expr"}],
        "rules" : [{"name" : "r1", "kind" : "rule", "rule" : "expr", "skips" : ["+", "-"]}]
    });

    if let m_: &Macro = m {
        assert(m_.ctors.len == 1us && m_.ctors[0].isCtor, "unexpected ctor rules");
        assert(m_.rules.len == 1us && !m_.rules[0].isCtor, "unexpected normal rules");
        assert(m_.rules[0].skips == copy ["+", "-"], "unexpected skips");
    } else assert(false, "expected a Macro symbol");
}

__test module_loads_children {
    // A module recursively loads its children, dropping any that fall back to None
    let l = SymbolLoader();
    let m = l.load(json#{
        "kind" : "module",
        "name" : "mymod",
        "childs" : [
            {"kind" : "function", "name" : "foo"},
            {"kind" : "not-a-real-kind", "name" : "bogus"}
        ]
    });

    if let m_: &Module = m {
        assert(m_.childs.len == 1us, "the unrecognized child should have been dropped");
        assert(m_.childs[0] of Function, "the remaining child should be the function");
    } else assert(false, "expected a Module symbol");
}

__test template_params_and_content {
    // A template: params of every kind, a test condition, and inner content
    let l = SymbolLoader();
    let t = l.load(json#{
        "kind" : "template",
        "name" : "Foo",
        "test" : "T != U",
        "templates" : [
            {"kind" : "class", "name" : "T"},
            {"kind" : "of", "name" : "U"},
            {"kind" : "variadic", "name" : "V", "value" : "true"},
            {"kind" : "and", "content" : [{"name" : "A"}, {"name" : "B"}]},
            {"name" : "W"}
        ],
        "content" : [{"kind" : "function", "name" : "foo"}]
    });

    if let t_: &Template = t {
        assert(t_.test == "T != U", "unexpected template test");
        assert(t_.params.len == 5us, "unexpected number of template params");
        assert(t_.params[0] of TemplateVarParam, "expected a var param for \"class\"");
        assert(t_.params[2] of TemplateVariadicParam, "expected a variadic param");
        assert(t_.params[3] of TemplateAndParam, "expected an \"and\" param");
        assert(t_.params[4] of TemplateAnyParam, "expected an any param as fallback");
        assert(t_.inners.len == 1us, "expected a single inner symbol");
    } else assert(false, "expected a Template symbol");
}

__test load_type_every_kind {
    // loadType(): every type kind maps to its corresponding Type class
    let l = SymbolLoader();

    let f1 = l.load(json#{"kind" : "function", "name" : "f", "ret_type" : {"kind" : "array", "len" : 3, "inner" : {"kind" : "scalar", "name" : "i32"}}});
    if let fn1: &Function = f1 {
        assert(fn1.retType of ArrayType, "expected an ArrayType");
    } else assert(false, "expected a Function symbol");

    let f2 = l.load(json#{"kind" : "function", "name" : "f", "ret_type" : {"kind" : "tuple", "inners" : [{"kind" : "scalar", "name" : "i32"}]}});
    if let fn2: &Function = f2 {
        assert(fn2.retType of TupleType, "expected a TupleType");
    } else assert(false, "expected a Function symbol");

    let f3 = l.load(json#{"kind" : "function", "name" : "f", "ret_type" : {"kind" : "map", "key" : {"kind" : "scalar", "name" : "i32"}, "value" : {"kind" : "scalar", "name" : "bool"}}});
    if let fn3: &Function = f3 {
        assert(fn3.retType of MapType, "expected a MapType");
    } else assert(false, "expected a Function symbol");

    let f4 = l.load(json#{"kind" : "function", "name" : "f", "ret_type" : {"kind" : "option", "inner" : {"kind" : "scalar", "name" : "i32"}}});
    if let fn4: &Function = f4 {
        assert(fn4.retType of OptionType, "expected an OptionType");
    } else assert(false, "expected a Function symbol");

    let f5 = l.load(json#{"kind" : "function", "name" : "f", "ret_type" : {"kind" : "pointer", "inner" : {"kind" : "scalar", "name" : "i32"}}});
    if let fn5: &Function = f5 {
        assert(fn5.retType of PointerType, "expected a PointerType");
    } else assert(false, "expected a Function symbol");

    let f6 = l.load(json#{"kind" : "function", "name" : "f", "ret_type" : {"kind" : "range", "inner" : {"kind" : "scalar", "name" : "i32"}}});
    if let fn6: &Function = f6 {
        assert(fn6.retType of RangeType, "expected a RangeType");
    } else assert(false, "expected a Function symbol");

    let f7 = l.load(json#{"kind" : "function", "name" : "f", "ret_type" : {"kind" : "slice", "inner" : {"kind" : "scalar", "name" : "i32"}}});
    if let fn7: &Function = f7 {
        assert(fn7.retType of SliceType, "expected a SliceType");
    } else assert(false, "expected a Function symbol");

    let f8 = l.load(json#{"kind" : "function", "name" : "f", "ret_type" : {"kind" : "enum", "name" : "Color", "proxy" : {"kind" : "scalar", "name" : "u8"}}});
    if let fn8: &Function = f8 {
        assert(fn8.retType of EnumType, "expected an EnumType");
    } else assert(false, "expected a Function symbol");

    let f9 = l.load(json#{"kind" : "function", "name" : "f", "ret_type" : {"kind" : "record", "name" : "Foo", "mutability" : "dmut"}});
    if let fn9: &Function = f9 {
        if let ct: &ClassType = fn9.retType {
            assert(ct.isRecord && ct.innerMut, "expected a mutable record ClassType");
        } else assert(false, "expected a ClassType");
    } else assert(false, "expected a Function symbol");

    // An unrecognized kind falls back to AnyType, named after the "name" key
    let f10 = l.load(json#{"kind" : "function", "name" : "f", "ret_type" : {"kind" : "something-else", "name" : "Weird"}});
    if let fn10: &Function = f10 {
        assert(fn10.retType of AnyType, "expected an AnyType fallback");
    } else assert(false, "expected a Function symbol");
}
