use gyllir::doc::symbols::_;
use gyllir::doc::symbols::aka;
use gyllir::doc::types::_;
use gyllir::doc::types::scalar;

use std::stream;

__test type_aka_rendering {
    // A type alias renders its target type, prefixed with " : "
    let dmut a = copy Aka("Foo", "", INTERNAL_LOCATION, Protection::PUB);
    a.type = copy ScalarType("i32", "");

    let dmut stream = copy StringStream();
    stream:.write(a);

    assert(stream[] == "Aka Foo => :(0,0)\n\t : Scalar (i32)", "unexpected rendering for a type aka");
}

__test value_aka_rendering {
    // A value alias renders its literal value, prefixed with " = "
    let dmut a = copy Aka("Foo", "", INTERNAL_LOCATION, Protection::PUB);
    a.isValue = true;
    a.value = "42";

    let dmut stream = copy StringStream();
    stream:.write(a);

    assert(stream[] == "Aka Foo => :(0,0)\n\t = 42", "unexpected rendering for a value aka");
}
