use gyllir::doc::symbols::_;
use gyllir::doc::symbols::def_;
use gyllir::doc::types::_;
use gyllir::doc::types::scalar;

use std::stream;

__test type_def_rendering {
    // A type alias renders its target type, prefixed with " : "
    let dmut d = copy Def("Foo", "", INTERNAL_LOCATION, Protection::PUB);
    d.type = copy ScalarType("i32", "");

    let dmut stream = copy StringStream();
    stream:.write(d);

    assert(stream[] == "Def Foo => :(0,0)\n\t : Scalar (i32)", "unexpected rendering for a type def");
}

__test value_def_rendering {
    // A value alias renders its literal value, prefixed with " = "
    let dmut d = copy Def("Foo", "", INTERNAL_LOCATION, Protection::PUB);
    d.isValue = true;
    d.value = "42";

    let dmut stream = copy StringStream();
    stream:.write(d);

    assert(stream[] == "Def Foo => :(0,0)\n\t = 42", "unexpected rendering for a value def");
}
