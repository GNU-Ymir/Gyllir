use gyllir::doc::symbols::template_::_;
use gyllir::doc::symbols::template_::and;
use gyllir::doc::symbols::template_::any;

use std::stream;

__test and_combination_rendering {
    let content: [&TemplateParam] = copy [copy TemplateAnyParam("T"), copy TemplateAnyParam("U")];
    let p = copy TemplateAndParam(content);

    let dmut stream = copy StringStream();
    stream:.write(p);

    assert(stream[] == "T && U", "unexpected rendering for an \"and\" combination of template params");
}

__test empty_and_combination {
    let p = copy TemplateAndParam([]);

    let dmut stream = copy StringStream();
    stream:.write(p);

    assert(stream[] == "", "unexpected rendering for an empty \"and\" combination");
}
