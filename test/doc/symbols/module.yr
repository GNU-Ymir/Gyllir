use gyllir::doc::symbols::{_, function, module};

use std::stream;

__test module_with_one_child {
    let dmut m     = copy Module("m", "", INTERNAL_LOCATION, Protection::PUB);
    let f: &Symbol = copy Function("f", "", INTERNAL_LOCATION, Protection::PUB);
    m.childs = copy [f];

    let dmut stream = copy StringStream();
    stream:.write(m);

    assert(stream[] == "Module : m => :(0,0)\n\tFunction f => :(0,0)\n\t\tfn ()-> Any ()\n",
           "unexpected rendering for a module with one child (nested indentation should compound)");
}

__test empty_module_rendering {
    let m = copy Module("empty", "", INTERNAL_LOCATION, Protection::PUB);

    let dmut stream = copy StringStream();
    stream:.write(m);

    assert(stream[] == "Module : empty => :(0,0)\n", "unexpected rendering for an empty module");
}
