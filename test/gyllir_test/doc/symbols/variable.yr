use gyllir::doc::symbols::_;
use gyllir::doc::symbols::variable;
use gyllir::doc::types::_;
use gyllir::doc::types::scalar;

use std::stream;

__test {
    // Defaults: no mut/ref/lazy, no default value, and an empty type
    let v = copy Variable("x", "", INTERNAL_LOCATION, Protection::PUB);
    let dmut stream = copy StringStream();
    stream:.write(v);

    assert(stream[] == "x : Any ()", "unexpected rendering for a bare variable");
}

__test {
    let dmut v = copy Variable("x", "", INTERNAL_LOCATION, Protection::PUB);
    v.type = copy ScalarType("i32", "");

    let dmut stream = copy StringStream();
    stream:.write(v);

    assert(stream[] == "x : Scalar (i32)", "unexpected rendering for a typed variable");
}

__test {
    // mut/ref/lazy prefixes are written in that fixed order
    let dmut v = copy Variable("x", "", INTERNAL_LOCATION, Protection::PUB);
    v.type = copy ScalarType("i32", "");
    v.isMut = true;
    v.isRef = true;
    v.isLazy = true;

    let dmut stream = copy StringStream();
    stream:.write(v);

    assert(stream[] == "mut ref lazy x : Scalar (i32)", "unexpected rendering for mut/ref/lazy prefixes");
}

__test {
    // A non-empty default value is appended
    let dmut v = copy Variable("x", "", INTERNAL_LOCATION, Protection::PUB);
    v.type = copy ScalarType("i32", "");
    v.defaultValue = "42";

    let dmut stream = copy StringStream();
    stream:.write(v);

    assert(stream[] == "x : Scalar (i32) = 42", "unexpected rendering for a variable with a default value");
}
