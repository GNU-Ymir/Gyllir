__test get_commit_sha_with_no_commit_fails {
    // getCommitSha() on a repository that has no commit yet fails: "HEAD" names no commit
    let dir = mkScratchRepo();
    let mgr = GitManager(cwd-> dir);

    let mut threw = false;
    {
        mgr.getCommitSha();
    } catch {
        _: &GitError => { threw = true; }
        _: &FsError => { threw = true; }
    }

    assert(threw, "getting the commit sha of a repository with no commit should throw a GitError");
}

__test fetch_brings_commits_in_without_moving_the_checkout {
    // fetch() brings the objects of a commit in, which is how a pinned commit that is missing from
    // a checkout is recovered, and leaves the working tree where it was
    let src = mkScratchRepo();
    commitFile(src, "a.txt", "v1", "first commit");
    let srcMgr = GitManager(cwd-> src);

    let bare = mkBareRepo();
    srcMgr.setRemote(bare.toStr());
    srcMgr.push(copy ["master"]);

    let dst = sys::tempDirectory(prefix-> "gyllir_git_fetch_commit_test_");
    let dstMgr = GitManager(cwd-> dst);
    dstMgr.clone(bare.toStr());

    commitFile(src, "b.txt", "v2", "second commit");
    let second = srcMgr.getCommitSha();
    srcMgr.push(copy ["master"]);

    assert(!dstMgr.hasCommit(second), "sanity: the second commit should be unknown to the clone");

    dstMgr.fetch();

    assert(dstMgr.hasCommit(second), "fetch() should bring the pushed commit in");
    assert(!sys::isFile(dst.push("b.txt")), "fetch() should not move the checkout");
}
