    }

    assert(threw, "checking out a non-existent branch should throw a GitError");
}

__test branch_create_checkout_delete_round_trip {
    // createBranch()/checkout()/deleteBranch() round trip; getTagList() surfaces branch names too
    let dir = mkScratchRepo();
    commitFile(dir, "a.txt", "hello", "first commit");
    let mgr = GitManager(cwd-> dir);

    mgr.createBranch("feature");
    assert(containsSub(mgr.getTagList(), "feature"), "the new branch should be listed");

    mgr.checkout("feature");
    assert(mgr.getCurrentBranchName() == "feature", "checkout() should switch the current branch");

    mgr.checkout("master");
    assert(mgr.getCurrentBranchName() == "master", "checkout() should switch back");

    mgr.deleteBranch("feature");
    assert(!containsSub(mgr.getTagList(), "feature"), "the deleted branch should no longer be listed");
}

__test tag_create_delete_round_trip {
    // createTag()/deleteTag() round trip, surfaced through getTagList()
    let dir = mkScratchRepo();
    commitFile(dir, "a.txt", "hello", "first commit");
    let mgr = GitManager(cwd-> dir);

    mgr.createTag("v1.0.0");
    assert(containsSub(mgr.getTagList(), "v1.0.0"), "the new tag should be listed");

    mgr.deleteTag("v1.0.0");
    assert(!containsSub(mgr.getTagList(), "v1.0.0"), "the deleted tag should no longer be listed");
}

__test clone_copies_local_repository {
    // clone() copies the full history/content of a local repository
    let src = mkScratchRepo();
    commitFile(src, "a.txt", "hello from source", "first commit");

    let dst = sys::tempDirectory(prefix-> "gyllir_git_clone_test_");
    let dstMgr = GitManager(cwd-> dst);
    dstMgr.clone(src.toStr());

    assert(sys::isFile(dst.push("a.txt")), "clone() should bring the source's committed files along");
}

__test pushed_tag_visible_after_fetch {
    // setRemote()+push()+fetchTags(): a tag pushed to a bare "remote" is visible after fetching it into a fresh clone
    let src = mkScratchRepo();
    commitFile(src, "a.txt", "hello", "first commit");
    let srcMgr = GitManager(cwd-> src);
    srcMgr.createTag("v2.0.0");

    let bare = mkBareRepo();
    srcMgr.setRemote(bare.toStr());
    srcMgr.push(copy ["master", "v2.0.0"]);

    let dst = sys::tempDirectory(prefix-> "gyllir_git_fetch_test_");
    let dstMgr = GitManager(cwd-> dst);
    dstMgr.clone(bare.toStr());

    assert(containsSub(dstMgr.getTagList(), "v2.0.0"), "a tag pushed to the remote should be present right after cloning it");
}

__test pull_brings_in_pushed_commits {
    // pull() brings in commits pushed to the shared remote by another clone
    let src = mkScratchRepo();
    commitFile(src, "a.txt", "v1", "first commit");
    let srcMgr = GitManager(cwd-> src);

    let bare = mkBareRepo();
    srcMgr.setRemote(bare.toStr());
    srcMgr.push(copy ["master"]);

    let dst = sys::tempDirectory(prefix-> "gyllir_git_pull_test_");
    let dstMgr = GitManager(cwd-> dst);
    dstMgr.clone(bare.toStr());

    // Push a second commit from the source, then pull it into the destination clone
    commitFile(src, "b.txt", "v2", "second commit");
    srcMgr.push(copy ["master"]);

    dstMgr.pull("master");
    assert(sys::isFile(dst.push("b.txt")), "pull() should bring in commits pushed by another clone");
}

__test commit_sha_names_the_checked_out_commit {
    // getCommitSha() reports the commit HEAD points at, the one a lock file pins a dependency to
    let dir = mkScratchRepo();
    commitFile(dir, "a.txt", "hello", "first commit");

    let mgr = GitManager(cwd-> dir);
    let first = mgr.getCommitSha();

    assert(first.len == 40us, "a commit sha is 40 hexadecimal characters, got: \"" ~ first ~ "\"");

    commitFile(dir, "b.txt", "world", "second commit");
    assert(mgr.getCommitSha() != first, "a new commit should change the sha HEAD points at");

    mgr.checkout(first);
    assert(mgr.getCommitSha() == first, "checking a commit out should bring HEAD back to it");
}

__test has_commit_tells_a_known_commit_from_an_unknown_one {
    // hasCommit() is what says whether a pinned commit can be checked out without a fetch
    let dir = mkScratchRepo();
    commitFile(dir, "a.txt", "hello", "first commit");

    let mgr = GitManager(cwd-> dir);

    assert(mgr.hasCommit(mgr.getCommitSha()), "the repository should hold the commit HEAD points at");
    assert(!mgr.hasCommit("0123456789012345678901234567890123456789"), "a commit that was never created should not be found");
    assert(!mgr.hasCommit(""), "an empty sha names no commit");
}

__test get_remote_reports_the_configured_url {
    // getRemote() is what tells that a dependency now comes from another repository
    let dir = mkScratchRepo();
    commitFile(dir, "a.txt", "hello", "first commit");

    let mgr = GitManager(cwd-> dir);
    assert(mgr.getRemote() == "", "a repository with no remote should report none");

    let bare = mkBareRepo();
    mgr.setRemote(bare.toStr());

    assert(mgr.getRemote() == bare.toStr(), "getRemote() should report the url the remote was set to");
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          FAILURES          ===================================
 * ====================================================================================================
 * ====================================================================================================
 * The 'throw copy GitError(...)' branch of every command, none of which goes through '_yrt_exit':
 * 'GitManager' only ever throws, the caller decides what to do with the failure
 * */

__test clone_unreachable_source_fails {
    // clone() from a url that names no repository fails
    let dst = sys::tempDirectory(prefix-> "gyllir_git_clone_fail_test_");
    let mgr = GitManager(cwd-> dst.push("cloned"));

    let mut threw = false;
    {
        mgr.clone("/no/such/repository/here");
    } catch {
        _: &GitError => { threw = true; }
        _: &FsError => { threw = true; }
    }

    assert(threw, "cloning an unreachable source should throw a GitError");
}

__test set_remote_falls_back_to_set_url_when_origin_exists {
    // setRemote() tries "remote add" first, which fails once "origin" is already set: it then falls
    // back to "remote set-url", which is what actually re-points an existing remote
    let dir = mkScratchRepo();
    let mgr = GitManager(cwd-> dir);

    let first = mkBareRepo();
    mgr.setRemote(first.toStr());
    assert(mgr.getRemote() == first.toStr(), "sanity: the first setRemote() should have set the origin");

    let second = mkBareRepo();
    mgr.setRemote(second.toStr());

    assert(mgr.getRemote() == second.toStr(), "the second setRemote() should re-point the existing origin");
}

__test set_remote_fails_outside_a_git_repository {
    // Outside a git repository, both "remote add" and its "remote set-url" fallback fail: setRemote()
    // reports that failure instead of swallowing it
    let dir = sys::tempDirectory(prefix-> "gyllir_git_not_a_repo_test_");
    let mgr = GitManager(cwd-> dir);

    let mut threw = false;
    {
        mgr.setRemote("/some/url");
    } catch {
        _: &GitError => { threw = true; }
        _: &FsError => { threw = true; }
    }

    assert(threw, "setRemote() outside a git repository should throw a GitError");
}

