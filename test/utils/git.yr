use gyllir::utils::git;
use gyllir::utils::errors;

use std::fs::_;
use std::stream;
use std::concurrency::process;

fn containsSub(haystack: [c8], needle: [c8])-> bool {
    if needle.len == 0us return true;
    if haystack.len < needle.len return false;

    for i in 0us .. (haystack.len - needle.len + 1us) {
        if haystack[i .. i + needle.len] == needle return true;
    }

    false
}

fn mkScratchRepo()-> Path
    throws GitError, FsError
{
    let dir = sys::tempDirectory(prefix-> "gyllir_git_test_");
    let mgr = GitManager(cwd-> dir);
    mgr.init();

    // Some environments force tag/commit signing globally (e.g. tag.gpgsign=true), which makes
    // a plain "git tag <name>" fail non-interactively ("no tag message?"); isolate the scratch
    // repo from that so these tests don't depend on the host's global git config
    let dmut proc = copy SubProcess("git", copy ["config", "tag.gpgsign", "false"], cwd-> dir);
    proc:.start();
    proc:.wait();

    dir
}

fn mkBareRepo()-> Path
    throws FsError
{
    let dir = sys::tempDirectory(prefix-> "gyllir_git_bare_test_");
    let dmut proc = copy SubProcess("git", copy ["init", "--bare"], cwd-> dir);
    proc:.start();
    proc:.wait();
    dir
}

fn writeFile(dir: Path, name: [c8], content: [c8])
    throws FsError
{
    let filePath = dir.push(name);
    let dmut f = File::create(filePath, write-> true);
    f:.write(content);
    f:.close();
}

fn commitFile(dir: Path, name: [c8], content: [c8], msg: [c8])
    throws GitError, FsError
{
    let mgr = GitManager(cwd-> dir);
    let filePath = dir.push(name);
    writeFile(dir, name, content);

    mgr.add(filePath);
    mgr.commit(msg);
}

__test init_creates_git_directory {
    // init() creates a ".git" directory
    let dir = mkScratchRepo();
    assert(sys::isDir(dir.push(".git")), "init() should create a .git directory");
}

__test add_commit_succeed_and_branch_visible {
    // add()+commit() succeed, and the resulting branch is visible via getCurrentBranchName()
    let dir = mkScratchRepo();
    commitFile(dir, "a.txt", "hello", "first commit");

    let mgr = GitManager(cwd-> dir);
    let branch = mgr.getCurrentBranchName();

    assert(branch == "master", "unexpected default branch name");
}

__test commit_with_nothing_staged_fails {
    // commit() with nothing staged fails
    let dir = mkScratchRepo();
    let mgr = GitManager(cwd-> dir);

    let mut threw = false;
    {
        mgr.commit("empty commit");
    } catch {
        _: &GitError => { threw = true; }
        _: &FsError => { threw = true; }
    }

    assert(threw, "committing with nothing staged should throw a GitError");
}

