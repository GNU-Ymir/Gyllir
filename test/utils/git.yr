__test fetch_tags_outside_a_git_repository_fails {
    // fetchTags() names no remote explicitly (unlike fetch()), so a missing "origin" alone is not
    // enough to fail it; being outside a git repository entirely is
    let dir = sys::tempDirectory(prefix-> "gyllir_git_not_a_repo_fetchtags_test_");
    let mgr = GitManager(cwd-> dir);

    let mut threw = false;
    {
        mgr.fetchTags();
    } catch {
        _: &GitError => { threw = true; }
        _: &FsError => { threw = true; }
    }

    assert(threw, "fetching tags outside a git repository should throw a GitError");
}

