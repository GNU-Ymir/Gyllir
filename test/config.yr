use gyllir::config::_;

use std::config::_;
use std::config::{conv, json};
use std::conv::errors;

pub mod ::command;
pub mod ::dependency;
pub mod ::errors;
pub mod ::url;
pub mod ::target;
pub mod ::type;
pub mod ::version;

__test empty_configuration_defaults {
    // Defaults of an empty configuration
    let cfg = GyllirPackageConfiguration::empty();

    assert(cfg.name == "", "default name should be empty");
    assert(cfg.license == "", "default license should be empty");
    assert(cfg.descripion == "", "default description should be empty");
    assert(cfg.compiler == "gyc", "default compiler should be \"gyc\"");
    assert(cfg.packageRoot == "", "default package-root should be empty");
    assert(cfg.testRoot == "", "default test-root should be empty");
    assert(cfg.tests, "default tests should be enabled");
    assert(cfg.type.isExecutable(), "default build type should be executable");
    assert(!cfg.registry.isValid(), "default registry should not be a valid url");
    assert(cfg.version == Version(0u32, 0u32, 0u32), "default version should be 0.0.0");
    assert(cfg.authors == [], "default authors should be empty");
    assert(cfg.libraries == [], "default libraries should be empty");
    assert(cfg.dependencies[].len == 0us, "default dependencies should be empty");
    assert(cfg.commands[].len == 0us, "default commands should be empty");
}

__test explicit_constructor_sets_given_fields {
    // The explicit constructor only sets the fields it is given, the rest keep their defaults
    let cfg = GyllirPackageConfiguration(
        "my-pkg", "MIT", "a test package",
        BuildType("library"), Url("local:some/registry"), Version(1u32, 2u32, 3u32),
        copy ["alice", "bob"]
    );

    assert(cfg.name == "my-pkg", "unexpected name");
    assert(cfg.license == "MIT", "unexpected license");
    assert(cfg.descripion == "a test package", "unexpected description");
    assert(cfg.type.isLibrary(), "unexpected build type");
    assert(cfg.registry.path.toStr() == "some/registry", "unexpected registry path");
    assert(cfg.version == Version(1u32, 2u32, 3u32), "unexpected version");
    assert(cfg.authors == copy ["alice", "bob"], "unexpected authors");

    // untouched by this constructor
    assert(cfg.compiler == "gyc", "compiler should keep its default");
    assert(cfg.libraries == [], "libraries should keep its default");
    assert(cfg.dependencies[].len == 0us, "dependencies should keep its default");
    assert(cfg.commands[].len == 0us, "commands should keep its default");
}

__test deserialize_full_configuration {
    // Deserializing every field from a full configuration dictionary
    let fullCfg = json#{
        "name" : "my-pkg",
        "license" : "MIT",
        "description" : "a test package",
        "type" : "executable",
        "version" : "1.2.3",
        "registry" : {"local" : "some/registry"},
        "compiler" : "clang-ymir",
        "package-root" : "src",
        "test-root" : "test",
        "authors" : ["alice", "bob"],
        "libraries" : ["m", "pthread"],
        "dependencies" : {"foo" : {"version" : "1.0.0", "url" : {"local" : "../foo"}}},
        "commands" : {"build-hook" : {"cmd" : "echo hi", "post" : true}}
    };

    let cfg = GyllirPackageConfiguration(fullCfg);

    assert(cfg.name == "my-pkg", "unexpected name");
    assert(cfg.license == "MIT", "unexpected license");
    assert(cfg.descripion == "a test package", "unexpected description");
    assert(cfg.type.isExecutable(), "unexpected build type");
    assert(cfg.version == Version(1u32, 2u32, 3u32), "unexpected version");
    assert(cfg.registry.path.toStr() == "some/registry", "unexpected registry path");
    assert(cfg.compiler == "clang-ymir", "unexpected compiler");
    assert(cfg.packageRoot == "src", "unexpected package-root");
    assert(cfg.testRoot == "test", "unexpected test-root");
    assert(cfg.authors == copy ["alice", "bob"], "unexpected authors");
    assert(cfg.libraries == copy ["m", "pthread"], "unexpected libraries");

    assert(cfg.dependencies[].len == 1us, "expected a single dependency");
    if let Ok(dep) = cfg.dependencies[]["foo"] {
        assert(dep.url.path.toStr() == "../foo", "unexpected dependency url");
        assert(dep.version.pass(Version(1u32, 0u32, 0u32)), "unexpected dependency version filter");
    } else assert(false, "expected a \"foo\" dependency");

    assert(cfg.commands[].len == 1us, "expected a single command");
    if let Ok(cmd) = cfg.commands[]["build-hook"] {
        assert(cmd.cmd == "echo hi" && cmd.isPost(), "unexpected build-hook command");
    } else assert(false, "expected a \"build-hook\" command");
}

__test deserialize_minimal_configuration {
    // Only name/license/description/type/version/registry are mandatory, everything else defaults
    let minimalCfg = json#{
        "name" : "minimal",
        "license" : "MIT",
        "description" : "d",
        "type" : "executable",
        "version" : "1.0.0",
        "registry" : {"local" : "some/registry"}
    };

    let cfg = GyllirPackageConfiguration(minimalCfg);

    assert(cfg.compiler == "gyc", "compiler should default to \"gyc\"");
    assert(cfg.packageRoot == "", "package-root should default to empty");
    assert(cfg.testRoot == "", "test-root should default to empty");
    assert(cfg.authors == [], "authors should default to empty");
    assert(cfg.libraries == [], "libraries should default to empty");
    assert(cfg.dependencies[].len == 0us, "dependencies should default to empty");
    assert(cfg.commands[].len == 0us, "commands should default to empty");
}

__test non_dict_configuration_rejected {
    // A configuration that isn't a dictionary is rejected directly
    let mut msg = "";
    {
        GyllirPackageConfiguration(copy Str("not-a-dict"));
    } catch {
        a: &AssertError => { msg = a.msg; }
    }

    assert(msg == "expecting a table of entries describing the package", "unexpected error: " ~ msg);
}

__test missing_mandatory_entry_names_it {
    // A missing mandatory entry names that entry, and shows what a correct declaration looks like:
    // the whole message is what 'gyllir' prints, there is nothing else for the user to go on
    let missingName = json#{
        "license" : "MIT",
        "description" : "d",
        "type" : "executable",
        "version" : "1.0.0",
        "registry" : {"local" : "some/registry"}
    };

    let mut msg = "";
    {
        GyllirPackageConfiguration(missingName);
    } catch {
        a: &AssertError => { msg = a.msg; }
    }

    assert(msg == "missing required entry 'name', for example: name = \"my-package\"", "unexpected error: " ~ msg);
}

__test every_mandatory_entry_checked {
    // Every mandatory entry is checked the same way, and the version and the registry, which are
    // read by dedicated parsers, are no exception
    let entries = copy [("name", "missing required entry 'name', for example: name = \"my-package\""),
                        ("license", "missing required entry 'license', for example: license = \"GPL-v3\""),
                        ("description", "missing required entry 'description', for example: description = \"what the package does\""),
                        ("version", "missing required entry 'version', for example: version = \"0.1.0\""),
                        ("registry", "missing required entry 'registry', for example: registry = { git = \"git@github.com:me/my-package.git\" }")];

    for e in entries {
        let dmut d = copy Dict();
        d["name"] = copy Str("my-pkg");
        d["license"] = copy Str("MIT");
        d["description"] = copy Str("d");
        d["version"] = copy Str("1.0.0");
        d["registry"] = json#{"local" : "some/registry"};
        d:.remove(e._0);

        let mut msg = "";
        {
            GyllirPackageConfiguration(d);
        } catch {
            a: &AssertError => { msg = a.msg; }
        }

        assert(msg == e._1, "unexpected error for a missing \"" ~ e._0 ~ "\": " ~ msg);
    }
}

__test wrongly_typed_optional_entry_names_it {
    // A wrongly typed optional entry names that entry too
    let badCompiler = json#{
        "name" : "my-pkg",
        "license" : "MIT",
        "description" : "d",
        "type" : "executable",
        "version" : "1.0.0",
        "registry" : {"local" : "some/registry"},
        "compiler" : 12
    };

    let mut msg = "";
    {
        GyllirPackageConfiguration(badCompiler);
    } catch {
        a: &AssertError => { msg = a.msg; }
    }

    assert(msg == "'compiler' must be a string, for example: compiler = \"gyc\"", "unexpected error: " ~ msg);
}

__test tests_false_disables_synthesized_target {
    // "tests" set to false at the top level is accepted, and disables the synthesized target
    let cfg = GyllirPackageConfiguration(json#{
        "name" : "myapp",
        "license" : "MIT",
        "description" : "d",
        "type" : "executable",
        "version" : "1.0.0",
        "registry" : {"local" : "some/registry"},
        "tests" : false
    });

    assert(!cfg.tests, "the parsed tests flag should be false");
    if let Ok(t) = cfg.targets()["myapp"] {
        assert(!t.tests, "the synthesized target should carry the disabled tests flag");
    } else assert(false, "expected a target named after the package");
}

__test tests_false_with_test_root_rejected {
    // "tests" set to false next to a declared "test-root" is rejected: the two are exclusive
    let bad = json#{
        "name" : "myapp",
        "license" : "MIT",
        "description" : "d",
        "type" : "executable",
        "version" : "1.0.0",
        "registry" : {"local" : "some/registry"},
        "test-root" : "__test__",
        "tests" : false
    };

    let mut msg = "";
    {
        GyllirPackageConfiguration(bad);
    } catch {
        a: &AssertError => { msg = a.msg; }
    }

    assert(msg == "'tests' is set to false, the package declares no unittest, it cannot declare 'test-root'",
           "unexpected error: " ~ msg);
}

__test wrongly_typed_authors_field_rejected {
    // A wrongly typed authors field (not an array) names it, and shows a correct declaration
    let badAuthors = json#{
        "name" : "my-pkg",
        "license" : "MIT",
        "description" : "d",
        "type" : "executable",
        "version" : "1.0.0",
        "registry" : {"local" : "some/registry"},
        "authors" : "alice"
    };

    let mut msg = "";
    {
        GyllirPackageConfiguration(badAuthors);
    } catch {
        a: &AssertError => { msg = a.msg; }
    }

    assert(msg == "'authors' must be an array of strings, for example: authors = [\"me <me@example.com>\"]",
           "unexpected error: " ~ msg);
}

__test unknown_entry_rejected {
    // An entry that is not a known field of the package is rejected rather than silently ignored
    let typo = json#{
        "name" : "my-pkg",
        "license" : "MIT",
        "description" : "d",
        "type" : "executable",
        "version" : "1.0.0",
        "registry" : {"local" : "some/registry"},
        "author" : "alice"
    };

    let mut msg = "";
    {
        GyllirPackageConfiguration(typo);
    } catch {
        a: &AssertError => { msg = a.msg; }
    }

    assert(msg == "'author' is not a known entry", "unexpected error: " ~ msg);
}

__test set_version_mutates_in_place {
    // setVersion() mutates the version in place
    let dmut cfg = GyllirPackageConfiguration::empty();
    cfg:.setVersion(Version(2u32, 0u32, 0u32));

    assert(cfg.version == Version(2u32, 0u32, 0u32), "setVersion() should update the version");
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          TARGETS          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */

__test no_targets_table_synthesizes_one {
    // A package declaring no "[targets.*]" table still has exactly one target, synthesized from its
    // top level fields and named after the package
    let cfg = GyllirPackageConfiguration(json#{
        "name" : "myapp",
        "license" : "MIT",
        "description" : "d",
        "type" : "library",
        "version" : "1.0.0",
        "registry" : {"local" : "some/registry"},
        "package-root" : "main",
        "test-root" : "__test__",
        "flags" : ["-O0"],
        "libraries" : ["m"]
    });

    let targets = cfg.targets();
    assert(targets.len == 1us, "a package declaring no target should have exactly one");

    if let Ok(t) = targets["myapp"] {
        assert(t.name == "myapp", "the synthesized target should be named after the package");
        assert(t.type.isLibrary(), "the synthesized target should carry the type of the package");
        assert(t.packageRoot == "main", "the synthesized target should carry the package root");
        assert(t.testRoot == "__test__", "the synthesized target should carry the test root");
        assert(t.flags == copy ["-O0"], "the synthesized target should carry the package flags");
        assert(t.libraries == copy ["m"], "the synthesized target should carry the package libraries");
        assert(t.synthesized, "the target of a package declaring none is a synthesized one");
    } else assert(false, "expected a target named after the package");
}

__test declared_targets_exclude_package_name {
    // A package declaring targets has exactly those, and none named after the package itself
    let cfg = GyllirPackageConfiguration(json#{
        "name" : "multi",
        "license" : "MIT",
        "description" : "d",
        "version" : "1.0.0",
        "registry" : {"local" : "some/registry"},
        "targets" : {
            "mylib" : {"type" : "library"},
            "cli" : {"targets" : ["mylib"]}
        }
    });

    let targets = cfg.targets();
    assert(targets.len == 2us, "a package declaring two targets should have exactly those");
    assert("multi" !in targets, "no target should be synthesized for a package declaring some");

    if let Ok(t) = targets["cli"] {
        assert(!t.synthesized, "a declared target is not a synthesized one");
    } else assert(false, "expected a declared \"cli\" target");
}

__test type_defaults_to_executable {
    // "type" is optional at the package level, and defaults to an executable
    let cfg = GyllirPackageConfiguration(json#{
        "name" : "myapp",
        "license" : "MIT",
        "description" : "d",
        "version" : "1.0.0",
        "registry" : {"local" : "some/registry"}
    });

    assert(cfg.type.isExecutable(), "a package declaring no type should be an executable");
}

__test single_target_fields_rejected_with_targets_table {
    // Every field describing a single artifact is rejected next to a "[targets.*]" table: it would
    // simply go unread, which is the trap the rule exists to prevent
    for key in copy ["type", "package-root", "test-root", "tests", "flags", "libraries"] {
        let dmut d = copy Dict();
        d["name"] = copy Str("multi");
        d["license"] = copy Str("MIT");
        d["description"] = copy Str("d");
        d["version"] = copy Str("1.0.0");
        d["registry"] = json#{"local" : "some/registry"};
        d["targets"] = json#{"cli" : {"type" : "executable"}};

        // a well typed value, so that what rejects it is the exclusivity rule and not the parser
        if (key == "type") {
            d[key] = copy Str("executable");
        } else if (key == "flags" || key == "libraries") {
            d[key] = copy Array(copy [copy Str("x")]);
        } else if (key == "tests") {
            d[key] = copy Bool(false);
        } else {
            d[key] = copy Str("main");
        }

        let mut msg = "";
        {
            GyllirPackageConfiguration(d);
        } catch {
            a: &AssertError => { msg = a.msg; }
        }

        assert(msg.len > 0us, "'" ~ key ~ "' should be rejected at the top level of a multi target package");
        assert(msg[0 .. key.len + 2us] == "'" ~ key ~ "'", "the error should name the rejected key, got: " ~ msg);
    }
}

__test single_target_fields_accepted_without_targets_table {
    // The same fields are accepted at the top level of a package declaring no target
    let cfg = GyllirPackageConfiguration(json#{
        "name" : "myapp",
        "license" : "MIT",
        "description" : "d",
        "type" : "executable",
        "version" : "1.0.0",
        "registry" : {"local" : "some/registry"},
        "package-root" : "main",
        "test-root" : "__test__",
        "flags" : ["-O0"],
        "libraries" : ["m"]
    });

    assert(cfg.flags == copy ["-O0"], "unexpected package flags");
    assert(cfg.libraries == copy ["m"], "unexpected package libraries");
}

__test serialize_targets_omits_top_level_fields {
    // Serializing a package that declares targets writes them back, and none of the fields that
    // would be rejected on the next read
    let cfg = GyllirPackageConfiguration(json#{
        "name" : "multi",
        "license" : "MIT",
        "description" : "d",
        "version" : "1.0.0",
        "registry" : {"local" : "some/registry"},
        "targets" : {"cli" : {"type" : "executable", "package-root" : "main"}}
    });

    let serialized = cfg.serialize();

    if let Ok(targets) = serialized["targets"]? {
        if let Ok(cli) = targets["cli"]? {
            assert(to!{[c8]}(cli["package-root"]) == "main", "the target entries should be written back");
        } else assert(false, "expected a serialized \"cli\" target");
    } else assert(false, "expected the declared targets to be serialized");

    for key in copy ["type", "package-root", "test-root", "tests", "flags", "libraries"] {
        assert(key !in serialized, "'" ~ key ~ "' must not be written next to a target table");
    }
}

__test serialize_no_targets_writes_top_level_fields {
    // Serializing a package that declares no target writes its top level fields, and no target
    // table: "gyllir publish" rewrites the whole file, and must not inject the synthesized target
    let cfg = GyllirPackageConfiguration(json#{
        "name" : "myapp",
        "license" : "MIT",
        "description" : "d",
        "type" : "library",
        "version" : "1.0.0",
        "registry" : {"local" : "some/registry"},
        "package-root" : "main",
        "test-root" : "__test__",
        "flags" : ["-O0"],
        "libraries" : ["m"]
    });

    let serialized = cfg.serialize();

    assert("targets" !in serialized, "a package declaring no target should not gain one on publish");
    assert(to!{[c8]}(serialized["type"]) == "library", "unexpected serialized type");
    assert(to!{[c8]}(serialized["package-root"]) == "main", "the package root should be written back");
    assert(to!{[c8]}(serialized["test-root"]) == "__test__", "the test root should be written back");
    assert(to!{[[c8]]}(serialized["flags"]) == copy ["-O0"], "unexpected serialized flags");
    assert(to!{[[c8]]}(serialized["libraries"]) == copy ["m"], "unexpected serialized libraries");
}

__test serialize_omits_unset_optional_fields {
    // A package that never declared a package root, a test root or flags does not gain them either
    let cfg = GyllirPackageConfiguration(json#{
        "name" : "myapp",
        "license" : "MIT",
        "description" : "d",
        "type" : "executable",
        "version" : "1.0.0",
        "registry" : {"local" : "some/registry"}
    });

    let serialized = cfg.serialize();

    assert("package-root" !in serialized, "an unset package root should not be written back");
    assert("test-root" !in serialized, "an unset test root should not be written back");
    assert("tests" !in serialized, "an unset tests flag should not be written back");
    assert("flags" !in serialized, "an empty flag list should not be written back");
}

__test tests_false_survives_round_trip {
    // "tests" set to false at the top level survives a serialization round trip
    let cfg = GyllirPackageConfiguration(json#{
        "name" : "myapp",
        "license" : "MIT",
        "description" : "d",
        "type" : "executable",
        "version" : "1.0.0",
        "registry" : {"local" : "some/registry"},
        "tests" : false
    });

    let serialized = cfg.serialize();
    assert(!to!{bool}(serialized["tests"]), "the tests flag should be written back as false");

    let back = GyllirPackageConfiguration(serialized);
    assert(!back.tests, "the tests flag should survive the round trip");
}

__test targets_survive_round_trip {
    // A configuration holding targets survives a serialization round trip
    let cfg = GyllirPackageConfiguration(json#{
        "name" : "multi",
        "license" : "MIT",
        "description" : "d",
        "version" : "1.0.0",
        "registry" : {"local" : "some/registry"},
        "targets" : {
            "mylib" : {"type" : "library"},
            "cli" : {"type" : "executable", "targets" : ["mylib"], "output" : "gyllir-cli"}
        }
    });

    let back = GyllirPackageConfiguration(cfg.serialize());
    let targets = back.targets();

    assert(targets.len == 2us, "both targets should survive the round trip");
    if let Ok(t) = targets["cli"] {
        assert(t.outputName() == "gyllir-cli", "the output name should survive the round trip");
        assert(t.targets == copy ["mylib"], "the linked targets should survive the round trip");
    } else assert(false, "expected a \"cli\" target after the round trip");
}

__test serialize_round_trips_every_field {
    // Serializing round-trips every field written by serialize()
    let fullCfg = json#{
        "name" : "my-pkg",
        "license" : "MIT",
        "description" : "a test package",
        "type" : "executable",
        "version" : "1.2.3",
        "registry" : {"local" : "some/registry"},
        "compiler" : "clang-ymir",
        "authors" : ["alice", "bob"],
        "libraries" : ["m", "pthread"],
        "dependencies" : {"foo" : {"version" : "1.0.0", "url" : {"local" : "../foo"}}},
        "commands" : {"build-hook" : {"cmd" : "echo hi", "post" : true}}
    };

    let cfg = GyllirPackageConfiguration(fullCfg);
    let serialized = cfg.serialize();

    assert(to!{[c8]}(serialized["name"]) == "my-pkg", "unexpected serialized name");
    assert(to!{[c8]}(serialized["license"]) == "MIT", "unexpected serialized license");
    assert(to!{[c8]}(serialized["description"]) == "a test package", "unexpected serialized description");
    assert(to!{[c8]}(serialized["type"]) == "executable", "unexpected serialized type");
    assert(to!{[c8]}(serialized["version"]) == "1.2.3", "unexpected serialized version");
    assert(to!{[c8]}(serialized["compiler"]) == "clang-ymir", "unexpected serialized compiler");
    assert(to!{[[c8]]}(serialized["authors"]) == copy ["alice", "bob"], "unexpected serialized authors");
    assert(to!{[[c8]]}(serialized["libraries"]) == copy ["m", "pthread"], "unexpected serialized libraries");

    if let Ok(reg) = serialized["registry"]? {
        assert(to!{[c8]}(reg["local"]) == "some/registry", "unexpected serialized registry");
    } else assert(false, "expected a serialized registry");

    if let Ok(deps) = serialized["dependencies"]? {
        if let Ok(foo) = deps["foo"]? {
            // an equality filter (no comparator) serializes with a leading '='
            assert(to!{[c8]}(foo["version"]) == "=1.0.0", "unexpected serialized dependency version");
        } else assert(false, "expected a serialized \"foo\" dependency");
    } else assert(false, "expected serialized dependencies");

    if let Ok(cmds) = serialized["commands"]? {
        if let Ok(hook) = cmds["build-hook"]? {
            assert(to!{[c8]}(hook["cmd"]) == "echo hi", "unexpected serialized command");
        } else assert(false, "expected a serialized \"build-hook\" command");
    } else assert(false, "expected serialized commands");
}
