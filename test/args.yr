use gyllir::args;
use gyllir::config::version;

use std::config::_;

/**
 * Run the real gyllir command line parser
 * @info: 'args[0]' is the program name and is always skipped by the parser
 * */
fn parse(args: [[c8]])-> &Config {
    (copy GyllirArgumentParser()).parse(args)
}

/**
 * @returns: the sub configuration stored under 'key', asserting it is there
 * */
fn sub(cfg: &Config, key: [c8])-> &Config
    throws AssertError
{
    if let Ok(c) = cfg[key]? return c;

    throw copy AssertError("no '" ~ key ~ "' sub command in the parsed configuration");
}

/**
 * @returns: the value of the boolean flag 'key', asserting it is there
 * */
fn flag(cfg: &Config, key: [c8])-> bool
    throws AssertError
{
    if let Ok(Bool(value-> v)) = cfg[key]? return v;

    throw copy AssertError("no '" ~ key ~ "' flag in the parsed configuration");
}

__test {
    // The version constant is kept in sync with gyllir.toml by tools/set-version.sh, so it must
    // always be a numbered version and never be left at its "0.0.0" placeholder
    let v = Version(__GYLLIR_VERSION__);
    assert(v.isNumbered(), "__GYLLIR_VERSION__ is not a numbered version: " ~ __GYLLIR_VERSION__);
    assert(v[] == __GYLLIR_VERSION__, "__GYLLIR_VERSION__ is not a canonical version: " ~ __GYLLIR_VERSION__);
    assert(v != Version(0u32, 0u32, 0u32), "__GYLLIR_VERSION__ was left at its placeholder value");
}

__test {
    // Without a compiler version, the banner is a single line naming the tool and its version
    let banner = versionString();
    assert(banner == "gyllir " ~ __GYLLIR_VERSION__, "unexpected version banner: " ~ banner);
}

__test {
    // The compiler version, when known, is appended on a second line
    let banner = versionString(compiler-> "Ymir version 1.2.2 20260811");
    assert(banner == "gyllir " ~ __GYLLIR_VERSION__ ~ "\nYmir version 1.2.2 20260811",
           "unexpected version banner: " ~ banner);
}

__test {
    // A compiler that cannot be run reports no version rather than failing
    assert(compilerVersion(compiler-> "gyllir-no-such-compiler") == "",
           "an unknown compiler should report an empty version");
}

__test {
    // A compiler that can be run reports the first line of its "--version" output
    // ("echo" stands in for a real compiler, to keep the test independent of the toolchain)
    let version = compilerVersion(compiler-> "echo");

    assert(version.len > 0us, "a runnable compiler should report a non empty version");
    for c in version {
        assert(c != '\n', "only the first line of the compiler output should be reported");
    }
}

__test {
    // 'init' takes no option, but it must be recognized as a sub command
    let cfg = parse(copy ["gyllir", "init"]);

    assert("init" in cfg, "the init sub command should be parsed");
}

__test {
    // 'build' defaults: every flag is inserted, and set to false
    let build = sub(parse(copy ["gyllir", "build"]), "build");

    assert(!flag(build, "release"), "release should default to false");
    assert(!flag(build, "verbose"), "verbose should default to false");
    assert("j" !in build, "an unspecified option should be absent");
}

__test {
    // 'build' with every option set, using both the long and the short spelling
    let build = sub(parse(copy ["gyllir", "build", "--release", "-j", "4", "-v"]), "build");

    assert(flag(build, "release"), "--release should be parsed");
    assert(flag(build, "verbose"), "-v should be parsed as verbose");

    if let Ok(Int(value-> j)) = build["j"]? {
        assert(j == 4i64, "-j should be parsed as an integer");
    } else assert(false, "-j should be parsed");
}

__test {
    // 'run' forwards its own arguments verbatim to the executable, as an array of strings
    let run = sub(parse(copy ["gyllir", "run", "--some-flag", "positional"]), "run");

    if let a: &Array = run {
        assert(a[].len == 2us, "both arguments should be forwarded");
        assert(to!{[c8]}(a[][0]) == "--some-flag", "unexpected first forwarded argument");
        assert(to!{[c8]}(a[][1]) == "positional", "unexpected second forwarded argument");
    } else assert(false, "the run arguments should be forwarded as an array");
}

__test {
    // 'run' without arguments forwards an empty list
    let run = sub(parse(copy ["gyllir", "run"]), "run");

    if let a: &Array = run {
        assert(a[].len == 0us, "no argument should be forwarded");
    } else assert(false, "the run arguments should be forwarded as an array");
}

__test {
    // 'publish' with a version increment flag and its mandatory message
    let publish = sub(parse(copy ["gyllir", "publish", "--minor", "-y", "a release message"]), "publish");

    assert(flag(publish, "minor"), "--minor should be parsed");
    assert(flag(publish, "yes"), "-y should be parsed as yes");
    assert(!flag(publish, "major") && !flag(publish, "patch"), "the other increments should be false");
    assert(!flag(publish, "dry"), "dry should default to false");

    if let Ok(Str(value-> msg)) = publish["message"]? {
        assert(msg == "a release message", "unexpected publish message");
    } else assert(false, "the message positional should be parsed");
}

__test {
    // 'publish --dry --major' : the exclusivity check only rejects more than one increment
    let publish = sub(parse(copy ["gyllir", "publish", "--dry", "--major", "m"]), "publish");

    assert(flag(publish, "dry") && flag(publish, "major"), "--dry and --major should be parsed");
}

__test {
    // 'clean' defaults to cleaning the outputs only
    let clean = sub(parse(copy ["gyllir", "clean"]), "clean");

    assert(!flag(clean, "all"), "all should default to false");
    assert(!flag(clean, "doc"), "doc should default to false");
}

__test {
    // 'clean --all' and 'clean --doc' (-a is the short spelling of --all)
    let all = sub(parse(copy ["gyllir", "clean", "-a"]), "clean");
    assert(flag(all, "all"), "-a should be parsed as all");

    let doc = sub(parse(copy ["gyllir", "clean", "--doc"]), "clean");
    assert(flag(doc, "doc") && !flag(doc, "all"), "--doc should be parsed alone");
}

__test {
    // 'doc' with an input file and an output directory
    let doc = sub(parse(copy ["gyllir", "doc", "-i", "gyllir.doc.json", "-o", "/tmp/out", "-v"]), "doc");

    assert(flag(doc, "verbose"), "-v should be parsed as verbose");

    if let Ok(Str(value-> i)) = doc["input"]? {
        assert(i == "gyllir.doc.json", "unexpected input file");
    } else assert(false, "-i should be parsed as input");

    if let Ok(Str(value-> o)) = doc["output"]? {
        assert(o == "/tmp/out", "unexpected output directory");
    } else assert(false, "-o should be parsed as output");
}

__test {
    // 'doc' without option: neither input nor output is set
    let doc = sub(parse(copy ["gyllir", "doc"]), "doc");

    assert("input" !in doc, "input should be absent by default");
    assert("output" !in doc, "output should be absent by default");
}

__test {
    // 'test' with every option set
    let test = sub(parse(copy ["gyllir", "test", "--dry", "--release", "-j", "2", "-v"]), "test");

    assert(flag(test, "dry"), "--dry should be parsed");
    assert(flag(test, "release"), "--release should be parsed");
    assert(flag(test, "verbose"), "-v should be parsed as verbose");

    if let Ok(Int(value-> j)) = test["j"]? {
        assert(j == 2i64, "-j should be parsed as an integer");
    } else assert(false, "-j should be parsed");
}

__test {
    // 'test' defaults: the tests are built and run, in debug mode
    let test = sub(parse(copy ["gyllir", "test"]), "test");

    assert(!flag(test, "dry"), "dry should default to false");
    assert(!flag(test, "release"), "release should default to false");
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          TARGETS          ====================================
 * ====================================================================================================
 * ====================================================================================================
 * 'build', 'test' and 'doc' take an optional '<target>', sliced out of the command line before the
 * std parser sees it: every position it declares would otherwise be mandatory
 */

/**
 * @returns: the target named by a parsed sub command, "" when it names none
 * */
fn target(cfg: &Config)-> [c8] {
    if let Ok(Str(value-> v)) = cfg["target"]? return v;

    ""
}

__test {
    // A sub command naming no target leaves the entry out entirely
    for name in copy ["build", "test", "doc"] {
        let cfg = sub(parse(copy ["gyllir", name]), name);
        assert("target" !in cfg, "'" ~ name ~ "' should not name a target by default");
    }
}

__test {
    // 'build <target>' names the target to build
    let build = sub(parse(copy ["gyllir", "build", "cli"]), "build");

    assert(target(build) == "cli", "the target should be parsed");
    assert(!flag(build, "release"), "the other entries should keep their defaults");
}

__test {
    // The target may appear anywhere among the flags, and the value of an option is never mistaken
    // for it
    let build = sub(parse(copy ["gyllir", "build", "--release", "-j", "4", "cli", "-v"]), "build");

    assert(target(build) == "cli", "the target should be parsed among the flags");
    assert(flag(build, "release") && flag(build, "verbose"), "the flags should be parsed");

    if let Ok(Int(value-> j)) = build["j"]? {
        assert(j == 4i64, "-j should keep its own value");
    } else assert(false, "-j should be parsed");
}

__test {
    // Only the first argument that is not an option is taken as the target
    let test = sub(parse(copy ["gyllir", "test", "cli", "--dry"]), "test");

    assert(target(test) == "cli", "the target should be parsed");
    assert(flag(test, "dry"), "--dry should be parsed");
}

__test {
    // 'doc' has two valued options, and neither of their values is a target
    let doc = sub(parse(copy ["gyllir", "doc", "-o", "/tmp/out", "-i", "gyllir.doc.json", "cli"]), "doc");

    assert(target(doc) == "cli", "the target should be parsed");

    if let Ok(Str(value-> o)) = doc["output"]? {
        assert(o == "/tmp/out", "the output directory should not be taken as the target");
    } else assert(false, "-o should be parsed as output");

    if let Ok(Str(value-> i)) = doc["input"]? {
        assert(i == "gyllir.doc.json", "the input file should not be taken as the target");
    } else assert(false, "-i should be parsed as input");
}

__test {
    // The name of the sub command itself is never taken as a target
    let doc = sub(parse(copy ["gyllir", "doc", "--output", "/tmp/out"]), "doc");

    assert("target" !in doc, "the sub command should not name a target");
}
