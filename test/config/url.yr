use gyllir::config::url;

use std::config::_;
use std::config::{conv, json};

__test default_url_is_empty_local_invalid {
    // A default-constructed url is empty, of type LOCAL, and invalid
    let u = Url();
    assert(u.path.toStr() == "", "default url should have an empty path");
    assert(u.type == UrlType::LOCAL, "default url type should be LOCAL");
    assert(!u.isValid(), "default url should not be valid");
}

__test local_prefix_parsed_and_stripped {
    // A "local:" prefix is parsed as a local url, and stripped from the path
    let u = Url("local:some/dir");
    assert(u.type == UrlType::LOCAL, "expected a LOCAL url type");
    assert(u.path.toStr() == "some/dir", "expected the \"local:\" prefix to be stripped");
    assert(u.isValid(), "a well formed url should be valid");
}

__test git_prefix_parsed_and_stripped {
    // A "git:" prefix is parsed as a git url, and stripped from the path
    let u = Url("git:some/repo");
    assert(u.type == UrlType::GIT, "expected a GIT url type");
    assert(u.path.toStr() == "some/repo", "expected the \"git:\" prefix to be stripped");
    assert(u.isValid(), "a well formed url should be valid");
}

__test unprefixed_url_defaults_to_git {
    // Without a known prefix, the url is treated as a raw(git) remote, kept as-is
    let u = Url("git@host.com:org/repo.git");
    assert(u.type == UrlType::GIT, "unprefixed urls should default to GIT");
    assert(u.path.toStr() == "git@host.com:org/repo.git", "unprefixed urls should be kept unmodified");
    assert(u.isValid(), "a well formed url should be valid");
}

__test deserialize_from_local_key {
    // Deserializing from a configuration containing a "local" key
    let cfg = json#{"local" : "some/dir"};
    let u = Url(cfg);

    assert(u.type == UrlType::LOCAL, "expected a LOCAL url type");
    assert(u.path.toStr() == "some/dir", "unexpected path for a \"local\" configuration");
    assert(u.isValid(), "a well formed url should be valid");
}

__test deserialize_from_git_key {
    // Deserializing from a configuration containing a "git" key
    let cfg = json#{"git" : "some/repo"};
    let u = Url(cfg);

    assert(u.type == UrlType::GIT, "expected a GIT url type");
    assert(u.path.toStr() == "some/repo", "unexpected path for a \"git\" configuration");
    assert(u.isValid(), "a well formed url should be valid");
}

__test deserialize_from_raw_string_node {
    // Deserializing directly from a raw string configuration node falls back to string parsing
    let u = Url(copy Str("local:some/dir"));

    assert(u.type == UrlType::LOCAL, "expected a LOCAL url type");
    assert(u.path.toStr() == "some/dir", "unexpected path when deserializing from a raw string");
    assert(u.isValid(), "a well formed url should be valid");
}

__test dict_without_local_or_git_key_rejected {
    // A dictionnary without a "local" or "git" key is rejected as malformed
    let cfg = json#{"unknown" : "some/dir"};
    let mut msg = "";
    {
        Url(cfg);
    } catch {
        a: &AssertError => { msg = a.msg; }
    }

    assert(msg == "'url' is invalid: expecting a string like \"git:<remote>\" or \"local:<path>\", "
           ~ "or a table declaring a 'git' or a 'local' entry", "unexpected error: " ~ msg);
}

__test non_string_entry_names_the_entry {
    // A "git" or "local" entry that is not a string names that entry, rather than falling back on
    // the generic message, which would say nothing about what is actually wrong
    let mut msg = "";
    {
        Url(json#{"git" : 12});
    } catch {
        a: &AssertError => { msg = a.msg; }
    }

    assert(msg == "'url' is invalid: 'git' must be a string, the remote of a git repository", "unexpected error: " ~ msg);
}

__test entry_the_url_was_read_from_is_named {
    // The entry the url was read from is named by the error, a package has one registry and as many
    // dependency urls as it declares dependencies
    let mut msg = "";
    {
        Url(json#{"unknown" : "some/dir"}, entry-> "'registry'");
    } catch {
        a: &AssertError => { msg = a.msg; }
    }

    assert(msg == "'registry' is invalid: expecting a string like \"git:<remote>\" or \"local:<path>\", "
           ~ "or a table declaring a 'git' or a 'local' entry", "unexpected error: " ~ msg);
}

__test extra_entry_rejected {
    // A "local" or "git" table declaring an extra entry is rejected rather than ignoring it
    let mut msg = "";
    {
        Url(json#{"local" : "some/dir", "branch" : "main"});
    } catch {
        a: &AssertError => { msg = a.msg; }
    }

    assert(msg == "'url' 'branch' is not a known entry", "unexpected error: " ~ msg);
}

__test equality_requires_path_type_and_validity {
    // Equality only holds when path, type and validity all match
    let a = Url("local:some/dir");
    let b = Url("local:some/dir");
    let c = Url("local:other/dir");
    let d = Url("git:some/dir");

    assert(a == b, "two urls parsed from the same string should be equal");
    assert(a != c, "urls with different paths should not be equal");
    assert(a != d, "urls with different types should not be equal");
}

__test to_str_writes_the_scheme_back {
    // toStr() writes an url the way it is declared, its path prefixed by its scheme
    assert(Url("local:some/dir").toStr() == "local:some/dir", "unexpected string form of a local url");
    assert(Url("git:some/repo").toStr() == "git:some/repo", "unexpected string form of a git url");

    // an url declared with no scheme at all is a git one, and is written back as such
    assert(Url("git@host.com:org/repo.git").toStr() == "git:git@host.com:org/repo.git",
           "an unprefixed url should be written back with its git scheme");
}

__test to_str_round_trips_through_the_parser {
    // The string form of an url parses back to the same url
    for u in copy [Url("local:some/dir"), Url("git:some/repo"), Url("git@host.com:org/repo.git")] {
        let back = Url(u.toStr());
        assert(back == u, "an url should survive a round trip through its string form: " ~ u.toStr());
    }
}

__test serialize_local_and_git_urls {
    // Serializing a local url produces a "local" entry, a git url a "git" entry
    let localUrl = Url("local:some/dir");
    let gitUrl = Url("git:some/repo");

    let localCfg = localUrl.serialize();
    let gitCfg = gitUrl.serialize();

    assert(to!{[c8]} (localCfg["local"]) == "some/dir", "unexpected serialized path for a local url");
    assert(to!{[c8]} (gitCfg["git"]) == "some/repo", "unexpected serialized path for a git url");
}
