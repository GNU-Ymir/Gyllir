use gyllir::config::type;

use std::config::_;
use std::config::conv;
use std::conv::errors;

__test {
    // Default construction targets an executable
    let t = BuildType();
    assert(t.isExecutable(), "default build type should be executable");
    assert(!t.isLibrary(), "default build type should not be a library");
}

__test {
    // Parsing from a string
    let exe = BuildType("executable");
    assert(exe.isExecutable(), "\"executable\" should parse as an executable build type");
    assert(!exe.isLibrary(), "\"executable\" should not parse as a library build type");

    let lib = BuildType("library");
    assert(lib.isLibrary(), "\"library\" should parse as a library build type");
    assert(!lib.isExecutable(), "\"library\" should not parse as an executable build type");
}

__test {
    // An unknown string is rejected, and the error names the types a target may declare
    let mut msg = "";
    {
        BuildType("unknown");
    } catch {
        a: &AssertError => { msg = a.msg; }
    }

    assert(msg == "'type' is invalid: \"unknown\" is not a build type, expecting one of \"executable\", \"library\"",
           "unexpected error: " ~ msg);
}

__test {
    // The entry the type was read from is named by the error, so that a target table says which
    // of its types is at fault
    let mut msg = "";
    {
        BuildType("unknown", entry-> "'[targets.cli]', 'type'");
    } catch {
        a: &AssertError => { msg = a.msg; }
    }

    assert(msg == "'[targets.cli]', 'type' is invalid: \"unknown\" is not a build type, expecting one of \"executable\", \"library\"",
           "unexpected error: " ~ msg);
}

__test {
    // Parsing from a configuration node
    let lib = BuildType(copy Str("library"));
    assert(lib.isLibrary(), "expected a library build type");

    let exe = BuildType(copy Str("executable"));
    assert(exe.isExecutable(), "expected an executable build type");
}

__test {
    // A non string configuration is rejected
    let mut msg = "";
    {
        BuildType(copy Int(12));
    } catch {
        a: &AssertError => { msg = a.msg; }
    }

    assert(msg == "'type' must be a string, one of \"executable\", \"library\"", "unexpected error: " ~ msg);
}

__test {
    // Serializing round-trips the type back into its string representation
    let exe = BuildType("executable");
    let lib = BuildType("library");

    assert(to!{[c8]} (exe.serialize()) == "executable", "unexpected serialized executable type");
    assert(to!{[c8]} (lib.serialize()) == "library", "unexpected serialized library type");
}
